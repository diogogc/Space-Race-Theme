{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/diogo/.config/fastfetch/logo.txt",
    "color": {
      "1": "green",
      "2": "green"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ⫸ ",
    "color": {
      "keys": "green",
      "title": "green"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "────────────────────────────────────────"
    },
    {
      "type": "os",
      "key": "󰣇 GUIDANCE",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": " AGC KERNEL",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": " VECTOR DPY",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": " DSKY CONSOLE",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "󰞷 COLOSSUS 2A",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU CYCLES",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "󰑭 ROPE MEMORY",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "󱑎 AGC MET",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "────────────────────────────────────────"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
