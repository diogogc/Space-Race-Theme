[global]
    font = JetBrainsMono Nerd Font 10
    allow_markup = yes
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    geometry = "360x10-20+45"
    transparency = 8
    idle_threshold = 120
    padding = 12
    horizontal_padding = 14
    separator_color = "#183d34"
    corner_radius = 3

[urgency_low]
    background = "#0e1e1a"
    foreground = "#36b89c"
    frame_color = "#1f6656"
    timeout = 4

[urgency_normal]
    background = "#0e1e1a"
    foreground = "#48e5c2"
    frame_color = "#48e5c2"
    timeout = 6

[urgency_critical]
    background = "#1e1012"
    foreground = "#ff4860"
    frame_color = "#ff3355"
    timeout = 0
