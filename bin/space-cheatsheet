def print_banner():
    banner = f"""{AMBER}{BOLD}
   ╔═══════════════════════════════════════════════════════════════════════════╗
   ║  🛸 SPACE RACE MISSION CONTROL // FLIGHT MANUAL & CHEATSHEET             ║
   ╚═══════════════════════════════════════════════════════════════════════════╝{RESET}
   {MUTED}Usage: {WHITE}cheatsheet {MUTED}[tmux | zsh | tree | space | hypr | sys | all]{RESET}
"""
    print(banner)

def print_section(sec_id, sec_data):
    color = sec_data["color"]
    title = sec_data["title"]
    items = sec_data["items"]

    header = f"   {color}{BOLD}┌── {title} {'─' * (68 - len(title))}┐{RESET}"
    footer = f"   {color}{BOLD}└──{'─' * 70}┘{RESET}"

    print(header)
    for key, desc in items:
        # Pad key nicely
        key_str = f"{BRIGHT_AMBER}{BOLD}{key:<24}{RESET}"
        desc_str = f"{WHITE}{desc}{RESET}"
        print(f"   {color}│{RESET}  {key_str} {MUTED}⫸{RESET} {desc_str:<44} {color}│{RESET}")
    print(footer + "\n")

def main():
    arg = (sys.argv[1] if len(sys.argv) > 1 else "all").lower().strip("-")

    print_banner()

    if arg in SECTIONS:
        print_section(arg, SECTIONS[arg])
    elif arg in ("all", "help", ""):
        for sec_id, sec_data in SECTIONS.items():
            print_section(sec_id, sec_data)
    else:
        # Search query across all shortcuts
        query = arg.lower()
        matches = []
        for sec_id, sec_data in SECTIONS.items():
            for key, desc in sec_data["items"]:
                if query in key.lower() or query in desc.lower():
                    matches.append((sec_data["title"], key, desc))

        if matches:
            print(f"   {GREEN}{BOLD}🔍 Search Results for: '{query}'{RESET}\n")
            for title, key, desc in matches:
                print(f"   {AMBER}[{title}]{RESET} {BRIGHT_AMBER}{BOLD}{key:<22}{RESET} {MUTED}⫸{RESET} {WHITE}{desc}{RESET}")
            print()
        else:
            print(f"   {RED}No shortcuts found matching '{query}'. Showing full cheatsheet:{RESET}\n")
            for sec_id, sec_data in SECTIONS.items():
                print_section(sec_id, sec_data)

if __name__ == "__main__":
    main()
