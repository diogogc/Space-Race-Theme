SCAN_PRINT_PATTERN = r"\b(scan|scanner|scanning|simple-scan|hp-uiscan|print|printer|printing|cups|system-config-printer|hp-toolbox)\b"

APP_KEYWORD_RULES = [
    (SCAN_PRINT_PATTERN, "Utilities"),
    (r"\b(screensaver|space-screensaver|space-screensaver-config)\b", "Utilities"),
    (r"\b(iss|spaceera-iss|space-iss-dialog|iss-tracker)\b", "Utilities"),
    (r"\b(spotify|vlc|mpv|audacity|gimp|inkscape|blender|kdenlive|obs|handbrake|rhythmbox|cider|mixxx|pavucontrol|sound|audio|player)\b", "Multimedia"),
    (r"\b(firefox|chromium|chrome|brave|zen|vivaldi|thunderbird|discord|slack|telegram|signal|betterbird|browser)\b", "Internet"),
    (r"\b(nvim|vim|code|vscodium|sublime|emacs|eclipse|pycharm|intellij|clion|rustrover|git|debugger|compiler|designer)\b", "Development"),
    (r"\b(obsidian|notion|libreoffice|soffice|calc|writer|impress|draw|math|word|excel|powerpoint)\b", "Office"),
    (r"\b(htop|btop|kitty|ghostty|alacritty|foot|wezterm|dolphin|thunar|nautilus|gparted|system-monitor)\b", "System"),
    (r"\b(settings|control-center|tweaks|config|pavucontrol-qt)\b", "Settings"),
]

CATEGORY_PRIORITY = ["Development", "Office", "Multimedia", "Internet", "Settings", "System", "Utilities"]

def get_current_theme():
    theme_file = os.path.expanduser("~/.config/themes/current_theme")
    if os.path.isfile(theme_file):
        try:
            with open(theme_file, "r") as f:
                theme = f.read().strip()
                if theme in THEMES:
                    return theme
        except Exception:
            pass
    return "nasa"

def get_all_apps():
    search_dirs = [
        "/usr/share/applications",
        os.path.expanduser("~/.local/share/applications"),
        "/var/lib/flatpak/exports/share/applications",
        os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
    ]
    seen_execs = set()
    apps = []

    for d in search_dirs:
        if not os.path.isdir(d):
            continue
        for root, _, files in os.walk(d):
            for file in files:
                if not file.endswith(".desktop"):
                    continue
                path = os.path.join(root, file)
                cp = configparser.RawConfigParser(strict=False)
                try:
                    cp.read(path, encoding="utf-8")
                    if not cp.has_section("Desktop Entry"):
                        continue
                    if cp.getboolean("Desktop Entry", "NoDisplay", fallback=False):
                        continue
                    if cp.getboolean("Desktop Entry", "Hidden", fallback=False):
                        continue
                    
                    name = cp.get("Desktop Entry", "Name", fallback=None)
                    exec_cmd = cp.get("Desktop Entry", "Exec", fallback=None)
                    if not name or not exec_cmd:
                        continue
                    
                    clean_exec = re.sub(r"%[a-zA-Z]", "", exec_cmd).strip()
                    if clean_exec in seen_execs:
                        continue
                    seen_execs.add(clean_exec)
                    
                    comment = cp.get("Desktop Entry", "Comment", fallback="")
                    raw_cats = [c.strip() for c in cp.get("Desktop Entry", "Categories", fallback="").split(";") if c.strip()]
                    generic = cp.get("Desktop Entry", "GenericName", fallback="")
                    
                    assigned_cat = None
                    cats_str = " ".join(raw_cats)
                    search_str = f"{name} {clean_exec} {comment} {generic} {cats_str}".lower()
                    
                    # 1. Scanner & Printer priority routing to Utilities
                    if re.search(SCAN_PRINT_PATTERN, search_str):
                        assigned_cat = "Utilities"
                    
                    # 2. Exact XDG category token matching
                    if not assigned_cat:
                        found_cats = set()
                        for c in raw_cats:
                            low_c = c.lower()
                            if low_c in XDG_CATEGORY_MAP:
                                found_cats.add(XDG_CATEGORY_MAP[low_c])
                        
                        for p_cat in CATEGORY_PRIORITY:
                            if p_cat in found_cats:
                                assigned_cat = p_cat
                                break
                    
                    # 3. Word-boundary regex rules on name, exec, comment, and generic name
                    if not assigned_cat:
                        for pattern, cat in APP_KEYWORD_RULES:
                            if re.search(pattern, search_str):
                                assigned_cat = cat
                                break
                    
                    # 4. Default fallback
                    if not assigned_cat:
                        assigned_cat = "Utilities"
                    
                    # Determine application tier:
                    # Tier 0: Custom Space Race / Apollo Mission Suite
                    # Tier 1: Graphical User Interface (GUI) Applications
                    # Tier 2: Terminal / Console (CLI) Applications
                    is_terminal = cp.getboolean("Desktop Entry", "Terminal", fallback=False)
                    basename = os.path.basename(path).lower()
                    exec_low = clean_exec.lower()
                    name_low = name.lower()

                    is_custom_theme = (
                        basename.startswith("space-") or basename.startswith("dsky-") or
                        exec_low.startswith("space-") or exec_low.startswith("dsky-") or
                        "/space-" in exec_low or "/dsky-" in exec_low or
                        "space-race-theme" in path.lower() or
                        any(name_low.startswith(p) for p in [
                            "space ", "apollo ", "dsky ", "theme & visual", "operations &",
                            "multi-monitor", "default applications", "mission elapsed", "capcom",
                            "go / no-go", "moc power", "reboot flight"
                        ])
                    )

                    if is_custom_theme:
                        tier = 0
                    elif not is_terminal:
                        tier = 1
                    else:
                        tier = 2

                    apps.append({
                        "name": name,
                        "generic": generic,
                        "comment": comment,
                        "exec": clean_exec,
                        "category": assigned_cat,
                        "tier": tier,
                        "is_terminal": is_terminal,
                        "path": path,
                    })
                except Exception:
                    continue
    
    apps.sort(key=lambda x: (x["tier"], x["name"].lower()))
    return apps

class DskyLauncher(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.theme_name = get_current_theme()
        self.t = THEMES[self.theme_name]
        self.apps = get_all_apps()
        self.active_category = "ALL"
        self.filtered_apps = []
        self.selected_index = 0
        self.css_provider = None
        
        self.set_title("Apollo AGC DSKY Launcher")
        self.set_default_size(560, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_resizable(False)
        
        if HAS_LAYER_SHELL:
            GtkLayerShell.init_for_window(self)
            GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
            try:
                GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
            except Exception:
                GtkLayerShell.set_keyboard_interactivity(self, True)
            GtkLayerShell.set_namespace(self, "dsky-launcher")
        
        self.apply_css()
        self.build_ui()
        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", lambda w, e: self.close_launcher())
        
        if HAVE_GLIB_UNIX:
            GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.on_sigusr1)
        else:
            try:
                GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.on_sigusr1)
            except Exception:
                pass
        
        self.comp_acty_state = True
        GLib.timeout_add(500, self.on_blink_comp_acty)
        
        self.filter_apps()

    def on_blink_comp_acty(self):
        self.comp_acty_state = not self.comp_acty_state
        if hasattr(self, 'comp_box') and self.comp_box:
            if self.comp_acty_state:
                self.comp_box.get_style_context().add_class("active")
            else:
                self.comp_box.get_style_context().remove_class("active")
        return True

    def on_sigusr1(self):
        self.reload_theme()
        return True

    def reload_theme(self):
        self.theme_name = get_current_theme()
        self.t = THEMES[self.theme_name]
        self.apply_css()
        self.render_list()

