    def build_ui(self):
        self.set_name("main-window")
        
        # Outer Chassis Frame
        chassis = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        chassis.set_name("chassis-frame")
        self.add(chassis)
        
        # --- 1. TOP DSKY CONSOLE PANEL: Annunciators (Left 2x4) & Proportional Registers (Right 2x2) ---
        top_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        top_box.get_style_context().add_class("dsky-top-panel")
        chassis.pack_start(top_box, False, False, 0)
        
        # Left: Annunciator Category Matrix (2 cols x 4 rows)
        self.annunciator_grid = Gtk.Grid()
        self.annunciator_grid.set_row_spacing(2)
        self.annunciator_grid.set_column_spacing(3)
        
        self.annunciator_buttons = {}
        self.cat_list = []
        
        for row_idx, row_items in enumerate(CATEGORIES_GRID):
            for col_idx, (cat_id, code, label) in enumerate(row_items):
                btn = Gtk.Button(label=label)
                btn.set_can_focus(False)
                btn.set_focus_on_click(False)
                btn.get_style_context().add_class("annunciator-btn")
                if cat_id == "ALL":
                    btn.get_style_context().add_class("active")
                btn.connect("clicked", self.on_annunciator_clicked, cat_id, code)
                self.annunciator_grid.attach(btn, col_idx, row_idx, 1, 1)
                self.annunciator_buttons[cat_id] = btn
                self.cat_list.append((cat_id, code, label))
                
        top_box.pack_start(self.annunciator_grid, False, False, 0)
        
        # Vertical Separator between left & right
        sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        top_box.pack_start(sep, False, False, 4)
        
        # Right: Proportional 2x2 AGC Display Unit (Matching the 4-row height of annunciators)
        reg_grid = Gtk.Grid()
        reg_grid.set_row_spacing(2)
        reg_grid.set_column_spacing(3)
        reg_grid.set_hexpand(True)
        reg_grid.set_halign(Gtk.Align.END)
        reg_grid.set_valign(Gtk.Align.CENTER)
        
        # Top-Left: COMP ACTY indicator tile
        self.comp_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        self.comp_box.get_style_context().add_class("comp-tile")
        self.comp_box.get_style_context().add_class("active")
        self.lbl_comp = Gtk.Label(label="COMP ACTY")
        self.lbl_comp.set_valign(Gtk.Align.CENTER)
        self.comp_box.pack_start(self.lbl_comp, True, True, 4)
        reg_grid.attach(self.comp_box, 0, 0, 1, 1)
        
        # Top-Right: PROG digital register
        p_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        p_vbox.get_style_context().add_class("digital-box")
        lbl_p = Gtk.Label(label="PROG")
        lbl_p.get_style_context().add_class("digital-lbl")
        self.lbl_prog_val = Gtk.Label(label="00")
        self.lbl_prog_val.get_style_context().add_class("digital-val")
        p_vbox.pack_start(lbl_p, False, False, 0)
        p_vbox.pack_start(self.lbl_prog_val, True, True, 0)
        reg_grid.attach(p_vbox, 1, 0, 1, 1)
        
        # Bottom-Left: VERB digital register
        v_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        v_vbox.get_style_context().add_class("digital-box")
        lbl_v = Gtk.Label(label="VERB")
        lbl_v.get_style_context().add_class("digital-lbl")
        lbl_v_val = Gtk.Label(label="37")
        lbl_v_val.get_style_context().add_class("digital-val")
        v_vbox.pack_start(lbl_v, False, False, 0)
        v_vbox.pack_start(lbl_v_val, True, True, 0)
        reg_grid.attach(v_vbox, 0, 1, 1, 1)
        
        # Bottom-Right: NOUN digital register
        n_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        n_vbox.get_style_context().add_class("digital-box")
        lbl_n = Gtk.Label(label="NOUN")
        lbl_n.get_style_context().add_class("digital-lbl")
        lbl_n_val = Gtk.Label(label="00")
        lbl_n_val.get_style_context().add_class("digital-val")
        n_vbox.pack_start(lbl_n, False, False, 0)
        n_vbox.pack_start(lbl_n_val, True, True, 0)
        reg_grid.attach(n_vbox, 1, 1, 1, 1)
        
        top_box.pack_start(reg_grid, True, True, 0)
        
        # --- 2. MIDDLE: SEARCH BAR (Full-width below annunciators, top of app list) ---
        self.search_entry = Gtk.Entry()
        self.search_entry.get_style_context().add_class("search-entry")
        self.search_entry.set_placeholder_text("V37 N00 // RUN >")
        self.search_entry.connect("changed", self.on_search_changed)
        self.search_entry.connect("key-press-event", self.on_key_press)
        chassis.pack_start(self.search_entry, False, False, 0)
        
        # --- 3. BOTTOM: APPLICATION LIST ---
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_name("list-container")
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroll.set_vexpand(True)
        self.scroll.set_can_focus(False)
        chassis.pack_start(self.scroll, True, True, 0)
        
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.set_can_focus(False)
        self.scroll.add(self.listbox)
        
        # --- 4. FOOTER HINTS ---
        footer_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        chassis.pack_start(footer_box, False, False, 0)
        
        lbl_hint = Gtk.Label(label="[↑/↓] Select  |  [ENTER] Run  |  [TAB] Category  |  [ESC] Abort")
        lbl_hint.get_style_context().add_class("footer-lbl")
        footer_box.pack_start(lbl_hint, False, False, 2)
        
        self.lbl_count = Gtk.Label(label=f"PROGRAMS: {len(self.apps)}")
        self.lbl_count.get_style_context().add_class("footer-lbl")
        footer_box.pack_end(self.lbl_count, False, False, 2)

    def on_annunciator_clicked(self, btn, cat_id, code):
        self.set_active_category(cat_id, code)

    def set_active_category(self, cat_id, code):
        self.active_category = cat_id
        self.lbl_prog_val.set_text(code)
        for cid, b in self.annunciator_buttons.items():
            if cid == cat_id:
                b.get_style_context().add_class("active")
            else:
                b.get_style_context().remove_class("active")
        self.filter_apps()
        if hasattr(self, 'search_entry') and self.search_entry:
            self.search_entry.grab_focus()

    def filter_apps(self):
        query = self.search_entry.get_text().strip().lower()
        self.filtered_apps = []
        
        for app in self.apps:
            if self.active_category != "ALL" and app["category"] != self.active_category:
                continue
            
            if query:
                match = (
                    query in app["name"].lower() or
                    query in app["exec"].lower() or
                    query in app["comment"].lower() or
                    query in app["category"].lower() or
                    query in app["generic"].lower()
                )
                if not match:
                    continue
            
            self.filtered_apps.append(app)
        
        # Always prioritize: 1. Custom Theme Apps -> 2. GUI Apps -> 3. Console/CLI Apps
        self.filtered_apps.sort(key=lambda x: (x.get("tier", 1), x["name"].lower()))
        
        self.selected_index = 0
        self.lbl_count.set_text(f"PROGRAMS: {len(self.filtered_apps):02d}")
        self.render_list()

    def render_list(self):
        for child in self.listbox.get_children():
            self.listbox.remove(child)
            
        self.row_items = []
        
        for idx, app in enumerate(self.filtered_apps):
            row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            row_box.get_style_context().add_class("app-row")
            if idx == self.selected_index:
                row_box.get_style_context().add_class("selected")
            
            # Category Code Tag with tier indicator
            tier = app.get("tier", 1)
            cat_code = app['category'][:3].upper()
            if tier == 0:
                cat_tag = Gtk.Label(label=f"★ [{cat_code}]")
                cat_tag.get_style_context().add_class("cat-code-custom")
            elif tier == 2:
                cat_tag = Gtk.Label(label=f">_ [{cat_code}]")
                cat_tag.get_style_context().add_class("cat-code-cli")
            else:
                cat_tag = Gtk.Label(label=f"[{cat_code}]")
                cat_tag.get_style_context().add_class("cat-code")
            row_box.pack_start(cat_tag, False, False, 0)
            
            # App Info (Name & Clean Executable/Comment)
            text_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            title_lbl = Gtk.Label(label=app["name"], xalign=0)
            title_lbl.get_style_context().add_class("app-name")
            if idx == self.selected_index:
                title_lbl.get_style_context().add_class("selected")
            text_vbox.pack_start(title_lbl, False, False, 0)
            
            desc_text = app["comment"] if app["comment"] else app["exec"]
            if len(desc_text) > 55:
                desc_text = desc_text[:52] + "..."
            desc_lbl = Gtk.Label(label=desc_text, xalign=0)
            desc_lbl.get_style_context().add_class("app-cmd")
            text_vbox.pack_start(desc_lbl, False, False, 0)
            
            row_box.pack_start(text_vbox, True, True, 0)
            
            # Click handler
            eb = Gtk.EventBox()
            eb.add(row_box)
            eb.connect("button-press-event", self.on_item_clicked, idx)
            
            self.listbox.add(eb)
            self.row_items.append({
                "row_box": row_box,
                "title_lbl": title_lbl,
                "event_box": eb,
                "app": app
            })
        
        self.listbox.show_all()
        self.scroll_to_selected()

    def scroll_to_selected(self):
        if 0 <= self.selected_index < len(self.row_items):
            eb = self.row_items[self.selected_index]["event_box"]
            lb_row = eb.get_parent()
            target = lb_row if lb_row else eb
            GLib.idle_add(self._do_scroll, target)

    def _do_scroll(self, row):
        adj = self.scroll.get_vadjustment() if hasattr(self, 'scroll') else None
        if adj and row:
            alloc = row.get_allocation()
            val = adj.get_value()
            page_size = adj.get_page_size()
            if alloc.y < val:
                adj.set_value(alloc.y)
            elif alloc.y + alloc.height > val + page_size:
                adj.set_value(alloc.y + alloc.height - page_size)
        return False

    def on_item_clicked(self, widget, event, idx):
        self.selected_index = idx
        self.update_selection_highlight()
        self.launch_selected()

    def on_search_changed(self, entry):
        self.filter_apps()

    def on_key_press(self, widget, event):
        keyval = event.keyval
        
        if keyval == Gdk.KEY_Escape:
            self.close_launcher()
            return True
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.launch_selected()
            return True
        elif keyval in (Gdk.KEY_Up, Gdk.KEY_KP_Up):
            if len(self.filtered_apps) > 0:
                self.selected_index = (self.selected_index - 1 + len(self.filtered_apps)) % len(self.filtered_apps)
                self.update_selection_highlight()
            return True
        elif keyval in (Gdk.KEY_Down, Gdk.KEY_KP_Down):
            if len(self.filtered_apps) > 0:
                self.selected_index = (self.selected_index + 1) % len(self.filtered_apps)
                self.update_selection_highlight()
            return True
        elif keyval in (Gdk.KEY_Page_Up, Gdk.KEY_KP_Page_Up):
            if len(self.filtered_apps) > 0:
                self.selected_index = max(0, self.selected_index - 5)
                self.update_selection_highlight()
            return True
        elif keyval in (Gdk.KEY_Page_Down, Gdk.KEY_KP_Page_Down):
            if len(self.filtered_apps) > 0:
                self.selected_index = min(len(self.filtered_apps) - 1, self.selected_index + 5)
                self.update_selection_highlight()
            return True
        elif keyval == Gdk.KEY_Tab:
            current_cat_idx = 0
            for i, (cid, code, _) in enumerate(self.cat_list):
                if cid == self.active_category:
                    current_cat_idx = i
                    break
            next_idx = (current_cat_idx + 1) % len(self.cat_list)
            next_cat, next_code, _ = self.cat_list[next_idx]
            self.set_active_category(next_cat, next_code)
            return True
        elif keyval == Gdk.KEY_ISO_Left_Tab:
            current_cat_idx = 0
            for i, (cid, code, _) in enumerate(self.cat_list):
                if cid == self.active_category:
                    current_cat_idx = i
                    break
            prev_idx = (current_cat_idx - 1 + len(self.cat_list)) % len(self.cat_list)
            prev_cat, prev_code, _ = self.cat_list[prev_idx]
            self.set_active_category(prev_cat, prev_code)
            return True
            
        return False

    def update_selection_highlight(self):
        for idx, item in enumerate(self.row_items):
            row_box = item["row_box"]
            title_lbl = item["title_lbl"]
            if idx == self.selected_index:
                row_box.get_style_context().add_class("selected")
                title_lbl.get_style_context().add_class("selected")
            else:
                row_box.get_style_context().remove_class("selected")
                title_lbl.get_style_context().remove_class("selected")
        self.scroll_to_selected()

    def launch_selected(self):
        if 0 <= self.selected_index < len(self.filtered_apps):
            app = self.filtered_apps[self.selected_index]
            exec_cmd = app["exec"]
            cmd = re.sub(r"%[a-zA-Z]", "", exec_cmd).strip()
            try:
                subprocess.Popen(cmd, shell=True, start_new_session=True)
            except Exception as e:
                print(f"Error launching {cmd}: {e}", file=sys.stderr)
        self.close_launcher()

    def close_launcher(self):
        cleanup()
        Gtk.main_quit()
        self.destroy()

PID_FILE = f"/tmp/dsky-launcher-{os.getuid()}.pid"

def check_singleton():
    my_pid = os.getpid()
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                old_pid = int(f.read().strip())
            if old_pid != my_pid:
                try:
                    os.kill(old_pid, 0)
                    os.kill(old_pid, signal.SIGTERM)
                    try:
                        os.remove(PID_FILE)
                    except OSError:
                        pass
                    sys.exit(0)
                except OSError:
                    pass
        except Exception:
            pass

    try:
        with open(PID_FILE, "w") as f:
            f.write(str(my_pid))
    except Exception:
        pass

def cleanup():
    try:
        if os.path.exists(PID_FILE):
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            if pid == os.getpid():
                os.remove(PID_FILE)
    except Exception:
        pass

def main():
    check_singleton()
    app = DskyLauncher()
    app.connect("destroy", lambda w: (cleanup(), Gtk.main_quit()))
    app.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
