#!/usr/bin/env python3
"""
Apollo Mission Control Capture & Mission Tools Dialog
Provides interactive GUI panel for Area/Fullscreen Screenshots,
Screen Video Recording with audio & keystroke toggles,
and quick media storage access.
Strictly dark chassis & zero-white-background theme adherence.
"""
import sys
import os
import subprocess
import signal
import time
import json
from pathlib import Path
import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk, GLib

PID_FILE = f"/tmp/space-tools-dialog-{os.getuid()}.pid"
REC_PID_FILE = Path("/tmp/space-recording.pid")
REC_INFO_FILE = Path("/tmp/space-recording.info")

