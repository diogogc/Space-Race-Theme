def get_theme_name():
    path = os.path.expanduser("~/.config/themes/current_theme")
    if os.path.exists(path):
        try:
            with open(path, "r") as f:
                t = f.read().strip()
                if t in THEMES:
                    return t
        except Exception:
            pass
    return "nasa"

def is_recording_active():
    if REC_PID_FILE.exists():
        try:
            pid = int(REC_PID_FILE.read_text().strip())
            os.kill(pid, 0)
            return True
        except Exception:
            pass
    return False

def get_ai_engine():
    if CONFIG_FILE.exists():
        try:
            for line in CONFIG_FILE.read_text().splitlines():
                if line.startswith("AI_ENGINE="):
                    val = line.split("=", 1)[1].strip().strip('"').strip("'")
                    if val:
                        return val
        except Exception:
            pass
    return "agy"

def is_recovery_service_enabled():
    try:
        out = subprocess.check_output(
            ["systemctl", "--user", "is-enabled", "kernel-fallback-collector.service"],
            text=True, stderr=subprocess.DEVNULL
        ).strip()
        return (out == "enabled")
    except Exception:
        return False

def is_recovery_alert_active():
    if VAULT_ALERT.exists():
        try:
            if "status: active-warning" in VAULT_ALERT.read_text():
                return True
        except Exception:
            pass
    if LOG_DUMP.exists():
        return True
    return False

def query_monitors():
    try:
        out = subprocess.check_output(["hyprctl", "-j", "monitors"], text=True, stderr=subprocess.DEVNULL)
        return json.loads(out)
    except Exception:
        return []

def execute_hyprctl_monitor(rule_str):
    try:
        subprocess.run(["hyprctl", "keyword", "monitor", rule_str], check=True, capture_output=True)
        return True
    except Exception as e:
        print(f"Hyprctl error: {e}", file=sys.stderr)
        return False

def save_monitors_config(rules):
    MONITORS_CONF.parent.mkdir(parents=True, exist_ok=True)
    content = "# Apollo Space Race - Persistent Monitor Topology\n"
    for r in rules:
        content += f"monitor = {r}\n"
    MONITORS_CONF.write_text(content)

def launch_in_terminal(cmd_str, title="Apollo Operations Console"):
    term = "ghostty" if shutil.which("ghostty") else "kitty"
    if term == "ghostty":
        subprocess.Popen([
            "ghostty",
            f"--title={title}",
            "-e", "bash", "-c", f"{cmd_str}; echo; echo '[Operation Completed] Press any key to close...'; read -n 1 -s -r"
        ], start_new_session=True)
    else:
        subprocess.Popen([
            "kitty",
            "--title", title,
            "bash", "-c", f"{cmd_str}; echo; echo '[Operation Completed] Press any key to close...'; read -n 1 -s -r"
        ], start_new_session=True)

class SpaceToolsDialog(Gtk.Window):
    def __init__(self, initial_tab="capture", initial_view="main"):
        super().__init__(title="Apollo Mission Control // Operations & Tools")
        self.set_wmclass("space-tools-dialog", "space-tools-dialog")
        self.set_role("dialog")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_default_size(660, 580)

        self.theme_name = get_theme_name()
        self.pal = THEMES.get(self.theme_name, THEMES["nasa"])

        # Navigation State
        self.active_tab = initial_tab  # "capture", "system", "display"
        self.current_view = initial_view  # "main", "rec"
        self.capture_selected_idx = 0
        self.rec_selected_idx = 0
        self.system_selected_idx = 0
        self.display_selected_idx = 0

        # Recording configuration toggles
        self.rec_mode = "area"      # "area" or "full"
        self.rec_sys_audio = True   # Desktop sounds default ON
        self.rec_mic_audio = False  # Mic default OFF
        self.rec_keystrokes = False # Keystrokes default OFF (security opt-in)

        # Widget registries
        self.capture_buttons = []
        self.rec_ctrl_items = []
        self.system_buttons = []
        self.display_buttons = []

        self.apply_css()
        self.build_ui()
        self.connect("key-press-event", self.on_key_press)

        if initial_tab == "system":
            self.switch_tab("system")
        elif initial_tab in ["display", "monitors"]:
            self.switch_tab("display")
        elif initial_view == "rec":
            self.switch_to_rec_view()
        else:
            self.switch_tab("capture")

