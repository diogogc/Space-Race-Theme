    def render_topology_chips(self):
        for child in self.topo_box.get_children():
            self.topo_box.remove(child)

        mons = query_monitors()
        if not mons:
            lbl = Gtk.Label()
            lbl.set_markup(f"<span font_size='8500' foreground='{self.pal['text_dim']}'>No active displays detected via Hyprland IPC.</span>")
            self.topo_box.pack_start(lbl, True, True, 0)
            self.topo_box.show_all()
            return

        for m in mons:
            chip = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            chip.get_style_context().add_class("monitor-chip")
            if m.get("focused") or m.get("id") == 0:
                chip.get_style_context().add_class("primary")

            m_name = m.get("name", "Unknown")
            m_res = f"{m.get('width', 0)}x{m.get('height', 0)}@{int(m.get('refreshRate', 60))}Hz"
            m_pos = f"Pos: ({m.get('x', 0)}, {m.get('y', 0)})"
            m_scale = f"Scale: {m.get('scale', 1.0)}x"
            m_ws = f"WS: {m.get('activeWorkspace', {}).get('name', '1')}"

            l_name = Gtk.Label()
            l_name.set_markup(f"<span font_weight='bold' font_size='8500' foreground='{self.pal['text_main']}'>🖥️ {m_name}</span>")
            l_name.set_xalign(0.0)
            chip.pack_start(l_name, False, False, 0)

            l_meta = Gtk.Label()
            l_meta.set_markup(f"<span font_size='7500' foreground='{self.pal['text_sub']}'>{m_res} ({m_scale})\n{m_pos} | {m_ws}</span>")
            l_meta.set_xalign(0.0)
            chip.pack_start(l_meta, False, False, 0)

            self.topo_box.pack_start(chip, True, True, 0)

        self.topo_box.show_all()

    def refresh_system_telemetry(self):
        ai_engine = get_ai_engine().upper()
        recovery_enabled = is_recovery_service_enabled()
        service_badge = f"<span foreground='{self.pal['green']}'>[ ARMED &amp; ACTIVE ]</span>" if recovery_enabled else f"<span foreground='{self.pal['text_dim']}'>[ OPTED-OUT ]</span>"

        alert_active = is_recovery_alert_active()
        alert_badge = f"<span foreground='{self.pal['red']}' font_weight='bold'>⚠️ ALERT ACTIVE (Dump Cached)</span>" if alert_active else f"<span foreground='{self.pal['green']}'>✅ NOMINAL (Clean)</span>"

        current_kernel = os.uname().release
        
        try:
            out = subprocess.check_output(["systemctl", "--failed", "--no-legend", "--plain"], text=True, stderr=subprocess.DEVNULL)
            failed_count = len([line for line in out.splitlines() if line.strip()])
        except Exception:
            failed_count = 0
        failed_badge = f"<span foreground='{self.pal['green']}'>0 Failed</span>" if failed_count == 0 else f"<span foreground='{self.pal['red']}'>{failed_count} Failed</span>"

        boot_space = "N/A"
        try:
            st = os.statvfs("/boot")
            free_mb = (st.f_bavail * st.f_frsize) / (1024 * 1024)
            total_mb = (st.f_blocks * st.f_frsize) / (1024 * 1024)
            used_pct = int(((total_mb - free_mb) / total_mb) * 100)
            boot_space = f"{used_pct}% ({int(free_mb)}MB free)"
        except Exception:
            pass

        markup = (
            f"<span font_weight='bold' foreground='{self.pal['text_main']}'>🛡️ SYSTEM INTEGRITY &amp; RECOVERY TELEMETRY</span>\n"
            f"<span font_size='8500' foreground='{self.pal['text_sub']}'>"
            f"• <b>AI Harness:</b> <span foreground='{self.pal['cyan']}'>{ai_engine}</span>  |  <b>Service:</b> {service_badge}  |  <b>Status:</b> {alert_badge}\n"
            f"• <b>Active Kernel:</b> {current_kernel}  |  <b>Units:</b> {failed_badge}  |  <b>/boot:</b> {boot_space}"
            f"</span>"
        )
        self.lbl_health_telemetry.set_markup(markup)

    def refresh_capture_ui(self):
        rec_active = is_recording_active()
        for i, btn in enumerate(self.capture_buttons):
            ctx = btn.get_style_context()
            if i == self.capture_selected_idx:
                ctx.add_class("selected")
            else:
                ctx.remove_class("selected")

            if i == 2:
                if rec_active:
                    ctx.add_class("active-rec")
                else:
                    ctx.remove_class("active-rec")

    def refresh_system_ui(self):
        self.populate_system_tool_rows()
        self.refresh_system_telemetry()
        for i, btn in enumerate(self.system_buttons):
            ctx = btn.get_style_context()
            if i == self.system_selected_idx:
                ctx.add_class("selected")
            else:
                ctx.remove_class("selected")

    def refresh_display_ui(self):
        self.render_topology_chips()
        for i, btn in enumerate(self.display_buttons):
            ctx = btn.get_style_context()
            if i == self.display_selected_idx:
                ctx.add_class("selected")
            else:
                ctx.remove_class("selected")

    def refresh_rec_ui(self):
        ma_act = (self.rec_mode == "area")
        ma_col = self.pal['accent'] if ma_act else self.pal['text_dim']
        self.lbl_mode_area.set_markup(f"<span font_weight='bold' foreground='{ma_col}'>[{'●' if ma_act else '○'}] [1] REGION SELECTION (Drag area with slurp)</span>")
        self.lbl_mode_area.set_xalign(0.0)

        mf_act = (self.rec_mode == "full")
        mf_col = self.pal['accent'] if mf_act else self.pal['text_dim']
        self.lbl_mode_full.set_markup(f"<span font_weight='bold' foreground='{mf_col}'>[{'●' if mf_act else '○'}] [2] FULL SCREEN DISPLAY (All monitors)</span>")
        self.lbl_mode_full.set_xalign(0.0)

        sa_col = self.pal['green'] if self.rec_sys_audio else self.pal['text_dim']
        sa_txt = "[ ON  ]" if self.rec_sys_audio else "[ OFF ]"
        self.lbl_sys_audio.set_markup(f"<span font_weight='bold' foreground='{sa_col}'>[{'✔' if self.rec_sys_audio else ' '}] [S] DESKTOP AUDIO (System sounds): {sa_txt}</span>")
        self.lbl_sys_audio.set_xalign(0.0)

        mi_col = self.pal['green'] if self.rec_mic_audio else self.pal['text_dim']
        mi_txt = "[ ON  ]" if self.rec_mic_audio else "[ OFF ]"
        self.lbl_mic_audio.set_markup(f"<span font_weight='bold' foreground='{mi_col}'>[{'✔' if self.rec_mic_audio else ' '}] [M] MICROPHONE (Intercom voice): {mi_txt}</span>")
        self.lbl_mic_audio.set_xalign(0.0)

        ky_col = self.pal['cyan'] if self.rec_keystrokes else self.pal['text_dim']
        ky_txt = "[ ON  ]" if self.rec_keystrokes else "[ OFF ]"
        self.lbl_keys.set_markup(f"<span font_weight='bold' foreground='{ky_col}'>[{'✔' if self.rec_keystrokes else ' '}] [K] SHOW KEYSTROKES (On-screen overlay): {ky_txt}</span>")
        self.lbl_keys.set_xalign(0.0)

        self.lbl_engage.set_markup(f"<span font_weight='bold' foreground='{self.pal['green']}'>[ ENTER / R ] START RECORDING</span>")
        self.lbl_back.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_sub']}'>[ ESC / B ] CANCEL &amp; RETURN</span>")

        for i, btn in enumerate(self.rec_ctrl_items):
            ctx = btn.get_style_context()
            if i == self.rec_selected_idx:
                ctx.add_class("selected")
            else:
                ctx.remove_class("selected")

    def switch_tab(self, tab_name):
        self.active_tab = tab_name
        self.current_view = "main"
        self.update_tab_headers()

        if tab_name == "capture":
            self.refresh_capture_ui()
            self.stack.set_visible_child_name("capture")
        elif tab_name == "system":
            self.refresh_system_ui()
            self.stack.set_visible_child_name("system")
        elif tab_name == "display":
            self.refresh_display_ui()
            self.stack.set_visible_child_name("display")

    def switch_to_rec_view(self):
        self.active_tab = "capture"
        self.current_view = "rec"
        self.rec_selected_idx = 0
        self.refresh_rec_ui()
        self.stack.set_visible_child_name("rec")

    def toggle_rec_mode(self, mode):
        self.rec_mode = mode
        self.refresh_rec_ui()

    def toggle_opt(self, opt_name):
        if opt_name == "sys_audio":
            self.rec_sys_audio = not self.rec_sys_audio
        elif opt_name == "mic_audio":
            self.rec_mic_audio = not self.rec_mic_audio
        elif opt_name == "keystrokes":
            self.rec_keystrokes = not self.rec_keystrokes
        self.refresh_rec_ui()

    def start_rec(self):
        self.hide()
        cleanup()
        cmd = ["space-capture", "record", self.rec_mode]
        if self.rec_sys_audio:
            cmd.append("--sys-audio")
        if self.rec_mic_audio:
            cmd.append("--mic-audio")
        if self.rec_keystrokes:
            cmd.append("--keystrokes")
        GLib.timeout_add(150, lambda: (subprocess.Popen(cmd, start_new_session=True), Gtk.main_quit()))

    def trigger_capture_action(self, idx):
        item = self.capture_tool_items[idx]
        action = item["action"]

        if action == "area_shot":
            self.hide()
            cleanup()
            GLib.timeout_add(150, lambda: (subprocess.Popen(["space-capture", "area"], start_new_session=True), Gtk.main_quit()))
        elif action == "full_shot":
            self.hide()
            cleanup()
            GLib.timeout_add(150, lambda: (subprocess.Popen(["space-capture", "full"], start_new_session=True), Gtk.main_quit()))
        elif action == "rec_menu":
            if is_recording_active():
                self.hide()
                cleanup()
                subprocess.Popen(["space-capture", "stop"], start_new_session=True)
                Gtk.main_quit()
            else:
                self.switch_to_rec_view()
        elif action == "open_prints":
            self.hide()
            cleanup()
            p_dir = os.path.expanduser("~/Pictures/prints")
            os.makedirs(p_dir, exist_ok=True)
            subprocess.Popen(["xdg-open", p_dir], start_new_session=True)
            Gtk.main_quit()
        elif action == "open_videos":
            self.hide()
            cleanup()
            v_dir = os.path.expanduser("~/Videos")
            os.makedirs(v_dir, exist_ok=True)
            subprocess.Popen(["xdg-open", v_dir], start_new_session=True)
            Gtk.main_quit()

    def trigger_system_action(self, idx):
        item = self.system_tool_items[idx]
        action = item["action"]

        if action == "btrfs_snap":
            self.hide()
            cleanup()
            ts = time.strftime('%Y%m%d-%H%M%S')
            snap_cmd = f"sudo btrfs subvolume snapshot -r / /@snapshots/manual-{ts} 2>/dev/null || sudo btrfs subvolume snapshot -r / /.snapshots/manual-{ts} 2>/dev/null || sudo btrfs subvolume snapshot -r / /snapshots-manual-{ts}"
            launch_in_terminal(
                f"echo '==> Creating Btrfs Root Recovery Snapshot...'; {snap_cmd} && echo '✅ Snapshot created successfully!' && notify-send -u normal -a 'Apollo Ops' '📸 Btrfs Snapshot Created' 'Saved root snapshot for recovery.'",
                title="Btrfs Snapshot Subsystem"
            )
            Gtk.main_quit()
        elif action == "ai_diagnose":
            self.hide()
            cleanup()
            launch_in_terminal("space-ai-recovery", title="Apollo AI Diagnostic Harness")
            Gtk.main_quit()
        elif action == "ai_config":
            self.hide()
            cleanup()
            launch_in_terminal("space-ai-recovery --config", title="Apollo AI Engine Configurator")
            Gtk.main_quit()
        elif action == "ai_opt_in":
            self.hide()
            cleanup()
            launch_in_terminal(
                "echo '==> Enabling Apollo Autonomous Recovery Subsystem...'; systemctl --user daemon-reload && systemctl --user enable kernel-fallback-collector.service && space-ai-recovery --config && notify-send -a 'Apollo Ops' '🛡️ Recovery Enabled' 'Autonomous boot watcher armed.'",
                title="Apollo Recovery Enablement"
            )
            Gtk.main_quit()
        elif action == "ai_clean":
            subprocess.run(["space-ai-recovery", "--clean"], capture_output=True)
            self.refresh_system_ui()
            if shutil.which("notify-send"):
                subprocess.Popen(["notify-send", "-a", "Apollo Ops", "🧹 Recovery State Cleaned", "Purged failure logs and resolved active warnings."], start_new_session=True)
        elif action == "rebuild_ramdisks":
            self.hide()
            cleanup()
            launch_in_terminal("echo '==> Rebuilding Initramfs for all installed kernels...'; sudo mkinitcpio -P && echo '✅ Ramdisks regenerated successfully!'", title="Ramdisk Maintenance")
            Gtk.main_quit()
        elif action == "clean_pkgs":
            self.hide()
            cleanup()
            launch_in_terminal("echo '==> Cleaning Pacman cache and unneeded orphans...'; sudo paccache -r; sudo pacman -Rns $(pacman -Qdtq) 2>/dev/null || echo 'No orphans found.'; echo '✅ Package maintenance complete!'", title="Package & Cache Maintenance")
            Gtk.main_quit()

    def trigger_display_action(self, idx):
        item = self.display_presets[idx]
        action = item["action"]
        mons = query_monitors()

        if action == "auto":
            execute_hyprctl_monitor(",preferred,auto,1")
            save_monitors_config([",preferred,auto,1"])
        elif len(mons) < 2:
            execute_hyprctl_monitor(",preferred,auto,1")
            save_monitors_config([",preferred,auto,1"])
            if action != "auto" and shutil.which("notify-send"):
                subprocess.Popen(["notify-send", "-a", "Apollo Display", "ℹ️ Single Display Active", f"Applied auto layout for {mons[0].get('name', 'display')}."], start_new_session=True)
        else:
            primary = mons[0]
            secondary = mons[1]
            p_name = primary.get("name")
            s_name = secondary.get("name")
            p_w = primary.get("width", 1920)
            s_w = secondary.get("width", 1920)

            if action == "extend_right":
                r1 = f"{p_name},preferred,0x0,1"
                r2 = f"{s_name},preferred,{p_w}x0,1"
                execute_hyprctl_monitor(r1)
                execute_hyprctl_monitor(r2)
                save_monitors_config([r1, r2])
            elif action == "extend_left":
                r1 = f"{s_name},preferred,0x0,1"
                r2 = f"{p_name},preferred,{s_w}x0,1"
                execute_hyprctl_monitor(r1)
                execute_hyprctl_monitor(r2)
                save_monitors_config([r1, r2])
            elif action == "mirror":
                r1 = f"{p_name},preferred,0x0,1"
                r2 = f"{s_name},preferred,0x0,1,mirror,{p_name}"
                execute_hyprctl_monitor(r1)
                execute_hyprctl_monitor(r2)
                save_monitors_config([r1, r2])
            elif action == "primary_only":
                r1 = f"{p_name},preferred,0x0,1"
                r2 = f"{s_name},disable"
                execute_hyprctl_monitor(r1)
                execute_hyprctl_monitor(r2)
                save_monitors_config([r1, r2])
            elif action == "docked":
                r1 = f"{p_name},disable"
                r2 = f"{s_name},preferred,0x0,1"
                execute_hyprctl_monitor(r1)
                execute_hyprctl_monitor(r2)
                save_monitors_config([r1, r2])

        if shutil.which("hyprpaper"):
            subprocess.Popen(["killall", "-SIGUSR2", "hyprpaper"], stderr=subprocess.DEVNULL)
        
        self.render_topology_chips()
        if shutil.which("notify-send"):
            subprocess.Popen(["notify-send", "-a", "Apollo Display", "🖥️ Display Layout Applied", f"Topology preset: {item['title']}"], start_new_session=True)

    def on_key_press(self, widget, event):
        keyname = Gdk.keyval_name(event.keyval)

        # Global Esc / Quit
        if keyname in ["Escape", "q", "Q"]:
            if self.current_view == "rec":
                self.switch_tab("capture")
                return True
            cleanup()
            Gtk.main_quit()
            return True

        # Direct Tab Switching Hotkeys
        if keyname in ["c", "C"] and self.current_view != "rec":
            self.switch_tab("capture")
            return True
        if keyname in ["s", "S"] and self.current_view != "rec":
            self.switch_tab("system")
            return True
        if keyname in ["d", "D", "m", "M"] and self.current_view != "rec":
            self.switch_tab("display")
            return True

        # Capture Tab Navigation
        if self.active_tab == "capture" and self.current_view == "main":
            if keyname in ["Down", "j", "J"]:
                self.capture_selected_idx = (self.capture_selected_idx + 1) % len(self.capture_tool_items)
                self.refresh_capture_ui()
                return True
            if keyname in ["Up", "k", "K"]:
                self.capture_selected_idx = (self.capture_selected_idx - 1 + len(self.capture_tool_items)) % len(self.capture_tool_items)
                self.refresh_capture_ui()
                return True
            if keyname in ["Tab"]:
                self.switch_tab("system")
                return True
            if keyname in ["ISO_Left_Tab"]:
                self.switch_tab("display")
                return True
            if keyname in ["Return", "KP_Enter", "space"]:
                self.trigger_capture_action(self.capture_selected_idx)
                return True
            if keyname in ["1", "2", "3", "4", "5"]:
                idx = int(keyname) - 1
                if 0 <= idx < len(self.capture_tool_items):
                    self.trigger_capture_action(idx)
                    return True
            return False

        # System Tab Navigation
        elif self.active_tab == "system" and self.current_view == "main":
            if keyname in ["Down", "j", "J"]:
                self.system_selected_idx = (self.system_selected_idx + 1) % len(self.system_tool_items)
                self.refresh_system_ui()
                return True
            if keyname in ["Up", "k", "K"]:
                self.system_selected_idx = (self.system_selected_idx - 1 + len(self.system_tool_items)) % len(self.system_tool_items)
                self.refresh_system_ui()
                return True
            if keyname in ["Tab"]:
                self.switch_tab("display")
                return True
            if keyname in ["ISO_Left_Tab"]:
                self.switch_tab("capture")
                return True
            if keyname in ["Return", "KP_Enter", "space"]:
                self.trigger_system_action(self.system_selected_idx)
                return True
            if keyname in ["1", "2", "3", "4", "5", "6", "7"]:
                idx = int(keyname) - 1
                if 0 <= idx < len(self.system_tool_items):
                    self.trigger_system_action(idx)
                    return True
            return False

        # Display Radar Tab Navigation
        elif self.active_tab == "display" and self.current_view == "main":
            if keyname in ["Down", "j", "J"]:
                self.display_selected_idx = (self.display_selected_idx + 1) % len(self.display_presets)
                self.refresh_display_ui()
                return True
            if keyname in ["Up", "k", "K"]:
                self.display_selected_idx = (self.display_selected_idx - 1 + len(self.display_presets)) % len(self.display_presets)
                self.refresh_display_ui()
                return True
            if keyname in ["Tab"]:
                self.switch_tab("capture")
                return True
            if keyname in ["ISO_Left_Tab"]:
                self.switch_tab("system")
                return True
            if keyname in ["r", "R"]:
                self.render_topology_chips()
                return True
            if keyname in ["Return", "KP_Enter", "space"]:
                self.trigger_display_action(self.display_selected_idx)
                return True
            if keyname in ["1", "2", "3", "4", "5", "6"]:
                idx = int(keyname) - 1
                if 0 <= idx < len(self.display_presets):
                    self.trigger_display_action(idx)
                    return True
            return False

        # Recorder Sub-view Navigation
        elif self.current_view == "rec":
            if keyname in ["Down", "j", "J", "Tab"]:
                self.rec_selected_idx = (self.rec_selected_idx + 1) % len(self.rec_ctrl_items)
                self.refresh_rec_ui()
                return True
            if keyname in ["Up", "k", "K", "ISO_Left_Tab"]:
                self.rec_selected_idx = (self.rec_selected_idx - 1 + len(self.rec_ctrl_items)) % len(self.rec_ctrl_items)
                self.refresh_rec_ui()
                return True
            if keyname in ["1"]:
                self.toggle_rec_mode("area")
                return True
            if keyname in ["2"]:
                self.toggle_rec_mode("full")
                return True
            if keyname in ["s", "S"]:
                self.toggle_opt("sys_audio")
                return True
            if keyname in ["m", "M"]:
                self.toggle_opt("mic_audio")
                return True
            if keyname in ["k", "K"]:
                self.toggle_opt("keystrokes")
                return True
            if keyname in ["r", "R"]:
                self.start_rec()
                return True
            if keyname in ["Return", "KP_Enter", "space"]:
                if self.rec_selected_idx == 0:
                    self.toggle_rec_mode("area")
                elif self.rec_selected_idx == 1:
                    self.toggle_rec_mode("full")
                elif self.rec_selected_idx == 2:
                    self.toggle_opt("sys_audio")
                elif self.rec_selected_idx == 3:
                    self.toggle_opt("mic_audio")
                elif self.rec_selected_idx == 4:
                    self.toggle_opt("keystrokes")
                elif self.rec_selected_idx == 5:
                    self.start_rec()
                elif self.rec_selected_idx == 6:
                    self.switch_tab("capture")
                return True
            return False

        return False

def check_singleton():
    my_pid = os.getpid()
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                old_pid = int(f.read().strip())
            if old_pid != my_pid:
                try:
                    os.kill(old_pid, 0)
                    os.kill(old_pid, signal.SIGTERM)
                    try:
                        os.remove(PID_FILE)
                    except OSError:
                        pass
                    sys.exit(0)
                except OSError:
                    pass
        except Exception:
            pass

    try:
        with open(PID_FILE, "w") as f:
            f.write(str(my_pid))
    except Exception:
        pass

def cleanup():
    try:
        if os.path.exists(PID_FILE):
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            if pid == os.getpid():
                os.remove(PID_FILE)
    except Exception:
        pass

def main():
    check_singleton()
    init_tab = "capture"
    init_view = "main"

    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ["system", "recovery", "health"]:
            init_tab = "system"
        elif arg in ["display", "monitors", "radar"]:
            init_tab = "display"
        elif arg in ["rec", "record"]:
            init_view = "rec"

    win = SpaceToolsDialog(initial_tab=init_tab, initial_view=init_view)
    win.connect("destroy", lambda w: (cleanup(), Gtk.main_quit()))
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
