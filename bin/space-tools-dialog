    def build_ui(self):
        root_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root_vbox)

        # 1. Header Box
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.get_style_context().add_class("header-box")

        title = Gtk.Label()
        title.set_markup(f"<span font_weight='bold' font_size='11000' foreground='{self.pal['text_main']}'>🛠️ APOLLO MISSION CONTROL // OPERATIONS &amp; TOOLS</span>")
        title.set_xalign(0.0)
        header.pack_start(title, False, False, 0)

        utc_str = time.strftime('%H:%M:%S UTC', time.gmtime())
        sub = Gtk.Label()
        sub.set_markup(f"<span font_size='8500' foreground='{self.pal['green']}'>[ STATUS: NOMINAL ]</span> <span font_size='8500' foreground='{self.pal['text_dim']}'>| UTC: {utc_str} | PROFILE: {self.theme_name.upper()}</span>")
        sub.set_xalign(0.0)
        header.pack_start(sub, False, False, 0)
        root_vbox.pack_start(header, False, False, 0)

        # 2. Navigation Tab Bar (3 Tabs)
        tab_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        tab_bar.get_style_context().add_class("tab-bar")

        # Tab 1: Capture
        self.tab_capture = Gtk.EventBox()
        self.tab_capture.get_style_context().add_class("nav-tab")
        self.lbl_tab_capture = Gtk.Label()
        self.tab_capture.add(self.lbl_tab_capture)
        self.tab_capture.connect("button-press-event", lambda w, e: self.switch_tab("capture"))
        tab_bar.pack_start(self.tab_capture, False, False, 0)

        # Tab 2: System Tools & Recovery
        self.tab_system = Gtk.EventBox()
        self.tab_system.get_style_context().add_class("nav-tab")
        self.lbl_tab_system = Gtk.Label()
        self.tab_system.add(self.lbl_tab_system)
        self.tab_system.connect("button-press-event", lambda w, e: self.switch_tab("system"))
        tab_bar.pack_start(self.tab_system, False, False, 0)

        # Tab 3: Multi-Monitor Display Radar
        self.tab_display = Gtk.EventBox()
        self.tab_display.get_style_context().add_class("nav-tab")
        self.lbl_tab_display = Gtk.Label()
        self.tab_display.add(self.lbl_tab_display)
        self.tab_display.connect("button-press-event", lambda w, e: self.switch_tab("display"))
        tab_bar.pack_start(self.tab_display, False, False, 0)

        root_vbox.pack_start(tab_bar, False, False, 0)

        # 3. Main Stack Container
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)
        root_vbox.pack_start(self.stack, True, True, 0)

        # Build Tab Pages
        self.build_capture_tab()
        self.build_rec_view()
        self.build_system_tab()
        self.build_display_tab()

        # 4. Footer Hint
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        footer.set_margin_top(4)
        footer.set_margin_bottom(8)
        footer.set_margin_left(16)
        footer.set_margin_right(16)

        self.lbl_footer = Gtk.Label()
        self.lbl_footer.set_xalign(0.5)
        footer.pack_start(self.lbl_footer, True, True, 0)
        root_vbox.pack_start(footer, False, False, 0)

        self.update_tab_headers()

    def update_tab_headers(self):
        # Reset classes
        self.tab_capture.get_style_context().remove_class("active")
        self.tab_system.get_style_context().remove_class("active")
        self.tab_display.get_style_context().remove_class("active")

        if self.active_tab == "capture":
            self.tab_capture.get_style_context().add_class("active")
            self.lbl_tab_capture.set_markup(f"<span font_weight='bold' foreground='{self.pal['accent']}'>📸 [C] AV &amp; CAPTURE</span>")
            self.lbl_tab_system.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>🛡️ [S] RECOVERY</span>")
            self.lbl_tab_display.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>🛰️ [D] DISPLAY</span>")
            self.lbl_footer.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>[ TAB / S / D ] SWITCH TAB   [ ↑/↓ ] NAVIGATE   [ 1-5 / ENTER ] RUN   [ ESC ] CLOSE</span>")
        elif self.active_tab == "system":
            self.tab_system.get_style_context().add_class("active")
            self.lbl_tab_capture.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>📸 [C] AV &amp; CAPTURE</span>")
            self.lbl_tab_system.set_markup(f"<span font_weight='bold' foreground='{self.pal['accent']}'>🛡️ [S] RECOVERY</span>")
            self.lbl_tab_display.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>🛰️ [D] DISPLAY</span>")
            self.lbl_footer.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>[ TAB / C / D ] SWITCH TAB   [ ↑/↓ ] NAVIGATE   [ 1-6 / ENTER ] RUN   [ ESC ] CLOSE</span>")
        elif self.active_tab == "display":
            self.tab_display.get_style_context().add_class("active")
            self.lbl_tab_capture.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>📸 [C] AV &amp; CAPTURE</span>")
            self.lbl_tab_system.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>🛡️ [S] RECOVERY</span>")
            self.lbl_tab_display.set_markup(f"<span font_weight='bold' foreground='{self.pal['accent']}'>🛰️ [D] DISPLAY</span>")
            self.lbl_footer.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>[ TAB / C / S ] SWITCH TAB   [ ↑/↓ ] NAVIGATE   [ 1-6 / ENTER ] APPLY   [ ESC ] CLOSE</span>")

    def build_capture_tab(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        vbox.set_margin_top(10)
        vbox.set_margin_bottom(8)
        vbox.set_margin_left(16)
        vbox.set_margin_right(16)

        self.capture_tool_items = [
            {
                "key": "1",
                "title": "📸 AREA SCREENSHOT",
                "sub": "Select custom desktop rectangle (PrtScn) → ~/Pictures/prints",
                "action": "area_shot"
            },
            {
                "key": "2",
                "title": "🖥️ FULLSCREEN SCREENSHOT",
                "sub": "Capture entire display (Ctrl + PrtScn) → ~/Pictures/prints",
                "action": "full_shot"
            },
            {
                "key": "3",
                "title": "🎥 SCREEN VIDEO RECORDER",
                "sub": "Record video with audio/mic & keystroke toggles (Shift + PrtScn)",
                "action": "rec_menu"
            },
            {
                "key": "4",
                "title": "📁 OPEN PRINTS FOLDER",
                "sub": "View captured screenshots in ~/Pictures/prints",
                "action": "open_prints"
            },
            {
                "key": "5",
                "title": "📁 OPEN VIDEOS FOLDER",
                "sub": "View recorded screen videos in ~/Videos",
                "action": "open_videos"
            }
        ]

        self.capture_buttons = []
        for i, item in enumerate(self.capture_tool_items):
            btn = Gtk.EventBox()
            btn.get_style_context().add_class("tool-row")

            row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            btn.add(row_box)

            badge = Gtk.Label()
            badge.set_markup(f"<span font_weight='bold' font_size='10500' foreground='{self.pal['accent']}'>[{item['key']}]</span>")
            row_box.pack_start(badge, False, False, 0)

            text_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            row_box.pack_start(text_vbox, True, True, 0)

            t_lbl = Gtk.Label()
            t_lbl.set_markup(f"<span font_weight='bold' font_size='9500' foreground='{self.pal['text_main']}'>{item['title']}</span>")
            t_lbl.set_xalign(0.0)
            text_vbox.pack_start(t_lbl, False, False, 0)

            s_lbl = Gtk.Label()
            s_lbl.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>{item['sub']}</span>")
            s_lbl.set_xalign(0.0)
            text_vbox.pack_start(s_lbl, False, False, 0)

            btn.connect("button-press-event", lambda w, e, idx=i: self.trigger_capture_action(idx))
            self.capture_buttons.append(btn)
            vbox.pack_start(btn, False, False, 0)

        self.stack.add_named(vbox, "capture")

    def build_rec_view(self):
        rec_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        # Header
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.get_style_context().add_class("header-box")

        title = Gtk.Label()
        title.set_markup(f"<span font_weight='bold' font_size='11000' foreground='{self.pal['red']}'>🎥 MISSION RECORDER // CONFIGURATION</span>")
        title.set_xalign(0.0)
        header.pack_start(title, False, False, 0)

        sub = Gtk.Label()
        sub.set_markup(f"<span font_size='8500' foreground='{self.pal['text_dim']}'>CONFIGURE CAPTURE REGION, AUDIO FEEDS &amp; TRANSIENT OVERLAYS</span>")
        sub.set_xalign(0.0)
        header.pack_start(sub, False, False, 0)
        rec_vbox.pack_start(header, False, False, 0)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        body.set_margin_top(10)
        body.set_margin_bottom(10)
        body.set_margin_left(16)
        body.set_margin_right(16)

        self.rec_ctrl_items = []

        # 0: Mode Area
        self.btn_mode_area = Gtk.EventBox()
        self.btn_mode_area.get_style_context().add_class("toggle-btn")
        self.lbl_mode_area = Gtk.Label()
        self.btn_mode_area.add(self.lbl_mode_area)
        self.btn_mode_area.connect("button-press-event", lambda w, e: self.toggle_rec_mode("area"))
        body.pack_start(self.btn_mode_area, False, False, 0)
        self.rec_ctrl_items.append(self.btn_mode_area)

        # 1: Mode Fullscreen
        self.btn_mode_full = Gtk.EventBox()
        self.btn_mode_full.get_style_context().add_class("toggle-btn")
        self.lbl_mode_full = Gtk.Label()
        self.btn_mode_full.add(self.lbl_mode_full)
        self.btn_mode_full.connect("button-press-event", lambda w, e: self.toggle_rec_mode("full"))
        body.pack_start(self.btn_mode_full, False, False, 0)
        self.rec_ctrl_items.append(self.btn_mode_full)

        # 2: System Audio Toggle
        self.btn_sys_audio = Gtk.EventBox()
        self.btn_sys_audio.get_style_context().add_class("toggle-btn")
        self.lbl_sys_audio = Gtk.Label()
        self.btn_sys_audio.add(self.lbl_sys_audio)
        self.btn_sys_audio.connect("button-press-event", lambda w, e: self.toggle_opt("sys_audio"))
        body.pack_start(self.btn_sys_audio, False, False, 0)
        self.rec_ctrl_items.append(self.btn_sys_audio)

        # 3: Microphone Audio Toggle
        self.btn_mic_audio = Gtk.EventBox()
        self.btn_mic_audio.get_style_context().add_class("toggle-btn")
        self.lbl_mic_audio = Gtk.Label()
        self.btn_mic_audio.add(self.lbl_mic_audio)
        self.btn_mic_audio.connect("button-press-event", lambda w, e: self.toggle_opt("mic_audio"))
        body.pack_start(self.btn_mic_audio, False, False, 0)
        self.rec_ctrl_items.append(self.btn_mic_audio)

        # 4: Keystroke Overlay Toggle (Security strict: default OFF)
        self.btn_keys = Gtk.EventBox()
        self.btn_keys.get_style_context().add_class("toggle-btn")
        self.lbl_keys = Gtk.Label()
        self.btn_keys.add(self.lbl_keys)
        self.btn_keys.connect("button-press-event", lambda w, e: self.toggle_opt("keystrokes"))
        body.pack_start(self.btn_keys, False, False, 0)
        self.rec_ctrl_items.append(self.btn_keys)

        # Action Buttons Box
        act_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        act_box.set_homogeneous(True)
        act_box.set_margin_top(6)

        # 5: Start / Engage Button
        self.btn_engage = Gtk.EventBox()
        self.btn_engage.get_style_context().add_class("action-btn")
        self.btn_engage.get_style_context().add_class("engage")
        self.lbl_engage = Gtk.Label()
        self.btn_engage.add(self.lbl_engage)
        self.btn_engage.connect("button-press-event", lambda w, e: self.start_rec())
        act_box.pack_start(self.btn_engage, True, True, 0)
        self.rec_ctrl_items.append(self.btn_engage)

        # 6: Cancel / Back Button
        self.btn_back = Gtk.EventBox()
        self.btn_back.get_style_context().add_class("action-btn")
        self.lbl_back = Gtk.Label()
        self.btn_back.add(self.lbl_back)
        self.btn_back.connect("button-press-event", lambda w, e: self.switch_tab("capture"))
        act_box.pack_start(self.btn_back, True, True, 0)
        self.rec_ctrl_items.append(self.btn_back)

        body.pack_start(act_box, False, False, 0)
        rec_vbox.pack_start(body, True, True, 0)

        self.stack.add_named(rec_vbox, "rec")

    def build_system_tab(self):
