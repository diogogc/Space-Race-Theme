        scrollbar, scrollbar trough {{
            background-color: {t['bg_panel']};
            border: none;
        }}
        scrollbar slider {{
            background-color: {t['border_dim']};
            border-radius: 2px;
            min-width: 4px;
        }}
        scrollbar slider:hover {{
            background-color: {t['accent_dim']};
        }}
        """
        if not self.css_provider:
            self.css_provider = Gtk.CssProvider()
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(),
                self.css_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )
        self.css_provider.load_from_data(css.encode('utf-8'))

    def build_ui(self):
        self.set_name("main-window")
        
        chassis = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        chassis.set_name("chassis-frame")
        self.add(chassis)
        
        # --- 1. TOP HEADER & TELEMETRY REGISTERS ---
        top_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        top_box.get_style_context().add_class("top-panel")
        chassis.pack_start(top_box, False, False, 0)
        
        # Left header text
        v_title = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_head = Gtk.Label(label="APOLLO SUBSYSTEM // DEFAULT HANDLERS", xalign=0)
        lbl_head.get_style_context().add_class("title-header")
        lbl_sub = Gtk.Label(label="SYSTEM PROTOCOL & APPLICATION DISPATCH CONFIGURATION", xalign=0)
        lbl_sub.get_style_context().add_class("sub-header")
        v_title.pack_start(lbl_head, False, False, 0)
        v_title.pack_start(lbl_sub, False, False, 0)
        top_box.pack_start(v_title, True, True, 0)
        
        # Right digital registers
        reg_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        
        self.comp_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        self.comp_box.get_style_context().add_class("comp-tile")
        self.comp_box.get_style_context().add_class("active")
        self.lbl_comp = Gtk.Label(label="SYS OK")
        self.lbl_comp.set_valign(Gtk.Align.CENTER)
        self.comp_box.pack_start(self.lbl_comp, True, True, 2)
        reg_box.pack_start(self.comp_box, False, False, 0)
        
        # PROG
        p_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        p_box.get_style_context().add_class("digital-box")
        lbl_p_tag = Gtk.Label(label="PROG")
        lbl_p_tag.get_style_context().add_class("digital-lbl")
        self.lbl_prog_val = Gtk.Label(label="72")
        self.lbl_prog_val.get_style_context().add_class("digital-val")
        p_box.pack_start(lbl_p_tag, False, False, 0)
        p_box.pack_start(self.lbl_prog_val, False, False, 0)
        reg_box.pack_start(p_box, False, False, 0)
        
        # NOUN
        n_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        n_box.get_style_context().add_class("digital-box")
        lbl_n_tag = Gtk.Label(label="NOUN")
        lbl_n_tag.get_style_context().add_class("digital-lbl")
        self.lbl_noun_val = Gtk.Label(label="01")
        self.lbl_noun_val.get_style_context().add_class("digital-val")
        n_box.pack_start(lbl_n_tag, False, False, 0)
        n_box.pack_start(self.lbl_noun_val, False, False, 0)
        reg_box.pack_start(n_box, False, False, 0)
        
        top_box.pack_start(reg_box, False, False, 0)
        
        # --- 2. MAIN BODY (Split: Left Roles Menu, Right Role Configuration) ---
        main_hsplit = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        chassis.pack_start(main_hsplit, True, True, 0)
        
        # LEFT: Subsystem Roles List
        left_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        left_vbox.set_size_request(220, -1)
        main_hsplit.pack_start(left_vbox, False, False, 0)
        
        self.role_buttons = []
        for idx, role in enumerate(ROLES):
            btn = Gtk.Button(label=f"[{role['code']}] {role['title']}")
            btn.get_style_context().add_class("role-btn")
            btn.set_can_focus(False)
            btn.set_focus_on_click(False)
            if idx == 0:
                btn.get_style_context().add_class("active")
            btn.connect("clicked", self.on_role_button_clicked, idx)
            left_vbox.pack_start(btn, False, False, 0)
            self.role_buttons.append(btn)
            
        # RIGHT: Detail & Candidate Application Selection
        self.right_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.right_container.get_style_context().add_class("card-panel")
        main_hsplit.pack_start(self.right_container, True, True, 0)
        
        # --- 3. FOOTER TELEMETRY & CONTROLS ---
        footer_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        chassis.pack_start(footer_box, False, False, 0)
        
        self.status_banner = Gtk.Label(label="TELEMETRY STATUS: READY // SELECT SUBSYSTEM HANDLER", xalign=0)
        self.status_banner.get_style_context().add_class("status-banner")
        footer_box.pack_start(self.status_banner, True, True, 0)
        
        btn_close = Gtk.Button(label="[ESC] CLOSE")
        btn_close.get_style_context().add_class("action-btn")
        btn_close.set_can_focus(False)
        btn_close.connect("clicked", lambda b: self.close_manager())
        footer_box.pack_start(btn_close, False, False, 0)

    def on_role_button_clicked(self, btn, idx):
        self.load_role_view(idx)

    def load_role_view(self, role_idx):
        self.current_role_idx = role_idx
        role = ROLES[role_idx]
        self.lbl_noun_val.set_text(role["code"])
        
        for i, b in enumerate(self.role_buttons):
            if i == role_idx:
                b.get_style_context().add_class("active")
            else:
                b.get_style_context().remove_class("active")
                
        # Clear right container
        for child in self.right_container.get_children():
            self.right_container.remove(child)
            
        # 1. Header of selected role
        r_head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_r_title = Gtk.Label(label=f"SUBSYSTEM [{role['code']}]: {role['title']}", xalign=0)
        lbl_r_title.get_style_context().add_class("title-header")
        lbl_r_desc = Gtk.Label(label=role["desc"], xalign=0)
        lbl_r_desc.get_style_context().add_class("app-cmd-lbl")
        r_head.pack_start(lbl_r_title, False, False, 0)
        r_head.pack_start(lbl_r_desc, False, False, 0)
        self.right_container.pack_start(r_head, False, False, 0)
        
        # 2. Find Candidates for this role
        candidates = self.find_candidates_for_role(role)
        candidate_desktop_ids = {c["desktop_id"] for c in candidates}
        candidate_execs = {c["exec"] for c in candidates}
        
        # Determine Current Active Handler
        mime_defaults = read_mimeapps()
        hypr_vars = read_hyprland_vars()
        
        current_handler_id = None
        current_app_info = None
        
        if "is_hyprland_var" in role:
            var_val = hypr_vars.get(role["is_hyprland_var"], "")
            for c in candidates:
                if c["exec"] == var_val or var_val in c["exec"] or var_val in c["desktop_id"]:
                    current_handler_id = c["desktop_id"]
                    current_app_info = c
                    break
            if not current_app_info and var_val:
                current_handler_id = var_val
                current_app_info = {"name": var_val.capitalize(), "exec": var_val, "desktop_id": var_val}
        else:
            for m in role["mimes"]:
                if m in mime_defaults:
                    def_id = mime_defaults[m]
                    if def_id in candidate_desktop_ids:
                        for c in candidates:
                            if c["desktop_id"] == def_id:
                                current_handler_id = def_id
                                current_app_info = c
                                break
                    break
                    
        # If no explicit default was set yet, but candidates exist, consider the first one as active candidate
        if not current_app_info and candidates:
            current_app_info = candidates[0]
            current_handler_id = candidates[0]["desktop_id"]
            
        # Display Current Active Box
        curr_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        curr_box.get_style_context().add_class("app-item-box")
        if current_app_info:
            curr_box.get_style_context().add_class("selected")
        
        v_curr = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        h_tag = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        lbl_c_tag = Gtk.Label(label="ACTIVE HANDLER" if current_app_info else "UNCONFIGURED")
        lbl_c_tag.get_style_context().add_class("current-badge" if current_app_info else "unconfigured-badge")
        
        c_name = current_app_info["name"] if current_app_info else "NO COMPATIBLE APPLICATION CONFIGURED"
        lbl_c_name = Gtk.Label(label=c_name, xalign=0)
        lbl_c_name.get_style_context().add_class("app-name-lbl")
        h_tag.pack_start(lbl_c_tag, False, False, 0)
        h_tag.pack_start(lbl_c_name, False, False, 0)
        v_curr.pack_start(h_tag, False, False, 0)
        
        if current_app_info:
            c_exec = current_app_info.get("exec", "")
            lbl_c_cmd = Gtk.Label(label=f"BINARY/EXEC: {c_exec}", xalign=0)
        else:
            lbl_c_cmd = Gtk.Label(label="STATUS: NO APPLICATION REGISTERED FOR THIS PROTOCOL", xalign=0)
        lbl_c_cmd.get_style_context().add_class("app-cmd-lbl")
        v_curr.pack_start(lbl_c_cmd, False, False, 0)
        curr_box.pack_start(v_curr, True, True, 0)
        
        # Test button for current
        if current_app_info:
            btn_test = Gtk.Button(label="[TEST LAUNCH]")
            btn_test.get_style_context().add_class("action-btn")
            btn_test.set_can_focus(False)
            btn_test.connect("clicked", lambda b, cmd=current_app_info.get("exec", ""): self.test_launch_app(cmd))
            curr_box.pack_start(btn_test, False, False, 0)
            
        self.right_container.pack_start(curr_box, False, False, 0)
        
        # 3. List of Available Candidate Applications or Empty State
        lbl_cand_title = Gtk.Label(label="DETECTED COMPATIBLE APPLICATIONS", xalign=0)
        lbl_cand_title.get_style_context().add_class("title-header")
        lbl_cand_title.set_margin_top(4)
        self.right_container.pack_start(lbl_cand_title, False, False, 0)
        
        if not candidates:
            empty_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            empty_box.get_style_context().add_class("empty-state-box")
            lbl_warn = Gtk.Label(label="[!] NO COMPATIBLE APPLICATIONS DETECTED", xalign=0)
            lbl_warn.get_style_context().add_class("empty-warn-lbl")
            lbl_desc = Gtk.Label(
                label=f"No application package found for subsystem [{role['title']}].\nInstall a dedicated package (e.g. for Email: Thunderbird, Betterbird, or Geary) to register as default handler.",
                xalign=0
            )
            lbl_desc.get_style_context().add_class("empty-desc-lbl")
            empty_box.pack_start(lbl_warn, False, False, 0)
            empty_box.pack_start(lbl_desc, False, False, 0)
            self.right_container.pack_start(empty_box, True, True, 0)
        else:
            scroll = Gtk.ScrolledWindow()
            scroll.set_name("cand-scroll")
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroll.set_vexpand(True)
            self.right_container.pack_start(scroll, True, True, 0)
            
            cand_listbox = Gtk.ListBox()
            cand_listbox.set_name("cand-listbox")
            cand_listbox.get_style_context().add_class("cand-listbox")
            cand_listbox.set_selection_mode(Gtk.SelectionMode.NONE)
            scroll.add(cand_listbox)
            
            for cand in candidates:
                c_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                c_box.get_style_context().add_class("app-item-box")
                
                is_active = (current_handler_id == cand["desktop_id"]) or (current_app_info and current_app_info["exec"] == cand["exec"])
                if is_active:
                    c_box.get_style_context().add_class("selected")
                    
                v_cand = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
                lbl_name = Gtk.Label(label=cand["name"], xalign=0)
                lbl_name.get_style_context().add_class("app-name-lbl")
                lbl_cmd = Gtk.Label(label=f"{cand['exec']}", xalign=0)
                lbl_cmd.get_style_context().add_class("app-cmd-lbl")
                v_cand.pack_start(lbl_name, False, False, 0)
                v_cand.pack_start(lbl_cmd, False, False, 0)
                c_box.pack_start(v_cand, True, True, 0)
                
                btn_set = Gtk.Button(label="[ACTIVE]" if is_active else "[SET DEFAULT]")
                btn_set.get_style_context().add_class("action-btn")
                if not is_active:
                    btn_set.get_style_context().add_class("primary")
                btn_set.set_can_focus(False)
                btn_set.connect("clicked", self.on_set_default_clicked, role, cand)
                c_box.pack_start(btn_set, False, False, 0)
                
                cand_listbox.add(c_box)
            
        self.right_container.show_all()

    def find_candidates_for_role(self, role):
        candidates = []
        seen_names = set()
        role_id = role["id"]
        filter_rule = ROLE_FILTERS.get(role_id, {})
        
        # Match from scanned desktop apps
        for aid, ainfo in self.all_apps.items():
            matched = False
            
            # Match against exact categories
            low_cats = [c.lower() for c in ainfo["categories"]]
            if filter_rule.get("cats") and any(c in low_cats for c in filter_rule["cats"]):
                matched = True
                    
            # Match against regex
            if not matched and filter_rule.get("regex"):
                search_str = f"{ainfo['name']} {ainfo['exec']} {ainfo['generic']}".lower()
                if re.search(filter_rule["regex"], search_str):
                    matched = True
                    
            # Apply exclusion filter
            if matched and filter_rule.get("exclude"):
                search_str = f"{ainfo['name']} {ainfo['exec']} {ainfo['generic']} {' '.join(ainfo['categories'])}".lower()
                if re.search(filter_rule["exclude"], search_str):
                    matched = False
                    
            if matched and ainfo["name"] not in seen_names:
                seen_names.add(ainfo["name"])
                candidates.append(ainfo)
                
        candidates.sort(key=lambda x: x["name"].lower())
        return candidates

    def on_set_default_clicked(self, btn, role, cand):
        # 1. Update Hyprland configuration if applicable
        if "is_hyprland_var" in role:
            var_name = role["is_hyprland_var"]
            clean_cmd = cand["exec"].split()[0]
            set_hyprland_var(var_name, clean_cmd)
            
        # 2. Update XDG Mime defaults
        set_mime_defaults(cand["desktop_id"], role["mimes"])
        
        # 3. Update status banner
        self.status_banner.set_text(f"UPDATED [{role['title']}]: ACTIVE HANDLER -> {cand['name'].upper()} ({cand['desktop_id']})")
        
        # 4. Refresh view
        self.load_role_view(self.current_role_idx)

    def test_launch_app(self, exec_cmd):
        if not exec_cmd:
            return
        cmd = re.sub(r"%[a-zA-Z]", "", exec_cmd).strip()
        try:
            subprocess.Popen(cmd, shell=True, start_new_session=True)
            self.status_banner.set_text(f"TEST LAUNCH INITIATED: {cmd}")
        except Exception as e:
            self.status_banner.set_text(f"LAUNCH ERROR: {e}")

    def on_key_press(self, widget, event):
        keyval = event.keyval
        if keyval == Gdk.KEY_Escape:
            self.close_manager()
            return True
        elif keyval in (Gdk.KEY_Up, Gdk.KEY_KP_Up):
            prev_idx = (self.current_role_idx - 1 + len(ROLES)) % len(ROLES)
            self.load_role_view(prev_idx)
            return True
        elif keyval in (Gdk.KEY_Down, Gdk.KEY_KP_Down, Gdk.KEY_Tab):
            next_idx = (self.current_role_idx + 1) % len(ROLES)
            self.load_role_view(next_idx)
            return True
        return False

    def close_manager(self):
        Gtk.main_quit()
        self.destroy()

if __name__ == "__main__":
    app = DefaultAppsManager()
    app.show_all()
    Gtk.main()
