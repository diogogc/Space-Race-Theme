def get_current_theme():
    theme_file = os.path.expanduser("~/.config/themes/current_theme")
    if os.path.isfile(theme_file):
        try:
            with open(theme_file, "r") as f:
                theme = f.read().strip()
                if theme in THEMES:
                    return theme
        except Exception:
            pass
    return "nasa"

def scan_all_desktop_apps():
    search_dirs = [
        "/usr/share/applications",
        os.path.expanduser("~/.local/share/applications"),
        "/var/lib/flatpak/exports/share/applications",
        os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
    ]
    apps = {}
    for d in search_dirs:
        if not os.path.isdir(d):
            continue
        for root, _, files in os.walk(d):
            for file in files:
                if not file.endswith(".desktop"):
                    continue
                path = os.path.join(root, file)
                cp = configparser.RawConfigParser(strict=False)
                try:
                    cp.read(path, encoding="utf-8")
                    if not cp.has_section("Desktop Entry"):
                        continue
                    if cp.getboolean("Desktop Entry", "NoDisplay", fallback=False):
                        continue
                    if cp.getboolean("Desktop Entry", "Hidden", fallback=False):
                        continue
                    name = cp.get("Desktop Entry", "Name", fallback=None)
                    exec_cmd = cp.get("Desktop Entry", "Exec", fallback=None)
                    if not name or not exec_cmd:
                        continue
                    
                    clean_exec = re.sub(r"%[a-zA-Z]", "", exec_cmd).strip()
                    cats = [c.strip() for c in cp.get("Desktop Entry", "Categories", fallback="").split(";") if c.strip()]
                    mimes = [m.strip() for m in cp.get("Desktop Entry", "MimeType", fallback="").split(";") if m.strip()]
                    generic = cp.get("Desktop Entry", "GenericName", fallback="")
                    comment = cp.get("Desktop Entry", "Comment", fallback="")
                    
                    bname = file
                    apps[bname] = {
                        "desktop_id": bname,
                        "name": name,
                        "exec": clean_exec,
                        "raw_exec": exec_cmd,
                        "generic": generic,
                        "comment": comment,
                        "categories": cats,
                        "mimes": mimes,
                        "path": path,
                    }
                except Exception:
                    continue
    return apps

def read_mimeapps():
    defaults = {}
    if os.path.isfile(MIMEAPPS_FILE):
        cp = configparser.RawConfigParser(strict=False)
        try:
            cp.read(MIMEAPPS_FILE, encoding="utf-8")
            if cp.has_section("Default Applications"):
                for k, v in cp.items("Default Applications"):
                    defaults[k.strip().lower()] = v.split(";")[0].strip()
        except Exception:
            pass
    return defaults

def read_hyprland_vars():
    vars_dict = {"terminal": "kitty", "fileManager": "dolphin"}
    if os.path.isfile(HYPRLAND_LUA):
        try:
            with open(HYPRLAND_LUA, "r", encoding="utf-8") as f:
                content = f.read()
            m_term = re.search(r'local\s+terminal\s*=\s*"([^"]+)"', content)
            if m_term:
                vars_dict["terminal"] = m_term.group(1).strip()
            m_fm = re.search(r'local\s+fileManager\s*=\s*"([^"]+)"', content)
            if m_fm:
                vars_dict["fileManager"] = m_fm.group(1).strip()
        except Exception:
            pass
    elif os.path.isfile(HYPRLAND_CONF):
        try:
            with open(HYPRLAND_CONF, "r", encoding="utf-8") as f:
                content = f.read()
            m_term = re.search(r'\$terminal\s*=\s*([^\n#]+)', content)
            if m_term:
                vars_dict["terminal"] = m_term.group(1).strip()
            m_fm = re.search(r'\$fileManager\s*=\s*([^\n#]+)', content)
            if m_fm:
                vars_dict["fileManager"] = m_fm.group(1).strip()
        except Exception:
            pass
    return vars_dict

def set_hyprland_var(var_name, new_val):
    # Update Lua config if present
    if os.path.isfile(HYPRLAND_LUA):
        try:
            with open(HYPRLAND_LUA, "r", encoding="utf-8") as f:
                content = f.read()
            pattern = rf'(local\s+{var_name}\s*=\s*)"[^"]+"'
            new_content = re.sub(pattern, rf'\1"{new_val}"', content)
            with open(HYPRLAND_LUA, "w", encoding="utf-8") as f:
                f.write(new_content)
        except Exception as e:
            print(f"Error updating Hyprland Lua variable {var_name}: {e}", file=sys.stderr)

    # Update Conf config if present
    if os.path.isfile(HYPRLAND_CONF):
        try:
            with open(HYPRLAND_CONF, "r", encoding="utf-8") as f:
                content = f.read()
            pattern = rf'(\${var_name}\s*=\s*)[^\n#]+'
            new_content = re.sub(pattern, rf'\1{new_val}', content)
            with open(HYPRLAND_CONF, "w", encoding="utf-8") as f:
                f.write(new_content)
        except Exception as e:
            print(f"Error updating Hyprland Conf variable {var_name}: {e}", file=sys.stderr)

def set_mime_defaults(desktop_id, mime_list):
    os.makedirs(os.path.dirname(MIMEAPPS_FILE), exist_ok=True)
    cp = configparser.RawConfigParser(strict=False)
    if os.path.isfile(MIMEAPPS_FILE):
        try:
            cp.read(MIMEAPPS_FILE, encoding="utf-8")
        except Exception:
            pass
    
    if not cp.has_section("Default Applications"):
        cp.add_section("Default Applications")
    if not cp.has_section("Added Associations"):
        cp.add_section("Added Associations")
        
    for m in mime_list:
        cp.set("Default Applications", m, desktop_id)
        # Also run xdg-mime in background
        try:
            subprocess.Popen(["xdg-mime", "default", desktop_id, m], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
            
    with open(MIMEAPPS_FILE, "w", encoding="utf-8") as f:
        cp.write(f)

class DefaultAppsManager(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.theme_name = get_current_theme()
        self.t = THEMES[self.theme_name]
        self.all_apps = scan_all_desktop_apps()
        self.current_role_idx = 0
        self.css_provider = None
        self.comp_acty_state = True
        
        self.set_title("Apollo Default Applications Manager")
        self.set_default_size(760, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_resizable(False)
        
        self.apply_css()
        self.build_ui()
        self.connect("key-press-event", self.on_key_press)
        
        if HAVE_GLIB_UNIX:
            GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.on_sigusr1)
        else:
            try:
                GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.on_sigusr1)
            except Exception:
                pass
        
        GLib.timeout_add(500, self.on_blink_comp_acty)
        self.load_role_view(0)

    def on_blink_comp_acty(self):
        self.comp_acty_state = not self.comp_acty_state
        if hasattr(self, 'comp_box') and self.comp_box:
            if self.comp_acty_state:
                self.comp_box.get_style_context().add_class("active")
            else:
                self.comp_box.get_style_context().remove_class("active")
        return True

    def on_sigusr1(self):
        self.theme_name = get_current_theme()
        self.t = THEMES[self.theme_name]
        self.apply_css()
        self.load_role_view(self.current_role_idx)
        return True

