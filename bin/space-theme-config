        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER
        )

    def build_ui(self):
        root_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root_vbox)

        # 1. Header Box
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.get_style_context().add_class("header-box")

        title = Gtk.Label()
        title.set_markup(f"<span font_weight='bold' font_size='11000' foreground='{self.pal['text_main']}'>🛸 APOLLO THEME &amp; VISUAL AVIONICS CONFIGURATOR</span>")
        title.set_xalign(0.0)
        header.pack_start(title, False, False, 0)

        utc_str = time.strftime('%H:%M:%S UTC', time.gmtime())
        sub = Gtk.Label()
        sub.set_markup(f"<span font_size='8500' foreground='{self.pal['green']}'>[ ACTIVE: {self.current_theme.upper()} ]</span> <span font_size='8500' foreground='{self.pal['text_dim']}'>| UTC: {utc_str}</span>")
        sub.set_xalign(0.0)
        header.pack_start(sub, False, False, 0)
        root_vbox.pack_start(header, False, False, 0)

        # 2. Navigation Tab Bar (5 Tabs)
        tab_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        tab_bar.get_style_context().add_class("tab-bar")

        # Tab 1: Themes
        self.tab_theme = Gtk.EventBox()
        self.tab_theme.get_style_context().add_class("nav-tab")
        self.lbl_tab_theme = Gtk.Label()
        self.tab_theme.add(self.lbl_tab_theme)
        self.tab_theme.connect("button-press-event", lambda w, e: self.switch_tab("theme"))
        tab_bar.pack_start(self.tab_theme, False, False, 0)

        # Tab 2: Wallpapers
        self.tab_wallpaper = Gtk.EventBox()
        self.tab_wallpaper.get_style_context().add_class("nav-tab")
        self.lbl_tab_wallpaper = Gtk.Label()
        self.tab_wallpaper.add(self.lbl_tab_wallpaper)
        self.tab_wallpaper.connect("button-press-event", lambda w, e: self.switch_tab("wallpaper"))
        tab_bar.pack_start(self.tab_wallpaper, False, False, 0)

        # Tab 3: Screensaver & Idle
        self.tab_screensaver = Gtk.EventBox()
        self.tab_screensaver.get_style_context().add_class("nav-tab")
        self.lbl_tab_screensaver = Gtk.Label()
        self.tab_screensaver.add(self.lbl_tab_screensaver)
        self.tab_screensaver.connect("button-press-event", lambda w, e: self.switch_tab("screensaver"))
        tab_bar.pack_start(self.tab_screensaver, False, False, 0)

        # Tab 4: Waybar Modules
        self.tab_modules = Gtk.EventBox()
        self.tab_modules.get_style_context().add_class("nav-tab")
        self.lbl_tab_modules = Gtk.Label()
        self.tab_modules.add(self.lbl_tab_modules)
        self.tab_modules.connect("button-press-event", lambda w, e: self.switch_tab("modules"))
        tab_bar.pack_start(self.tab_modules, False, False, 0)

        # Tab 5: Plugins & Subsystems
        self.tab_plugins = Gtk.EventBox()
        self.tab_plugins.get_style_context().add_class("nav-tab")
        self.lbl_tab_plugins = Gtk.Label()
        self.tab_plugins.add(self.lbl_tab_plugins)
        self.tab_plugins.connect("button-press-event", lambda w, e: self.switch_tab("plugins"))
        tab_bar.pack_start(self.tab_plugins, False, False, 0)

        root_vbox.pack_start(tab_bar, False, False, 0)

        # 3. Main Stack Container
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)
        root_vbox.pack_start(self.stack, True, True, 0)

        # Build Tab Pages
        self.build_theme_tab()
        self.build_wallpaper_tab()
        self.build_screensaver_tab()
        self.build_modules_tab()
        self.build_plugins_tab()

        # 4. Footer Hint & Status Toast
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        footer.set_margin_top(4)
        footer.set_margin_bottom(8)
        footer.set_margin_start(16)
        footer.set_margin_end(16)

        self.lbl_footer = Gtk.Label()
        self.lbl_footer.set_xalign(0.5)
        footer.pack_start(self.lbl_footer, True, True, 0)
        root_vbox.pack_start(footer, False, False, 0)

        self.update_tab_headers()

    def show_toast(self, msg):
        if self.toast_timeout_id:
            GLib.source_remove(self.toast_timeout_id)
        self.lbl_footer.set_markup(f"<span font_weight='bold' foreground='{self.pal['cyan']}'>🚀 {GLib.markup_escape_text(msg)}</span>")
        self.toast_timeout_id = GLib.timeout_add_seconds(3, self.reset_footer_hint)

    def reset_footer_hint(self):
        self.toast_timeout_id = None
        self.update_tab_headers()
        return False

    def update_tab_headers(self):
        self.tab_theme.get_style_context().remove_class("active")
        self.tab_wallpaper.get_style_context().remove_class("active")
        self.tab_screensaver.get_style_context().remove_class("active")
        self.tab_modules.get_style_context().remove_class("active")
        self.tab_plugins.get_style_context().remove_class("active")

        if self.active_tab == "theme":
            self.tab_theme.get_style_context().add_class("active")
            self.lbl_tab_theme.set_markup(f"<span font_weight='bold' foreground='{self.pal['accent']}'>🎨 [T] THEMES</span>")
            self.lbl_tab_wallpaper.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>🌌 [W] WALLPAPERS</span>")
            self.lbl_tab_screensaver.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>🛸 [S] SCREENSAVER</span>")
            self.lbl_tab_modules.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>📊 [M] TOOLBAR</span>")
            self.lbl_tab_plugins.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>📦 [P] PLUGINS</span>")
            self.lbl_footer.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>[ TAB / W / S / M / P ] SWITCH TAB   [ ↑/↓ ] NAVIGATE   [ 1-4 / ENTER ] APPLY THEME   [ ESC ] CLOSE</span>")
        elif self.active_tab == "wallpaper":
            self.tab_wallpaper.get_style_context().add_class("active")
            self.lbl_tab_theme.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>🎨 [T] THEMES</span>")
            self.lbl_tab_wallpaper.set_markup(f"<span font_weight='bold' foreground='{self.pal['accent']}'>🌌 [W] WALLPAPERS</span>")
            self.lbl_tab_screensaver.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>🛸 [S] SCREENSAVER</span>")
            self.lbl_tab_modules.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>📊 [M] TOOLBAR</span>")
            self.lbl_tab_plugins.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>📦 [P] PLUGINS</span>")
            self.lbl_footer.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>[ TAB / T / S / M / P ] SWITCH TAB   [ ↑/↓ ] NAVIGATE   [ ENTER ] SET WALLPAPER   [ C ] CYCLE   [ ESC ] CLOSE</span>")
        elif self.active_tab == "screensaver":
            self.tab_screensaver.get_style_context().add_class("active")
            self.lbl_tab_theme.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>🎨 [T] THEMES</span>")
