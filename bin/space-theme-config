THEMES_DIR = Path(os.path.expanduser("~/.config/themes"))
CURRENT_THEME_FILE = THEMES_DIR / "current_theme"
WAYBAR_CONFIG = Path(os.path.expanduser("~/.config/waybar/config.jsonc"))

