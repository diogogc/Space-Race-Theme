    def build_theme_tab(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        vbox.set_margin_top(12)
        vbox.set_margin_bottom(12)
        vbox.set_margin_start(16)
        vbox.set_margin_end(16)

        grid = Gtk.Grid()
        grid.set_column_spacing(10)
        grid.set_row_spacing(10)
        grid.set_column_homogeneous(True)
        grid.set_row_homogeneous(True)
        vbox.pack_start(grid, True, True, 0)

        self.theme_items = [
            {"id": "nasa", "key": "1", "name": "NASA APOLLO MOCR", "sub": "Apollo 11 Deep Navy &amp; Amber CRT Avionics", "pal": THEMES["nasa"]},
            {"id": "crt-amber", "key": "2", "name": "CRT AMBER PHOSPHOR", "sub": "IBM Mainframe 590nm Amber Monochromatic", "pal": THEMES["crt-amber"]},
            {"id": "crt-green", "key": "3", "name": "CRT GREEN TERMINAL", "sub": "DEC VT100 525nm Telemetry Vector Phosphor", "pal": THEMES["crt-green"]},
            {"id": "kosmos-vfd", "key": "4", "name": "KOSMOS VFD CYAN", "sub": "Soviet Soyuz Vacuum Fluorescent Display", "pal": THEMES["kosmos-vfd"]}
        ]

        self.theme_cards = []
        for i, item in enumerate(self.theme_items):
            btn = Gtk.EventBox()
            btn.get_style_context().add_class("tool-row")
            if item["id"] == self.current_theme:
                btn.get_style_context().add_class("active-theme")

            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            btn.add(card)

            # Swatch row
            swatch_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            for c_key in ["bg", "bg_card", "border", "accent", "green"]:
                col = item["pal"][c_key]
                s = Gtk.DrawingArea()
                s.set_size_request(16, 8)
                def make_draw_cb(color_hex):
                    def _draw(w, cr):
                        rgba = Gdk.RGBA()
                        if rgba.parse(color_hex):
                            Gdk.cairo_set_source_rgba(cr, rgba)
                            cr.rectangle(0, 0, 16, 8)
                            cr.fill()
                        return False
                    return _draw
                s.connect("draw", make_draw_cb(col))
                swatch_box.pack_start(s, False, False, 0)
            card.pack_start(swatch_box, False, False, 0)

            t_lbl = Gtk.Label()
            t_lbl.set_markup(f"<span font_weight='bold' font_size='9000' foreground='{item['pal']['accent']}'>[{item['key']}] {item['name']}</span>")
            t_lbl.set_xalign(0.0)
            card.pack_start(t_lbl, False, False, 0)

            s_lbl = Gtk.Label()
            s_lbl.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>{item['sub']}</span>")
            s_lbl.set_xalign(0.0)
            card.pack_start(s_lbl, False, False, 0)

            if item["id"] == self.current_theme:
                act = Gtk.Label()
                act.set_markup(f"<span font_size='7500' foreground='{self.pal['green']}'>[ ACTIVE MISSION PROFILE ]</span>")
                act.set_xalign(0.0)
                card.pack_start(act, False, False, 0)

            btn.connect("button-press-event", lambda w, e, idx=i: self.apply_theme_choice(idx))
            self.theme_cards.append(btn)
            grid.attach(btn, i % 2, i // 2, 1, 1)

        self.stack.add_named(vbox, "theme")

    def build_wallpaper_tab(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        vbox.set_margin_top(8)
        vbox.set_margin_bottom(8)
        vbox.set_margin_start(16)
        vbox.set_margin_end(16)

        # Header card with cycler action
