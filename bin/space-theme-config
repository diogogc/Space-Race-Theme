    def populate_screensaver_rows(self):
        for child in self.ss_container.get_children():
            self.ss_container.remove(child)

        self.ss_rows = []

        # Row 1: Timeout
        r1 = Gtk.EventBox()
        r1.get_style_context().add_class("tool-row")
        b1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        r1.add(b1)

        t_lbl = Gtk.Label()
        t_lbl.set_markup(f"<span font_weight='bold' font_size='8500' foreground='{self.pal['text_main']}'>[1] Idle Screensaver Timeout</span>")
        t_lbl.set_xalign(0.0)
        b1.pack_start(t_lbl, True, True, 0)

        cur_to = self.ss_cfg.get("timeout_minutes", 5)
        to_str = f"{cur_to} min" if cur_to > 0 else "DISABLED"
        val_lbl = Gtk.Label()
        val_lbl.set_markup(f"<span font_weight='bold' font_size='8500' foreground='{self.pal['accent']}'>[ {to_str} ]</span>")
        b1.pack_start(val_lbl, False, False, 0)

        r1.connect("button-press-event", lambda w, e: self.cycle_ss_timeout())
        self.ss_rows.append(r1)
        self.ss_container.pack_start(r1, False, False, 0)

        # Row 2: Lock on Wake
        r2 = Gtk.EventBox()
        r2.get_style_context().add_class("tool-row")
        b2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        r2.add(b2)

        l_lbl = Gtk.Label()
        l_lbl.set_markup(f"<span font_weight='bold' font_size='8500' foreground='{self.pal['text_main']}'>[2] Require Lockscreen (Hyprlock) on Wake</span>")
        l_lbl.set_xalign(0.0)
        b2.pack_start(l_lbl, True, True, 0)

        is_lock = self.ss_cfg.get("lock_on_wake", False)
        lock_col = self.pal['green'] if is_lock else self.pal['text_dim']
        lock_val = "[✔ ENABLED]" if is_lock else "[   DISABLED]"
        lval_lbl = Gtk.Label()
        lval_lbl.set_markup(f"<span font_weight='bold' font_size='8500' foreground='{lock_col}'>{lock_val}</span>")
        b2.pack_start(lval_lbl, False, False, 0)

        r2.connect("button-press-event", lambda w, e: self.toggle_ss_lock())
        self.ss_rows.append(r2)
        self.ss_container.pack_start(r2, False, False, 0)

        # Section Label: Scene Select
        sec_lbl = Gtk.Label()
        sec_lbl.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>MISSION SCENE PRESETS:</span>")
        sec_lbl.set_xalign(0.0)
        sec_lbl.set_margin_top(4)
        self.ss_container.pack_start(sec_lbl, False, False, 0)

        cur_scene = self.ss_cfg.get("scene_mode", "all")
        for i, (sc_id, sc_name) in enumerate(SCENE_PRESETS):
            sr = Gtk.EventBox()
            sr.get_style_context().add_class("tool-row")
            is_sc = (cur_scene == sc_id)
            if is_sc:
                sr.get_style_context().add_class("active-theme")

            sb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            sr.add(sb)

            chk = Gtk.Label()
            chk.set_markup(f"<span foreground='{self.pal['green'] if is_sc else self.pal['text_dim']}'>{'[✔]' if is_sc else '[ ]'}</span>")
            sb.pack_start(chk, False, False, 0)

            s_name = Gtk.Label()
            s_name.set_markup(f"<span font_weight='bold' font_size='8500' foreground='{self.pal['text_main']}'>{sc_name}</span>")
            s_name.set_xalign(0.0)
            sb.pack_start(s_name, True, True, 0)

            sr.connect("button-press-event", lambda w, e, sid=sc_id: self.set_ss_scene(sid))
            self.ss_rows.append(sr)
            self.ss_container.pack_start(sr, False, False, 0)

        self.ss_container.show_all()

    def cycle_ss_timeout(self):
        cur = self.ss_cfg.get("timeout_minutes", 5)
        idx = 0
        for i, (val, _) in enumerate(TIMEOUT_PRESETS):
            if val == cur:
                idx = i
                break
        next_idx = (idx + 1) % len(TIMEOUT_PRESETS)
        self.ss_cfg["timeout_minutes"] = TIMEOUT_PRESETS[next_idx][0]
        save_screensaver_config(self.ss_cfg)
        self.populate_screensaver_rows()
        self.refresh_screensaver_ui()

    def toggle_ss_lock(self):
        self.ss_cfg["lock_on_wake"] = not self.ss_cfg.get("lock_on_wake", False)
        save_screensaver_config(self.ss_cfg)
        self.populate_screensaver_rows()
        self.refresh_screensaver_ui()

    def set_ss_scene(self, scene_id):
        self.ss_cfg["scene_mode"] = scene_id
        save_screensaver_config(self.ss_cfg)
        self.populate_screensaver_rows()
        self.refresh_screensaver_ui()

    def preview_screensaver(self):
        subprocess.Popen(["space-screensaver"], start_new_session=True)

