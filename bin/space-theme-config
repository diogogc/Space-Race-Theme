        # Scrollable Plugin Container
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        vbox.pack_start(scroll, True, True, 0)

        self.plugin_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        scroll.add(self.plugin_container)

        self.populate_plugin_rows()
        self.stack.add_named(vbox, "plugins")

    def populate_plugin_rows(self):
        for child in self.plugin_container.get_children():
            self.plugin_container.remove(child)

        self.plugin_rows = []

        for i, plugin in enumerate(ALL_THEME_PLUGINS):
            btn = Gtk.EventBox()
            btn.get_style_context().add_class("tool-row")

            row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            btn.add(row_box)

            is_inst = self.is_plugin_installed(plugin)

            # Status Badge
            badge = Gtk.Label()
            if is_inst:
                badge.set_markup(f"<span font_weight='bold' font_size='8500' foreground='{self.pal['green']}'>[✔ INSTALLED]</span>")
            else:
                badge.set_markup(f"<span font_weight='bold' font_size='8500' foreground='{self.pal['text_dim']}'>[✖ NOT INST]</span>")
            badge.set_size_request(110, -1)
            badge.set_xalign(0.0)
            row_box.pack_start(badge, False, False, 0)

            # Details
            details_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            name_lbl = Gtk.Label()
            p_cat = f"<span font_size='7500' foreground='{self.pal['cyan']}'>[{plugin['category']}]</span>"
            name_lbl.set_markup(f"<span font_weight='bold' font_size='8500' foreground='{self.pal['text_main']}'>[{i+1}] {GLib.markup_escape_text(plugin['name'])}</span> {p_cat}")
            name_lbl.set_xalign(0.0)
            details_box.pack_start(name_lbl, False, False, 0)

            desc_lbl = Gtk.Label()
            bin_list = ", ".join(plugin["bins"])
            desc_lbl.set_markup(f"<span font_size='7500' foreground='{self.pal['text_dim']}'>{GLib.markup_escape_text(plugin['desc'])} ({bin_list})</span>")
            desc_lbl.set_xalign(0.0)
            details_box.pack_start(desc_lbl, False, False, 0)

            row_box.pack_start(details_box, True, True, 0)

            # Action Button
            action_btn = Gtk.Button()
            action_btn.get_style_context().add_class("plugin-action-btn")
            if is_inst:
                action_btn.set_label("🗑 Remove")
                action_btn.get_style_context().add_class("btn-remove")
            else:
                action_btn.set_label("📥 Install")
                action_btn.get_style_context().add_class("btn-install")
            action_btn.connect("clicked", lambda w, idx=i: self.toggle_plugin(idx))
            row_box.pack_start(action_btn, False, False, 0)

            btn.connect("button-press-event", lambda w, e, idx=i: self.toggle_plugin(idx))
            self.plugin_rows.append(btn)
            self.plugin_container.pack_start(btn, False, False, 0)

        self.plugin_container.show_all()

    def toggle_plugin(self, idx):
        plugin = ALL_THEME_PLUGINS[idx]
        BIN_DIR.mkdir(parents=True, exist_ok=True)

        is_inst = self.is_plugin_installed(plugin)
        if is_inst:
            # Remove all binaries for this plugin
            for b in plugin["bins"]:
                p = BIN_DIR / b
                if p.exists() or p.is_symlink():
                    try:
                        p.unlink()
                    except Exception as e:
                        print(f"Error unlinking {p}: {e}", file=sys.stderr)
            self.show_toast(f"Removed plugin: {plugin['name']}")
        else:
            # Install all binaries for this plugin
            src_file = THEME_BIN_DIR / plugin["src"]
            if not src_file.exists() and (EECOM_BIN_DIR / plugin["src"]).exists():
                src_file = EECOM_BIN_DIR / plugin["src"]
            elif not src_file.exists() and (EECOM_BIN_DIR / "eecom").exists() and plugin["id"] == "eecom":
                src_file = EECOM_BIN_DIR / "eecom"

            if src_file.exists():
                for b in plugin["bins"]:
                    dest = BIN_DIR / b
                    if dest.exists() or dest.is_symlink():
                        try:
                            dest.unlink()
                        except Exception:
                            pass
                    try:
                        dest.symlink_to(src_file)
                    except Exception as e:
                        print(f"Error linking {dest} -> {src_file}: {e}", file=sys.stderr)
                self.show_toast(f"Installed plugin: {plugin['name']}")
            else:
                self.show_toast(f"Error: Source executable not found for {plugin['name']}")

        self.populate_plugin_rows()
        self.refresh_plugins_ui()

    def sync_all_plugins(self):
        subprocess.Popen(["space-update"], start_new_session=True)
        self.show_toast("Syncing theme & plugins via space-update...")
        GLib.timeout_add(1500, self.populate_plugin_rows)

    def switch_tab(self, tab_name):
        self.active_tab = tab_name
        self.update_tab_headers()

        if tab_name == "theme":
            self.refresh_theme_ui()
            self.stack.set_visible_child_name("theme")
        elif tab_name == "wallpaper":
            self.populate_wallpaper_rows()
            self.refresh_wallpaper_ui()
            self.stack.set_visible_child_name("wallpaper")
        elif tab_name == "screensaver":
            self.populate_screensaver_rows()
            self.refresh_screensaver_ui()
            self.stack.set_visible_child_name("screensaver")
        elif tab_name == "modules":
            self.populate_module_rows()
            self.refresh_modules_ui()
            self.stack.set_visible_child_name("modules")
        elif tab_name == "plugins":
            self.populate_plugin_rows()
            self.refresh_plugins_ui()
            self.stack.set_visible_child_name("plugins")

    def refresh_theme_ui(self):
        for i, btn in enumerate(self.theme_cards):
            ctx = btn.get_style_context()
            if i == self.theme_selected_idx:
                ctx.add_class("selected")
            else:
                ctx.remove_class("selected")

    def refresh_wallpaper_ui(self):
        for i, btn in enumerate(self.wp_rows):
            ctx = btn.get_style_context()
            if i == self.wp_selected_idx:
                ctx.add_class("selected")
            else:
                ctx.remove_class("selected")

    def refresh_screensaver_ui(self):
        for i, btn in enumerate(self.ss_rows):
            ctx = btn.get_style_context()
            if i == self.ss_selected_idx:
                ctx.add_class("selected")
            else:
                ctx.remove_class("selected")

    def refresh_modules_ui(self):
        for i, btn in enumerate(self.mod_rows):
            ctx = btn.get_style_context()
            if i == self.mod_selected_idx:
                ctx.add_class("selected")
            else:
                ctx.remove_class("selected")

    def refresh_plugins_ui(self):
        for i, btn in enumerate(self.plugin_rows):
            ctx = btn.get_style_context()
            if i == self.plugin_selected_idx:
                ctx.add_class("selected")
            else:
                ctx.remove_class("selected")

    def apply_theme_choice(self, idx):
        item = self.theme_items[idx]
        theme_id = item["id"]
        self.hide()
        cleanup()
        subprocess.Popen(["space-theme-switch", theme_id], start_new_session=True)
        Gtk.main_quit()

    def set_wallpaper_choice(self, idx):
        if 0 <= idx < len(self.wp_file_paths):
            path_str = self.wp_file_paths[idx]
            subprocess.Popen(["space-wallpaper", "set", path_str], start_new_session=True)
            GLib.timeout_add(150, self.populate_wallpaper_rows)

    def cycle_wallpaper_now(self):
        subprocess.Popen(["space-wallpaper", "next"], start_new_session=True)
        GLib.timeout_add(150, self.populate_wallpaper_rows)

    def on_key_press(self, widget, event):
        keyname = Gdk.keyval_name(event.keyval)

        if keyname in ["Escape", "q", "Q"]:
            cleanup()
            Gtk.main_quit()
            return True

        if keyname in ["t", "T"]:
            self.switch_tab("theme")
            return True
        if keyname in ["w", "W"]:
            self.switch_tab("wallpaper")
            return True
        if keyname in ["s", "S"]:
            self.switch_tab("screensaver")
            return True
        if keyname in ["m", "M"]:
            self.switch_tab("modules")
            return True
        if keyname in ["p", "P"]:
            self.switch_tab("plugins")
            return True

        if self.active_tab == "theme":
            if keyname in ["Down", "j", "J"]:
                self.theme_selected_idx = (self.theme_selected_idx + 1) % len(self.theme_items)
                self.refresh_theme_ui()
                return True
            if keyname in ["Up", "k", "K"]:
                self.theme_selected_idx = (self.theme_selected_idx - 1 + len(self.theme_items)) % len(self.theme_items)
                self.refresh_theme_ui()
                return True
            if keyname in ["Tab"]:
                self.switch_tab("wallpaper")
                return True
            if keyname in ["ISO_Left_Tab"]:
                self.switch_tab("plugins")
                return True
            if keyname in ["Return", "KP_Enter", "space"]:
                self.apply_theme_choice(self.theme_selected_idx)
                return True
            if keyname in ["1", "2", "3", "4"]:
                idx = int(keyname) - 1
                if 0 <= idx < len(self.theme_items):
                    self.apply_theme_choice(idx)
                    return True
            return False

        elif self.active_tab == "wallpaper":
            if keyname in ["Down", "j", "J"]:
                if self.wp_rows:
                    self.wp_selected_idx = (self.wp_selected_idx + 1) % len(self.wp_rows)
                    self.refresh_wallpaper_ui()
                return True
            if keyname in ["Up", "k", "K"]:
                if self.wp_rows:
                    self.wp_selected_idx = (self.wp_selected_idx - 1 + len(self.wp_rows)) % len(self.wp_rows)
                    self.refresh_wallpaper_ui()
                return True
            if keyname in ["Tab"]:
                self.switch_tab("screensaver")
                return True
            if keyname in ["ISO_Left_Tab"]:
                self.switch_tab("theme")
                return True
            if keyname in ["c", "C"]:
                self.cycle_wallpaper_now()
                return True
            if keyname in ["Return", "KP_Enter", "space"]:
                self.set_wallpaper_choice(self.wp_selected_idx)
                return True
            return False

        elif self.active_tab == "screensaver":
            if keyname in ["Down", "j", "J"]:
                if self.ss_rows:
                    self.ss_selected_idx = (self.ss_selected_idx + 1) % len(self.ss_rows)
                    self.refresh_screensaver_ui()
                return True
            if keyname in ["Up", "k", "K"]:
                if self.ss_rows:
                    self.ss_selected_idx = (self.ss_selected_idx - 1 + len(self.ss_rows)) % len(self.ss_rows)
                    self.refresh_screensaver_ui()
                return True
            if keyname in ["Tab"]:
                self.switch_tab("modules")
                return True
            if keyname in ["ISO_Left_Tab"]:
                self.switch_tab("wallpaper")
                return True
            if keyname in ["p", "P"]:
                self.preview_screensaver()
                return True
            if keyname in ["Return", "KP_Enter", "space"]:
                if self.ss_selected_idx == 0:
                    self.cycle_ss_timeout()
                elif self.ss_selected_idx == 1:
                    self.toggle_ss_lock()
                elif 2 <= self.ss_selected_idx < len(self.ss_rows):
                    scene_idx = self.ss_selected_idx - 2
                    if 0 <= scene_idx < len(SCENE_PRESETS):
                        self.set_ss_scene(SCENE_PRESETS[scene_idx][0])
                return True
            return False

        elif self.active_tab == "modules":
            if keyname in ["Down", "j", "J"]:
                self.mod_selected_idx = (self.mod_selected_idx + 1) % len(ALL_WAYBAR_MODULES)
                self.refresh_modules_ui()
                return True
            if keyname in ["Up", "k", "K"]:
                self.mod_selected_idx = (self.mod_selected_idx - 1 + len(ALL_WAYBAR_MODULES)) % len(ALL_WAYBAR_MODULES)
                self.refresh_modules_ui()
                return True
            if keyname in ["Tab"]:
                self.switch_tab("plugins")
                return True
            if keyname in ["ISO_Left_Tab"]:
                self.switch_tab("screensaver")
                return True
            if keyname in ["Return", "KP_Enter", "space"]:
                self.toggle_waybar_module(self.mod_selected_idx)
                return True
            if keyname in ["1", "2", "3", "4", "5", "6", "7", "8"]:
                idx = int(keyname) - 1
                if 0 <= idx < len(ALL_WAYBAR_MODULES):
                    self.toggle_waybar_module(idx)
                    return True
            return False

        elif self.active_tab == "plugins":
            if keyname in ["Down", "j", "J"]:
                self.plugin_selected_idx = (self.plugin_selected_idx + 1) % len(ALL_THEME_PLUGINS)
                self.refresh_plugins_ui()
                return True
            if keyname in ["Up", "k", "K"]:
                self.plugin_selected_idx = (self.plugin_selected_idx - 1 + len(ALL_THEME_PLUGINS)) % len(ALL_THEME_PLUGINS)
                self.refresh_plugins_ui()
                return True
            if keyname in ["Tab"]:
                self.switch_tab("theme")
                return True
            if keyname in ["ISO_Left_Tab"]:
                self.switch_tab("modules")
                return True
            if keyname in ["u", "U"]:
                self.sync_all_plugins()
                return True
            if keyname in ["Return", "KP_Enter", "space"]:
                self.toggle_plugin(self.plugin_selected_idx)
                return True
            if keyname in ["1", "2", "3", "4", "5", "6", "7", "8", "9"]:
                idx = int(keyname) - 1
                if 0 <= idx < len(ALL_THEME_PLUGINS):
                    self.toggle_plugin(idx)
                    return True
            return False

        return False

def check_singleton():
    my_pid = os.getpid()
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                old_pid = int(f.read().strip())
            if old_pid != my_pid:
                is_running = False
                try:
                    os.kill(old_pid, 0)
                    try:
                        with open(f"/proc/{old_pid}/cmdline", "rb") as cf:
                            cmd = cf.read().decode("utf-8", errors="ignore")
                            if "space-theme-config" in cmd:
                                is_running = True
                    except Exception:
                        is_running = True
                except OSError:
                    is_running = False

                if is_running:
                    try:
                        os.kill(old_pid, signal.SIGTERM)
                    except OSError:
                        pass
                    try:
                        os.remove(PID_FILE)
                    except OSError:
                        pass
                    sys.exit(0)
                else:
                    try:
                        os.remove(PID_FILE)
                    except OSError:
                        pass
        except Exception:
            pass

    try:
        with open(PID_FILE, "w") as f:
            f.write(str(my_pid))
    except Exception:
        pass

def cleanup():
    try:
        if os.path.exists(PID_FILE):
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            if pid == os.getpid():
                os.remove(PID_FILE)
    except Exception:
        pass

def main():
    check_singleton()
    init_tab = "theme"
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ["wallpaper", "wallpapers", "wp"]:
            init_tab = "wallpaper"
        elif arg in ["screensaver", "ss", "idle"]:
            init_tab = "screensaver"
        elif arg in ["modules", "waybar", "bar"]:
            init_tab = "modules"
        elif arg in ["plugins", "plugin", "pkg", "tools"]:
            init_tab = "plugins"

    win = SpaceThemeConfigDialog(initial_tab=init_tab)
    win.connect("destroy", lambda w: (cleanup(), Gtk.main_quit()))
    win.show_all()
    win.switch_tab(init_tab)
    Gtk.main()

if __name__ == "__main__":
    main()
