        info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        l1 = Gtk.Label()
        l1.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_main']}'>🌌 Theme Wallpaper Gallery</span>")
        l1.set_xalign(0.0)
        info_box.pack_start(l1, False, False, 0)

        l2 = Gtk.Label()
        l2.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>Select an active background or use the in-theme cycler (Super+Alt+W).</span>")
        l2.set_xalign(0.0)
        info_box.pack_start(l2, False, False, 0)
        card.pack_start(info_box, True, True, 0)

        btn_cycle = Gtk.Button(label="⚡ Cycle (C)")
        btn_cycle.get_style_context().add_class("btn-cycle")
        btn_cycle.connect("clicked", lambda w: self.cycle_wallpaper_now())
        card.pack_start(btn_cycle, False, False, 0)
        vbox.pack_start(card, False, False, 0)

        # Scrollable Wallpaper List
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        vbox.pack_start(scroll, True, True, 0)

        self.wp_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        scroll.add(self.wp_container)

        self.populate_wallpaper_rows()
        self.stack.add_named(vbox, "wallpaper")

    def populate_wallpaper_rows(self):
        for child in self.wp_container.get_children():
            self.wp_container.remove(child)

        theme_wp_dir = THEMES_DIR / self.current_theme / "wallpapers"
        self.wp_file_paths = []
        if theme_wp_dir.exists():
            for ext in ["*.jpg", "*.jpeg", "*.png"]:
                self.wp_file_paths.extend(sorted(list(theme_wp_dir.glob(ext))))

        cur_wp = ""
        cur_wp_file = THEMES_DIR / "current_wallpaper"
        if cur_wp_file.exists():
            try:
                cur_wp = cur_wp_file.read_text().strip()
            except Exception:
                pass

        self.wp_rows = []
        for i, wp_path in enumerate(self.wp_file_paths):
            btn = Gtk.EventBox()
            btn.get_style_context().add_class("tool-row")
            is_cur = (str(wp_path) == cur_wp)
            if is_cur:
                btn.get_style_context().add_class("active-theme")

            row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            btn.add(row_box)

            fname = wp_path.name
            clean_name = fname.replace("-", " ").replace("_", " ").rsplit(".", 1)[0].title()

            icon_lbl = Gtk.Label()
            icon_lbl.set_markup(f"<span foreground='{self.pal['green'] if is_cur else self.pal['text_dim']}'>{'[✔ ACTIVE]' if is_cur else '[   ]'}</span>")
            row_box.pack_start(icon_lbl, False, False, 0)

            t_lbl = Gtk.Label()
            t_lbl.set_markup(f"<span font_weight='bold' font_size='8500' foreground='{self.pal['text_main']}'>{clean_name}</span> <span font_size='7500' foreground='{self.pal['text_dim']}'>({fname})</span>")
            t_lbl.set_xalign(0.0)
            row_box.pack_start(t_lbl, True, True, 0)

            btn.connect("button-press-event", lambda w, e, idx=i: self.set_wallpaper_choice(idx))
            self.wp_rows.append(btn)
            self.wp_container.pack_start(btn, False, False, 0)

        self.wp_container.show_all()

