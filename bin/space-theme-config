def get_current_theme():
    if CURRENT_THEME_FILE.exists():
        try:
            t = CURRENT_THEME_FILE.read_text().strip()
            if t in THEMES:
                return t
        except Exception:
            pass
    return "nasa"

def load_screensaver_config():
    SCREENSAVER_DIR.mkdir(parents=True, exist_ok=True)
    if SCREENSAVER_CONFIG.exists():
        try:
            return json.loads(SCREENSAVER_CONFIG.read_text())
        except Exception:
            pass
    return {
        "timeout_minutes": 5,
        "lock_on_wake": False,
        "scene_mode": "all"
    }

def save_screensaver_config(cfg):
    SCREENSAVER_DIR.mkdir(parents=True, exist_ok=True)
    SCREENSAVER_CONFIG.write_text(json.dumps(cfg, indent=2))
    try:
        subprocess.run(["killall", "-USR1", "space-idle-daemon"], check=False, capture_output=True)
    except Exception:
        pass

class SpaceThemeConfigDialog(Gtk.Window):
    def __init__(self, initial_tab="theme"):
        GLib.set_prgname("space-theme-config")
        GLib.set_application_name("Apollo Theme & Visual Avionics Configurator")
        super().__init__(title="Apollo Theme & Visual Avionics Configurator")
        self.set_role("dialog")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_default_size(740, 640)

        self.current_theme = get_current_theme()
        self.pal = THEMES.get(self.current_theme, THEMES["nasa"])
        self.active_tab = initial_tab

        # Screensaver State
        self.ss_cfg = load_screensaver_config()

        # Navigation State
        self.theme_selected_idx = 0
        self.wp_selected_idx = 0
        self.ss_selected_idx = 0
        self.mod_selected_idx = 0
        self.plugin_selected_idx = 0

        self.theme_cards = []
        self.wp_rows = []
        self.ss_rows = []
        self.mod_rows = []
        self.plugin_rows = []

        self.toast_timeout_id = None

        self.apply_css()
        self.build_ui()
        self.connect("key-press-event", self.on_key_press)
        GLib.idle_add(lambda: self.switch_tab(self.active_tab))

    def apply_css(self):
        css = f"""
        * {{
            font-family: 'JetBrainsMono Nerd Font', monospace;
        }}
        window {{
            background-color: {self.pal['bg']};
            border: 2px solid {self.pal['border']};
            border-radius: {self.pal['radius']};
        }}
        .header-box {{
            background-color: {self.pal['bg_card']};
            border-bottom: 2px solid {self.pal['border']};
            padding: 10px 16px;
        }}
        .tab-bar {{
            background-color: {self.pal['bg']};
            border-bottom: 1px solid {self.pal['btn_border']};
            padding: 4px 16px 0 16px;
        }}
        .nav-tab {{
            background-color: {self.pal['btn_bg']};
            border: 1px solid {self.pal['btn_border']};
            border-bottom: none;
            border-radius: {self.pal['radius']} {self.pal['radius']} 0 0;
            padding: 7px 10px;
            transition: all 0.15s ease;
        }}
        .nav-tab.active {{
            background-color: {self.pal['bg_card']};
            border: 1px solid {self.pal['accent']};
            border-bottom: 2px solid {self.pal['bg_card']};
        }}
        .card-panel {{
            background-color: {self.pal['bg_card']};
            border: 1px solid {self.pal['btn_border']};
            border-radius: {self.pal['radius']};
            padding: 9px 12px;
            margin-bottom: 6px;
        }}
