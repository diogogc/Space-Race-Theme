#!/usr/bin/env python3
"""
====================================================================
 🔊 APOLLO QUINDAR AUDIO ENGINE & SOUND EFFECTS DISPATCHER
====================================================================
 Plays authentic Apollo mission audio tones (2525Hz / 2475Hz)
 for space events, ISS tracking alerts, and desktop feedback.
====================================================================
"""

import sys
import os
import json
import subprocess
import shutil

CONFIG_FILE = os.path.expanduser("~/.config/space-theme/audio-config.json")
SOUND_DIRS = [
    os.path.expanduser("~/.config/space-theme/sounds"),
    os.path.expanduser("~/.config/spaceera/sounds"),
    os.path.expanduser("~/Space-Race-Theme/sounds"),
    "/usr/share/sounds/space-theme",
]

SOUND_MAP = {
    "intro": "quindar-intro.wav",
    "outro": "quindar-outro.wav",
    "beep": "quindar-beep.wav",
    "acquired": "iss-acquired.wav",
    "alert": "alarm-1202.wav",
    "alarm": "alarm-1202.wav",
    "shutter": "shutter.wav",
    "capture": "shutter.wav",
    "relay": "relay-latch.wav",
    "theme-switch": "relay-latch.wav",
    "switch": "relay-latch.wav",
    "lock": "lock.wav",
    "unlock": "unlock.wav",
}

def load_config():
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    # Fallback to spaceera legacy config
    legacy = os.path.expanduser("~/.config/spaceera/audio-config.json")
    if os.path.isfile(legacy):
        try:
            with open(legacy, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {"enabled": True, "volume": 1.0}

def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)

def play_sound(sound_name):
    cfg = load_config()
    if not cfg.get("enabled", True):
        return

    if sound_name not in SOUND_MAP:
        return

    wav_file = os.path.basename(SOUND_MAP[sound_name])
    wav_path = None
    for sdir in SOUND_DIRS:
        cand = os.path.join(sdir, wav_file)
        if os.path.isfile(cand):
            wav_path = cand
            break

    if not wav_path:
        return

    player = shutil.which("pw-play") or shutil.which("paplay") or shutil.which("aplay")
    if not player:
        return

    try:
        subprocess.Popen([player, wav_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def main():
    if len(sys.argv) < 2:
        play_sound("beep")
        return

    cmd = sys.argv[1].lower()
    if cmd == "toggle":
        cfg = load_config()
        cfg["enabled"] = not cfg.get("enabled", True)
        save_config(cfg)
        status = "ENABLED" if cfg["enabled"] else "MUTED"
        print(f"Quindar Audio: {status}")
        if cfg["enabled"]:
            play_sound("beep")
    elif cmd == "status":
        cfg = load_config()
        print("ENABLED" if cfg.get("enabled", True) else "MUTED")
    elif cmd in SOUND_MAP:
        play_sound(cmd)
    else:
        play_sound("beep")

if __name__ == "__main__":
    main()
