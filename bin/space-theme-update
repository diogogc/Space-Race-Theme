#!/usr/bin/env bash
# ==============================================================================
# 🚀 APOLLO MISSION CONTROL: THEME & PLUGIN UPDATE ENGINE
# ==============================================================================
# Synchronizes the Space-Race-Theme repository, pulls upstream updates,
# syncs standalone plugin repos (e.g. eecom), recompiles C daemons,
# updates ~/.local/bin symlinks, and triggers live compositor reloads.
# ==============================================================================

set -euo pipefail

THEME_DIR="${HOME}/Space-Race-Theme"
EECOM_DIR="${HOME}/eecom"
BIN_DIR="${HOME}/.local/bin"

if [[ -t 1 ]] && [[ "${NO_COLOR:-}" != "1" ]]; then
    CLR_RESET="\033[0m"
    CLR_BOLD="\033[1m"
    CLR_CYAN="\033[38;2;56;189;248m"
    CLR_MINT="\033[38;2;45;212;191m"
    CLR_GREEN="\033[38;2;34;197;94m"
    CLR_AMBER="\033[38;2;245;158;11m"
    CLR_RED="\033[38;2;239;68;68m"
    CLR_SLATE="\033[38;2;148;163;184m"
    CLR_DARK="\033[38;2;71;85;105m"
else
    CLR_RESET=""
    CLR_BOLD=""
    CLR_CYAN=""
    CLR_MINT=""
    CLR_GREEN=""
    CLR_AMBER=""
    CLR_RED=""
    CLR_SLATE=""
    CLR_DARK=""
fi

echo -e "${CLR_CYAN}${CLR_BOLD}"
echo "  🚀 [APOLLO MISSION CONTROL] Theme & Plugin Avionics Synchronizer"
echo "  ════════════════════════════════════════════════════════════════════════════════"
echo -e "${CLR_RESET}"

# 1. Update Space-Race-Theme Git Repository
if [[ -d "${THEME_DIR}/.git" ]]; then
    echo -e "  ${CLR_CYAN}• Checking upstream updates for Space-Race-Theme...${CLR_RESET}"
    if git -C "$THEME_DIR" remote get-url origin >/dev/null 2>&1; then
        if git -C "$THEME_DIR" pull --rebase 2>/dev/null; then
            echo -e "    ${CLR_GREEN}✔ Space-Race-Theme repository is up to date.${CLR_RESET}"
        else
            echo -e "    ${CLR_AMBER}▲ Git pull skipped (working directory or offline).${CLR_RESET}"
        fi
    else
        echo -e "    ${CLR_SLATE}• Local repository active (no remote).${CLR_RESET}"
    fi
fi

# 2. Sync Standalone EECOM Plugin Repository
if [[ -d "${EECOM_DIR}" ]]; then
    echo -e "  ${CLR_CYAN}• Synchronizing EECOM plugin repository with theme...${CLR_RESET}"
    if [[ "${EECOM_DIR}/bin/eecom" -nt "${THEME_DIR}/bin/space-eecom" ]]; then
        cp -f "${EECOM_DIR}/bin/eecom" "${THEME_DIR}/bin/space-eecom"
        chmod +x "${THEME_DIR}/bin/space-eecom"
        echo -e "    ${CLR_GREEN}✔ Propagated updates from ~/eecom -> ~/Space-Race-Theme/bin/space-eecom${CLR_RESET}"
    elif [[ "${THEME_DIR}/bin/space-eecom" -nt "${EECOM_DIR}/bin/eecom" ]]; then
        cp -f "${THEME_DIR}/bin/space-eecom" "${EECOM_DIR}/bin/eecom"
        chmod +x "${EECOM_DIR}/bin/eecom"
        echo -e "    ${CLR_GREEN}✔ Propagated updates from ~/Space-Race-Theme -> ~/eecom/bin/eecom${CLR_RESET}"
    else
        echo -e "    ${CLR_GREEN}✔ EECOM and theme binaries are fully in sync.${CLR_RESET}"
    fi
fi

# 3. Rebuild Native C Daemons
if [[ -f "${THEME_DIR}/Makefile" ]]; then
    echo -e "  ${CLR_CYAN}• Verifying and compiling native C daemons...${CLR_RESET}"
    if make -C "$THEME_DIR" all >/dev/null 2>&1; then
        echo -e "    ${CLR_GREEN}✔ Native daemons compiled and verified.${CLR_RESET}"
    else
        echo -e "    ${CLR_AMBER}▲ Native daemon build skipped or up to date.${CLR_RESET}"
    fi
fi

# 4. Refresh and Re-link ~/.local/bin Symlinks
echo -e "  ${CLR_CYAN}• Updating ~/.local/bin avionics executable links...${CLR_RESET}"
mkdir -p "$BIN_DIR"
for bin_file in "${THEME_DIR}/bin/"*; do
    [[ -f "$bin_file" ]] || continue
    fname="$(basename "$bin_file")"
    ln -sf "$bin_file" "${BIN_DIR}/${fname}"
done

# Ensure specific convenient aliases are present
ln -sf "${THEME_DIR}/bin/space-eecom" "${BIN_DIR}/eecom"
ln -sf "${THEME_DIR}/bin/space-eecom" "${BIN_DIR}/eecon"
ln -sf "${THEME_DIR}/bin/space-theme-update" "${BIN_DIR}/space-update"

echo -e "    ${CLR_GREEN}✔ All $(find "${THEME_DIR}/bin" -maxdepth 1 -type f | wc -l) avionics binaries symlinked to ~/.local/bin.${CLR_RESET}"

# 5. Live Reload Compositor & Toolbars
echo -e "  ${CLR_CYAN}• Triggering live interface reload...${CLR_RESET}"
if command -v hyprctl >/dev/null 2>&1 && pgrep -x "Hyprland" >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
    echo -e "    ${CLR_GREEN}✔ Hyprland live configuration reloaded.${CLR_RESET}"
fi

if pgrep -x "waybar" >/dev/null 2>&1; then
    killall -SIGUSR2 waybar >/dev/null 2>&1 || true
    echo -e "    ${CLR_GREEN}✔ Waybar toolbar refreshed.${CLR_RESET}"
fi

echo -e "${CLR_DARK}  ────────────────────────────────────────────────────────────────────────────────${CLR_RESET}"
echo -e "  ${CLR_GREEN}${CLR_BOLD}✨ Theme & Plugins Synchronization Complete. System Nominal.${CLR_RESET}\n"
