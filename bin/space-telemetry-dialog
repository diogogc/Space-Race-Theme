def get_theme_name():
    path = os.path.expanduser("~/.config/themes/current_theme")
    if os.path.exists(path):
        try:
            with open(path, "r") as f:
                t = f.read().strip()
                if t in THEMES:
                    return t
        except Exception:
            pass
    return "nasa"

def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip('#')
    return tuple(int(hex_str[i:i+2], 16)/255.0 for i in (0, 2, 4))

def check_singleton():
    my_pid = os.getpid()
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                old_pid = int(f.read().strip())
            if old_pid != my_pid:
                try:
                    os.kill(old_pid, 0)
                    os.kill(old_pid, signal.SIGTERM)
                    try:
                        os.remove(PID_FILE)
                    except OSError:
                        pass
                    sys.exit(0)
                except OSError:
                    pass
        except Exception:
            pass

    try:
        with open(PID_FILE, "w") as f:
            f.write(str(my_pid))
    except Exception:
        pass

def cleanup():
    try:
        if os.path.exists(PID_FILE):
            with open(PID_FILE, "r") as f:
                p = int(f.read().strip())
            if p == os.getpid():
                os.remove(PID_FILE)
    except Exception:
        pass

# ---------------------------------------------------------
# Telemetry Collector Subsystem
# ---------------------------------------------------------
class TelemetryCollector:
    def __init__(self):
        self.prev_cpu_times = {}
        self.prev_time = time.time()
        self.cpu_model = self._get_cpu_model()
        self.num_cores = os.cpu_count() or 1

    def _get_cpu_model(self):
        try:
            with open("/proc/cpuinfo") as f:
                for line in f:
                    if "model name" in line:
                        return line.split(":", 1)[1].strip()
        except Exception:
            pass
        return "Unknown Processor Core"

    def read_cpu_and_cores(self):
        now = time.time()
        dt = max(0.1, now - self.prev_time)
        overall_usage = 0.0
        core_usages = []

        try:
            with open("/proc/stat") as f:
                for line in f:
                    if line.startswith("cpu"):
                        parts = line.split()
                        name = parts[0]
                        user = float(parts[1])
                        nice = float(parts[2])
                        system = float(parts[3])
                        idle = float(parts[4])
                        iowait = float(parts[5]) if len(parts) > 5 else 0.0
                        irq = float(parts[6]) if len(parts) > 6 else 0.0
                        softirq = float(parts[7]) if len(parts) > 7 else 0.0
                        steal = float(parts[8]) if len(parts) > 8 else 0.0

                        busy = user + nice + system + irq + softirq + steal
                        total = busy + idle + iowait

                        if name in self.prev_cpu_times:
                            p_busy, p_total = self.prev_cpu_times[name]
                            diff_total = max(1.0, total - p_total)
                            diff_busy = max(0.0, busy - p_busy)
                            pct = (diff_busy / diff_total) * 100.0
                            pct = max(0.0, min(100.0, pct))
                        else:
                            pct = 0.0

                        self.prev_cpu_times[name] = (busy, total)

                        if name == "cpu":
                            overall_usage = pct
                        else:
                            core_usages.append(pct)
        except Exception:
            pass

        # Frequencies
        freqs = []
        for i in range(self.num_cores):
            freq_path = f"/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_cur_freq"
            if os.path.exists(freq_path):
                try:
                    with open(freq_path) as f:
                        freqs.append(int(f.read().strip()) / 1000.0) # MHz
                except Exception:
                    pass
        avg_freq = sum(freqs)/len(freqs) if freqs else 0.0

        # Thermal Core Temp
        cpu_temp = 0.0
        for hwmon in sorted(os.listdir("/sys/class/hwmon") if os.path.exists("/sys/class/hwmon") else []):
            hpath = os.path.join("/sys/class/hwmon", hwmon)
            for fname in os.listdir(hpath):
                if fname.startswith("temp") and fname.endswith("_input"):
                    try:
                        with open(os.path.join(hpath, fname)) as tf:
                            raw = int(tf.read().strip())
                            if 10000 < raw < 120000:
                                cpu_temp = raw / 1000.0
                                break
                    except Exception:
                        continue
            if cpu_temp > 0:
                break

        # Load Averages
        load1, load5, load15 = 0.0, 0.0, 0.0
        try:
            with open("/proc/loadavg") as f:
                lparts = f.read().split()
                load1, load5, load15 = float(lparts[0]), float(lparts[1]), float(lparts[2])
        except Exception:
            pass

        self.prev_time = now
        return {
            "overall": overall_usage,
            "cores": core_usages,
            "freq_mhz": avg_freq,
            "temp_c": cpu_temp,
            "load_avg": (load1, load5, load15)
        }

    def read_memory(self):
        mem = {
            "total_gb": 0.0, "used_gb": 0.0, "avail_gb": 0.0,
            "cache_gb": 0.0, "swap_total_gb": 0.0, "swap_used_gb": 0.0,
            "used_pct": 0.0, "swap_pct": 0.0
        }
        try:
            raw = {}
            with open("/proc/meminfo") as f:
                for line in f:
                    parts = line.split(":")
                    if len(parts) == 2:
                        k = parts[0].strip()
                        v = int(parts[1].split()[0].strip())
                        raw[k] = v

            total = raw.get("MemTotal", 0)
            avail = raw.get("MemAvailable", 0)
            buffers = raw.get("Buffers", 0)
            cached = raw.get("Cached", 0) + raw.get("SReclaimable", 0)
            swap_total = raw.get("SwapTotal", 0)
            swap_free = raw.get("SwapFree", 0)

            used = max(0, total - avail)
            swap_used = max(0, swap_total - swap_free)

            mem["total_gb"] = total / 1048576.0
            mem["avail_gb"] = avail / 1048576.0
            mem["used_gb"] = used / 1048576.0
            mem["cache_gb"] = (buffers + cached) / 1048576.0
            mem["swap_total_gb"] = swap_total / 1048576.0
            mem["swap_used_gb"] = swap_used / 1048576.0

            if total > 0:
                mem["used_pct"] = (used / total) * 100.0
            if swap_total > 0:
                mem["swap_pct"] = (swap_used / swap_total) * 100.0
        except Exception:
            pass
        return mem

    def read_storage(self):
        disks = []
        for mount in ["/", "/home"]:
            if os.path.exists(mount):
                try:
                    st = os.statvfs(mount)
                    total_b = st.f_blocks * st.f_frsize
                    free_b = st.f_bavail * st.f_frsize
                    used_b = total_b - free_b
                    pct = (used_b / total_b) * 100.0 if total_b > 0 else 0.0

                    if any(d["total_gb"] == (total_b / 1073741824.0) for d in disks):
                        continue

                    disks.append({
                        "mount": mount,
                        "total_gb": total_b / 1073741824.0,
                        "used_gb": used_b / 1073741824.0,
                        "free_gb": free_b / 1073741824.0,
                        "pct": pct
                    })
                except Exception:
                    pass
        return disks

    def read_top_processes(self, limit=30, sort_by="cpu"):
        procs = []
        try:
            cmd = ["ps", "-eo", "pid,user,%cpu,%mem,stat,comm,args", "--no-headers"]
            out = subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL)
            for line in out.strip().splitlines():
                parts = line.strip().split(None, 6)
                if len(parts) >= 6:
                    pid = int(parts[0])
                    user = parts[1]
                    try:
                        cpu = float(parts[2])
                    except ValueError:
                        cpu = 0.0
                    try:
                        mem = float(parts[3])
                    except ValueError:
                        mem = 0.0
                    stat = parts[4]
                    comm = parts[5]
                    args = parts[6] if len(parts) > 6 else comm

                    procs.append({
                        "pid": pid,
                        "user": user,
                        "cpu": cpu,
                        "mem": mem,
                        "stat": stat,
                        "comm": os.path.basename(comm),
                        "cmd": args
                    })
        except Exception:
            pass

        if sort_by == "mem":
            procs.sort(key=lambda p: p["mem"], reverse=True)
        else:
            procs.sort(key=lambda p: p["cpu"], reverse=True)

        return procs[:limit]

# ---------------------------------------------------------
# Custom Cairo Hardware Telemetry Gauges
# ---------------------------------------------------------
class ApolloCpuMeter(Gtk.DrawingArea):
    """Phosphor Telemetry Horizontal Bar & Range Indicator for CPU"""
    def __init__(self, pal):
        super().__init__()
        self.set_size_request(340, 56)
        self.pal = pal
        self.cpu_pct = 0.0
        self.temp_c = 0.0
        self.freq_mhz = 0.0

    def update_values(self, pct, temp_c, freq_mhz):
        self.cpu_pct = pct
        self.temp_c = temp_c
        self.freq_mhz = freq_mhz
        self.queue_draw()

    def do_draw(self, cr):
        width = self.get_allocated_width()
        height = self.get_allocated_height()

        cr.save()
        bez_r, bez_g, bez_b = hex_to_rgb(self.pal["bg_bezel"])
        cr.set_source_rgb(bez_r, bez_g, bez_b)
        cr.rectangle(0, 0, width, height)
        cr.fill()

        bord_r, bord_g, bord_b = hex_to_rgb(self.pal["border_dim"])
        cr.set_source_rgb(bord_r, bord_g, bord_b)
        cr.set_line_width(1.0)
        cr.rectangle(0, 0, width, height)
        cr.stroke()

        acc_r, acc_g, acc_b = hex_to_rgb(self.pal["text_main"])
        grn_r, grn_g, grn_b = hex_to_rgb(self.pal["green"])
        yel_r, yel_g, yel_b = hex_to_rgb(self.pal["yellow"])
        red_r, red_g, red_b = hex_to_rgb(self.pal["red"])

        cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(9.0)
        cr.set_source_rgb(acc_r, acc_g, acc_b)
        cr.move_to(8, 14)
        cr.show_text("⚡ PROCESSOR CORE UTILIZATION")

        val_txt = f"{self.cpu_pct:4.1f}% | {self.freq_mhz/1000.0:3.2f} GHz | {self.temp_c:.0f}°C"
        col = (grn_r, grn_g, grn_b) if self.cpu_pct < 70 else ((yel_r, yel_g, yel_b) if self.cpu_pct < 85 else (red_r, red_g, red_b))
        cr.set_source_rgb(*col)
        ext = cr.text_extents(val_txt)
        cr.move_to(width - 8 - ext.width, 14)
        cr.show_text(val_txt)

        track_x = 8
        track_y = 20
        track_w = width - 16
        track_h = 16

        tr_r, tr_g, tr_b = hex_to_rgb(self.pal["track_bg"])
        cr.set_source_rgb(tr_r, tr_g, tr_b)
        cr.rectangle(track_x, track_y, track_w, track_h)
        cr.fill()

        cr.set_source_rgba(bord_r, bord_g, bord_b, 0.8)
        cr.set_line_width(1.0)
        cr.rectangle(track_x, track_y, track_w, track_h)
        cr.stroke()

        num_bars = 32
        active_bars = int((self.cpu_pct / 100.0) * num_bars)
        bar_spacing = (track_w - 4) / float(num_bars)

        for b in range(active_bars):
            bx = track_x + 2 + b * bar_spacing
            bw = max(2.0, bar_spacing - 1.5)
            if b < int(num_bars * 0.65):
                cr.set_source_rgba(grn_r, grn_g, grn_b, 0.9)
            elif b < int(num_bars * 0.85):
                cr.set_source_rgba(yel_r, yel_g, yel_b, 0.9)
            else:
                cr.set_source_rgba(red_r, red_g, red_b, 0.95)
            cr.rectangle(bx, track_y + 2, bw, track_h - 4)
            cr.fill()

        for i in range(11):
            tx = track_x + (i / 10.0) * track_w
            is_major = (i % 5 == 0)
            tick_len = 4 if is_major else 2
            cr.set_source_rgba(acc_r, acc_g, acc_b, 0.7 if is_major else 0.35)
            cr.set_line_width(1.0)
            cr.move_to(tx, track_y + track_h + 1)
            cr.line_to(tx, track_y + track_h + 1 + tick_len)
            cr.stroke()

            if is_major:
                val_str = f"{i*10}%"
                cr.set_font_size(6.5)
                vext = cr.text_extents(val_str)
                cr.move_to(tx - vext.width / 2.0, track_y + track_h + 11)
                cr.show_text(val_str)

        cr.restore()
        return False

class ApolloMemoryMeter(Gtk.DrawingArea):
    """Segmented Memory Core Allocation Bar (App Memory / Buffers-Cache / Free)"""
    def __init__(self, pal):
        super().__init__()
        self.set_size_request(340, 56)
        self.pal = pal
        self.used_gb = 0.0
        self.cache_gb = 0.0
        self.total_gb = 0.0
        self.used_pct = 0.0

    def update_values(self, used_gb, cache_gb, total_gb, used_pct):
        self.used_gb = used_gb
        self.cache_gb = cache_gb
        self.total_gb = total_gb
        self.used_pct = used_pct
        self.queue_draw()

    def do_draw(self, cr):
        width = self.get_allocated_width()
        height = self.get_allocated_height()

        cr.save()
        bez_r, bez_g, bez_b = hex_to_rgb(self.pal["bg_bezel"])
        cr.set_source_rgb(bez_r, bez_g, bez_b)
        cr.rectangle(0, 0, width, height)
        cr.fill()

        bord_r, bord_g, bord_b = hex_to_rgb(self.pal["border_dim"])
        cr.set_source_rgb(bord_r, bord_g, bord_b)
        cr.set_line_width(1.0)
        cr.rectangle(0, 0, width, height)
        cr.stroke()

        acc_r, acc_g, acc_b = hex_to_rgb(self.pal["text_main"])
        grn_r, grn_g, grn_b = hex_to_rgb(self.pal["green"])
        cyan_r, cyan_g, cyan_b = hex_to_rgb(self.pal["cyan"])

        cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(9.0)
        cr.set_source_rgb(acc_r, acc_g, acc_b)
        cr.move_to(8, 14)
        cr.show_text("💾 AGC MEMORY CORE ALLOCATION")

        val_txt = f"{self.used_gb:.1f}G / {self.total_gb:.1f}G ({self.used_pct:.0f}%)"
        cr.set_source_rgb(grn_r, grn_g, grn_b)
        ext = cr.text_extents(val_txt)
        cr.move_to(width - 8 - ext.width, 14)
        cr.show_text(val_txt)

        track_x = 8
        track_y = 20
        track_w = width - 16
        track_h = 16

        tr_r, tr_g, tr_b = hex_to_rgb(self.pal["track_bg"])
        cr.set_source_rgb(tr_r, tr_g, tr_b)
        cr.rectangle(track_x, track_y, track_w, track_h)
        cr.fill()

        cr.set_source_rgba(bord_r, bord_g, bord_b, 0.8)
        cr.set_line_width(1.0)
        cr.rectangle(track_x, track_y, track_w, track_h)
        cr.stroke()

        if self.total_gb > 0:
            used_w = (self.used_gb / self.total_gb) * (track_w - 4)
            cache_w = (self.cache_gb / self.total_gb) * (track_w - 4)

            cr.set_source_rgba(acc_r, acc_g, acc_b, 0.9)
            cr.rectangle(track_x + 2, track_y + 2, used_w, track_h - 4)
            cr.fill()

            cr.set_source_rgba(cyan_r, cyan_g, cyan_b, 0.5)
            cr.rectangle(track_x + 2 + used_w, track_y + 2, min(cache_w, (track_w - 4) - used_w), track_h - 4)
            cr.fill()

        for i in range(11):
            tx = track_x + (i / 10.0) * track_w
            is_major = (i % 5 == 0)
            tick_len = 4 if is_major else 2
            cr.set_source_rgba(acc_r, acc_g, acc_b, 0.7 if is_major else 0.35)
            cr.set_line_width(1.0)
            cr.move_to(tx, track_y + track_h + 1)
            cr.line_to(tx, track_y + track_h + 1 + tick_len)
            cr.stroke()

            if is_major:
                val_str = f"{int(i * (self.total_gb / 10.0))}G" if self.total_gb > 0 else f"{i*10}%"
                cr.set_font_size(6.5)
                vext = cr.text_extents(val_str)
                cr.move_to(tx - vext.width / 2.0, track_y + track_h + 11)
                cr.show_text(val_str)

        cr.restore()
        return False

class ApolloCoresGrid(Gtk.DrawingArea):
    """Multi-Core Telemetry Bars Grid with generous vertical headroom and clear labels"""
    def __init__(self, pal, num_cores):
        super().__init__()
        self.pal = pal
        self.num_cores = max(1, num_cores)
        self.core_pcts = [0.0] * self.num_cores
        # Generous vertical sizing to completely prevent any occlusion of labels
        self.set_size_request(340, 80)

    def update_cores(self, core_pcts):
        self.core_pcts = core_pcts
        self.num_cores = len(core_pcts) if core_pcts else self.num_cores
        self.queue_draw()

    def do_draw(self, cr):
        width = self.get_allocated_width()
        height = self.get_allocated_height()

        cr.save()
        bez_r, bez_g, bez_b = hex_to_rgb(self.pal["bg_bezel"])
        cr.set_source_rgb(bez_r, bez_g, bez_b)
        cr.rectangle(0, 0, width, height)
        cr.fill()

        bord_r, bord_g, bord_b = hex_to_rgb(self.pal["border_dim"])
        cr.set_source_rgb(bord_r, bord_g, bord_b)
        cr.set_line_width(1.0)
        cr.rectangle(0, 0, width, height)
        cr.stroke()

        acc_r, acc_g, acc_b = hex_to_rgb(self.pal["text_main"])
        sub_r, sub_g, sub_b = hex_to_rgb(self.pal["text_sub"])
        grn_r, grn_g, grn_b = hex_to_rgb(self.pal["green"])
        yel_r, yel_g, yel_b = hex_to_rgb(self.pal["yellow"])
        red_r, red_g, red_b = hex_to_rgb(self.pal["red"])

        # Title
        cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(9.0)
        cr.set_source_rgb(acc_r, acc_g, acc_b)
        cr.move_to(8, 14)
        cr.show_text(f"🚀 MULTI-CORE THREAD BUS ({self.num_cores} CORES)")

        track_x = 8
        track_y = 22
        track_w = width - 16
        track_h = 36  # Generous vertical meter bar height

        n = len(self.core_pcts)
        if n > 0:
            col_gap = 5.0
            col_w = (track_w - (n - 1) * col_gap) / float(n)
            for i, pct in enumerate(self.core_pcts):
                cx = track_x + i * (col_w + col_gap)

                # Core slot background
                tr_r, tr_g, tr_b = hex_to_rgb(self.pal["track_bg"])
                cr.set_source_rgb(tr_r, tr_g, tr_b)
                cr.rectangle(cx, track_y, col_w, track_h)
                cr.fill()

                # Border around slot
                cr.set_source_rgba(bord_r, bord_g, bord_b, 0.8)
                cr.set_line_width(1.0)
                cr.rectangle(cx, track_y, col_w, track_h)
                cr.stroke()

                # Fill from bottom up
                fill_h = (pct / 100.0) * (track_h - 2)
                col = (grn_r, grn_g, grn_b) if pct < 70 else ((yel_r, yel_g, yel_b) if pct < 85 else (red_r, red_g, red_b))
                cr.set_source_rgba(col[0], col[1], col[2], 0.92)
                cr.rectangle(cx + 1, track_y + track_h - 1 - fill_h, col_w - 2, fill_h)
                cr.fill()

                # Core label below track (perfectly centered, no occlusion)
                cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
                cr.set_font_size(8.0)
                cr.set_source_rgb(sub_r, sub_g, sub_b)
                lbl = f"C{i}"
                lext = cr.text_extents(lbl)
                cr.move_to(cx + (col_w - lext.width)/2.0, track_y + track_h + 13)
                cr.show_text(lbl)

        cr.restore()
        return False

# ---------------------------------------------------------
# Main Dialog Window
# ---------------------------------------------------------
class ApolloTelemetryDialog(Gtk.Window):
    def __init__(self):
        super().__init__(title="Apollo Mission Control Telemetry Console")
        self.theme_name = get_theme_name()
        self.pal = THEMES.get(self.theme_name, THEMES["nasa"])

        self.collector = TelemetryCollector()
        self.refresh_intervals = [1.0, 2.0, 5.0, 0.5]
        self.cur_interval_idx = 0
        self.sort_by = "cpu"
        self.search_filter = ""
        self.selected_pid = None
        self.selected_comm = ""

        try:
            self.set_wmclass("space-telemetry-dialog", "space-telemetry-dialog")
        except Exception:
            pass
        self.set_role("space-telemetry-dialog")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_default_size(820, 660)
        self.set_resizable(True)
        self.set_modal(True)
        self.set_keep_above(True)

        self._setup_css()
        self._build_ui()

        self.connect("destroy", self._on_destroy)
        self.connect("key-press-event", self._on_key_press)

        self._update_telemetry()
        self._timer_id = GLib.timeout_add(int(self.refresh_intervals[self.cur_interval_idx] * 1000), self._on_timer_tick)

    def _setup_css(self):
        css = f"""
        window {{
