            border-bottom: 2px solid {self.pal['border']};
            padding: 10px 16px;
        }}
        .telemetry-card {{
            background-color: {self.pal['bg_panel']};
            border: 1px solid {self.pal['border_dim']};
            border-radius: {self.pal['radius']};
            padding: 10px 14px;
        }}
        .stat-badge {{
            background-color: {self.pal['bg_bezel']};
            border: 1px solid {self.pal['border_dim']};
            border-radius: {self.pal['radius']};
            padding: 4px 8px;
        }}
        entry {{
            background-color: {self.pal['bg_bezel']};
            color: {self.pal['text_main']};
            border: 1px solid {self.pal['border_dim']};
            border-radius: {self.pal['radius']};
            padding: 4px 8px;
            font-family: 'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace;
