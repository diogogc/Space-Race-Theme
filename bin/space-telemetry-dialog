        scrollbar trough {{
            background-color: {self.pal['track_bg']};
            border: 1px solid {self.pal['border_dim']};
        }}
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def _build_ui(self):
        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.add(main_vbox)

        # 1. Header Box
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header.get_style_context().add_class("header-box")
        main_vbox.pack_start(header, False, False, 0)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_lbl = Gtk.Label()
        title_lbl.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 13' foreground='{self.pal['text_main']}'>🛰️ APOLLO SYSTEM TELEMETRY &amp; GUIDANCE CONSOLE</span>")
        title_lbl.set_xalign(0.0)

        sub_lbl = Gtk.Label()
        sub_lbl.set_markup(f"<span font_desc='JetBrainsMono Nerd Font 9.5' foreground='{self.pal['text_dim']}'>{self.collector.cpu_model} ({self.collector.num_cores} Cores)</span>")
        sub_lbl.set_xalign(0.0)

        title_box.pack_start(title_lbl, False, False, 0)
        title_box.pack_start(sub_lbl, False, False, 0)
        header.pack_start(title_box, True, True, 0)

        annun_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        
        self.status_badge = Gtk.Label()
        self.status_badge.get_style_context().add_class("stat-badge")
        self.status_badge.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 10' foreground='{self.pal['green']}'>[SYS: NOMINAL]</span>")
        annun_box.pack_start(self.status_badge, False, False, 0)

        self.interval_btn = Gtk.Button(label=f"⏱️ {self.refresh_intervals[self.cur_interval_idx]}s")
        self.interval_btn.get_style_context().add_class("action-btn")
        self.interval_btn.connect("clicked", self._cycle_interval)
        annun_box.pack_start(self.interval_btn, False, False, 0)

        header.pack_end(annun_box, False, False, 0)

        # 2. Telemetry Grid
        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        content_box.set_margin_start(12)
        content_box.set_margin_end(12)
        main_vbox.pack_start(content_box, True, True, 0)

        gauges_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        content_box.pack_start(gauges_box, False, False, 0)

        # Left Gauges
        left_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        left_box.get_style_context().add_class("telemetry-card")
        self.cpu_meter = ApolloCpuMeter(self.pal)
        self.cores_grid = ApolloCoresGrid(self.pal, self.collector.num_cores)
        left_box.pack_start(self.cpu_meter, False, False, 0)
        left_box.pack_start(self.cores_grid, False, False, 0)
        gauges_box.pack_start(left_box, True, True, 0)

        # Right Gauges
        right_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        right_box.get_style_context().add_class("telemetry-card")
        self.mem_meter = ApolloMemoryMeter(self.pal)
        right_box.pack_start(self.mem_meter, False, False, 0)

        self.disk_info_lbl = Gtk.Label()
        self.disk_info_lbl.set_xalign(0.0)
        self.disk_info_lbl.set_markup(f"<span font_desc='JetBrainsMono Nerd Font 9' foreground='{self.pal['text_sub']}'>STORAGE: Initializing telemetry recorder...</span>")
        right_box.pack_start(self.disk_info_lbl, True, True, 0)
        gauges_box.pack_start(right_box, True, True, 0)

        # 3. Process Table Card
        proc_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        proc_card.get_style_context().add_class("telemetry-card")
        content_box.pack_start(proc_card, True, True, 0)

        p_ctrl_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        p_title = Gtk.Label()
        p_title.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 10' foreground='{self.pal['text_main']}'>📋 ACTIVE FLIGHT TASKS &amp; PROCESSES</span>")
        p_ctrl_box.pack_start(p_title, False, False, 0)

        self.search_entry = Gtk.Entry()
        self.search_entry.set_placeholder_text("Filter tasks (F / /)...")
        self.search_entry.connect("changed", self._on_search_changed)
        p_ctrl_box.pack_start(self.search_entry, True, True, 0)

        self.sort_cpu_btn = Gtk.Button(label="▶ SORT: CPU%")
        self.sort_cpu_btn.get_style_context().add_class("action-btn")
        self.sort_cpu_btn.connect("clicked", lambda b: self._set_sort("cpu"))
        p_ctrl_box.pack_start(self.sort_cpu_btn, False, False, 0)

        self.sort_mem_btn = Gtk.Button(label="SORT: MEM%")
        self.sort_mem_btn.get_style_context().add_class("action-btn")
        self.sort_mem_btn.connect("clicked", lambda b: self._set_sort("mem"))
        p_ctrl_box.pack_start(self.sort_mem_btn, False, False, 0)

        proc_card.pack_start(p_ctrl_box, False, False, 0)

        self.proc_store = Gtk.ListStore(int, str, str, str, str, str)
        self.tree_view = Gtk.TreeView(model=self.proc_store)
        self.tree_view.set_headers_visible(True)

        cols = [
            ("PID", 0, 70),
            ("USER", 1, 80),
            ("CPU%", 2, 70),
            ("MEM%", 3, 70),
            ("STAT", 4, 60),
            ("COMMAND / PROCESS", 5, 260)
        ]
        for title, idx, min_w in cols:
            renderer = Gtk.CellRendererText()
            renderer.set_property("font", "JetBrainsMono Nerd Font 10")
            if idx in (0, 2, 3, 4):
                renderer.set_property("xalign", 1.0 if idx in (0, 2, 3) else 0.5)
            col = Gtk.TreeViewColumn(title, renderer, text=idx)
            col.set_min_width(min_w)
            col.set_resizable(True)
            self.tree_view.append_column(col)

        self.tree_view.get_selection().connect("changed", self._on_proc_selected)

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroller.add(self.tree_view)
        proc_card.pack_start(scroller, True, True, 0)

        p_act_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.sel_proc_lbl = Gtk.Label()
        self.sel_proc_lbl.set_markup(f"<span font_desc='JetBrainsMono Nerd Font 9.5' foreground='{self.pal['text_dim']}'>Select a process to dispatch task abort commands.</span>")
        p_act_box.pack_start(self.sel_proc_lbl, True, True, 0)

        self.kill_term_btn = Gtk.Button(label="⚠️ TERMINATE (SIGTERM)")
        self.kill_term_btn.get_style_context().add_class("action-btn")
        self.kill_term_btn.set_sensitive(False)
        self.kill_term_btn.connect("clicked", lambda b: self._kill_selected(signal.SIGTERM))
        p_act_box.pack_start(self.kill_term_btn, False, False, 0)

        self.kill_force_btn = Gtk.Button(label="⚡ FORCE ABORT (SIGKILL)")
        self.kill_force_btn.get_style_context().add_class("danger-btn")
        self.kill_force_btn.set_sensitive(False)
        self.kill_force_btn.connect("clicked", lambda b: self._kill_selected(signal.SIGKILL))
        p_act_box.pack_start(self.kill_force_btn, False, False, 0)

        proc_card.pack_start(p_act_box, False, False, 0)

        # 4. Bottom Dispatch Bar
        bottom_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bottom_bar.set_margin_start(12)
        bottom_bar.set_margin_end(12)
        bottom_bar.set_margin_bottom(10)
        main_vbox.pack_start(bottom_bar, False, False, 0)

        trim_btn = Gtk.Button(label="🧹 TRIM CACHES (T)")
        trim_btn.get_style_context().add_class("action-btn")
        trim_btn.connect("clicked", self._trim_caches)
        bottom_bar.pack_start(trim_btn, False, False, 0)

        htop_btn = Gtk.Button(label="📟 HTOP CONSOLE (H)")
        htop_btn.get_style_context().add_class("action-btn")
        htop_btn.connect("clicked", self._launch_htop)
        bottom_bar.pack_start(htop_btn, False, False, 0)

        ref_btn = Gtk.Button(label="⚡ REFRESH (R)")
        ref_btn.get_style_context().add_class("action-btn")
        ref_btn.connect("clicked", lambda b: self._update_telemetry())
        bottom_bar.pack_start(ref_btn, False, False, 0)

        close_btn = Gtk.Button(label="✕ CLOSE (ESC)")
        close_btn.get_style_context().add_class("action-btn")
        close_btn.connect("clicked", lambda b: self.destroy())
        bottom_bar.pack_end(close_btn, False, False, 0)

    def _cycle_interval(self, btn):
        self.cur_interval_idx = (self.cur_interval_idx + 1) % len(self.refresh_intervals)
        sec = self.refresh_intervals[self.cur_interval_idx]
        self.interval_btn.set_label(f"⏱️ {sec}s")
        if hasattr(self, '_timer_id') and self._timer_id:
            GLib.source_remove(self._timer_id)
        self._timer_id = GLib.timeout_add(int(sec * 1000), self._on_timer_tick)

    def _set_sort(self, sort_type):
        self.sort_by = sort_type
        self.sort_cpu_btn.set_label("▶ SORT: CPU%" if sort_type == "cpu" else "SORT: CPU%")
        self.sort_mem_btn.set_label("▶ SORT: MEM%" if sort_type == "mem" else "SORT: MEM%")
        self._update_processes()

    def _on_search_changed(self, entry):
        self.search_filter = entry.get_text().strip().lower()
        self._update_processes()

    def _on_proc_selected(self, selection):
        model, tree_iter = selection.get_selected()
        if tree_iter:
            pid = model.get_value(tree_iter, 0)
            comm = model.get_value(tree_iter, 5)
            self.selected_pid = pid
            self.selected_comm = comm
            self.sel_proc_lbl.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 9.5' foreground='{self.pal['text_main']}'>SELECTED: PID {pid} [{comm}]</span>")
            self.kill_term_btn.set_sensitive(True)
            self.kill_force_btn.set_sensitive(True)
        else:
            self.selected_pid = None
            self.selected_comm = ""
            self.sel_proc_lbl.set_markup(f"<span font_desc='JetBrainsMono Nerd Font 9.5' foreground='{self.pal['text_dim']}'>Select a process to dispatch task abort commands.</span>")
            self.kill_term_btn.set_sensitive(False)
            self.kill_force_btn.set_sensitive(False)

    def _kill_selected(self, sig):
        if not self.selected_pid:
            return
        pid = self.selected_pid
        comm = self.selected_comm
        signame = "SIGTERM" if sig == signal.SIGTERM else "SIGKILL"

        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text=f"APOLLO FLIGHT ABORT: {signame}"
        )
        dialog.format_secondary_text(f"Confirm sending {signame} to process PID {pid} ({comm})?")
        res = dialog.run()
        dialog.destroy()

        if res == Gtk.ResponseType.OK:
            try:
                os.kill(pid, sig)
                self.sel_proc_lbl.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 9.5' foreground='{self.pal['green']}'>ABORT DISPATCHED: PID {pid} ({signame})</span>")
                GLib.timeout_add(300, self._update_telemetry)
            except Exception as e:
                self.sel_proc_lbl.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 9.5' foreground='{self.pal['red']}'>ERROR: {e}</span>")

    def _trim_caches(self, btn):
        def _run_trim():
            try:
                subprocess.run(["sync"], check=True)
            except Exception:
                pass
            GLib.idle_add(self._update_telemetry)
        threading.Thread(target=_run_trim, daemon=True).start()
        self.sel_proc_lbl.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 9.5' foreground='{self.pal['green']}'>FLUSH: Filesystem sync dispatched.</span>")

    def _launch_htop(self, btn=None):
        try:
            subprocess.Popen(["kitty", "--class", "htop", "-e", "htop"])
        except Exception:
            try:
                subprocess.Popen(["x-terminal-emulator", "-e", "htop"])
            except Exception:
                pass

    def _on_timer_tick(self):
        self._update_telemetry()
        return True

    def _update_telemetry(self):
        # 1. CPU & Cores
        cpu_data = self.collector.read_cpu_and_cores()
        self.cpu_meter.update_values(cpu_data["overall"], cpu_data["temp_c"], cpu_data["freq_mhz"])
        self.cores_grid.update_cores(cpu_data["cores"])

        if cpu_data["overall"] > 85 or cpu_data["temp_c"] > 85:
            self.status_badge.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 10' foreground='{self.pal['red']}'>[SYS: CRITICAL]</span>")
        elif cpu_data["overall"] > 70 or cpu_data["temp_c"] > 70:
            self.status_badge.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 10' foreground='{self.pal['yellow']}'>[SYS: ELEVATED]</span>")
        else:
            self.status_badge.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 10' foreground='{self.pal['green']}'>[SYS: NOMINAL]</span>")

        # 2. Memory
        mem_data = self.collector.read_memory()
        self.mem_meter.update_values(mem_data["used_gb"], mem_data["cache_gb"], mem_data["total_gb"], mem_data["used_pct"])

        # 3. Storage & System Status Info
        disks = self.collector.read_storage()
        disk_str = " | ".join([f"{d['mount']}: {d['used_gb']:.1f}G/{d['total_gb']:.1f}G ({d['pct']:.0f}%)" for d in disks])
        load1, load5, load15 = cpu_data["load_avg"]
        info_markup = (
            f"<span font_desc='JetBrainsMono Nerd Font 9' foreground='{self.pal['text_sub']}'>"
            f"<b>LOAD AVG:</b> {load1:.2f}, {load5:.2f}, {load15:.2f} | <b>SWAP:</b> {mem_data['swap_used_gb']:.1f}G/{mem_data['swap_total_gb']:.1f}G\n"
            f"<b>VOLUMES:</b> {disk_str}</span>"
        )
        self.disk_info_lbl.set_markup(info_markup)

        # 4. Processes
        self._update_processes()

    def _update_processes(self):
        procs = self.collector.read_top_processes(limit=40, sort_by=self.sort_by)
        filtered = []
        for p in procs:
            if self.search_filter:
                match_str = f"{p['pid']} {p['user']} {p['comm']} {p['cmd']}".lower()
                if self.search_filter not in match_str:
                    continue
            filtered.append(p)

        cur_sel = self.selected_pid

        self.proc_store.clear()
        selected_iter = None
        for p in filtered:
            it = self.proc_store.append([
                p["pid"],
                p["user"][:8],
                f"{p['cpu']:4.1f}%",
                f"{p['mem']:4.1f}%",
                p["stat"][:3],
                p["comm"]
            ])
            if cur_sel and p["pid"] == cur_sel:
                selected_iter = it

        if selected_iter:
            self.tree_view.get_selection().select_iter(selected_iter)

    def _on_key_press(self, widget, event):
        key = Gdk.keyval_name(event.keyval)
        if key in ("Escape", "q", "Q") and not self.search_entry.is_focus():
            self.destroy()
            return True
        elif key in ("h", "H") and not self.search_entry.is_focus():
            self._launch_htop()
            return True
        elif key in ("t", "T") and not self.search_entry.is_focus():
            self._trim_caches(None)
            return True
        elif key in ("r", "R") and not self.search_entry.is_focus():
            self._update_telemetry()
            return True
        elif key in ("f", "F", "slash") and not self.search_entry.is_focus():
            self.search_entry.grab_focus()
            return True
        return False

    def _on_destroy(self, widget):
        if hasattr(self, '_timer_id') and self._timer_id:
            GLib.source_remove(self._timer_id)
        cleanup()

def main():
    check_singleton()
    signal.signal(signal.SIGINT, lambda s, f: Gtk.main_quit())
    signal.signal(signal.SIGTERM, lambda s, f: Gtk.main_quit())

    win = ApolloTelemetryDialog()
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
