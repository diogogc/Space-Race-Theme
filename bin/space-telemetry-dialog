            border-left: 2px solid {self.pal['accent']};
        }}
        treeview header button {{
            background-color: {self.pal['bg_panel']};
            color: {self.pal['text_main']};
            border: 1px solid {self.pal['border_dim']};
            font-size: 10px;
            font-weight: bold;
            padding: 4px 6px;
        }}
        scrollbar slider {{
