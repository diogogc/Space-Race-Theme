#!/usr/bin/env python3
"""
Apollo Mission Control / Space Race Alt+Tab Window Switcher
Fast, aesthetic GTK3 Layer-Shell modal for cycling running windows in Hyprland.
Zero-White-Background compliant, supports all 4 Space Mission Themes.
"""

