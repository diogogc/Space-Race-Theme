#!/usr/bin/env python3
"""
Apollo Command Module Vertical Needle Indicators & Power Telemetry Console
Inspired by Apollo CM Main Display Console (MDC) vertical edgewise meters.
Zero white backgrounds — pure dark chassis, phosphor glows, and precision mechanical needles.
"""
import sys, os, subprocess, signal, math, time, re
import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk, GLib
import cairo

PID_FILE = f"/tmp/space-energy-dialog-{os.getuid()}.pid"

def get_session_object_path():
    try:
        user = os.environ.get('USER', 'diogo')
        out = subprocess.check_output(['loginctl', '--no-legend'], text=True).strip()
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 3 and parts[2] == user:
                sid = parts[0]
                gout = subprocess.check_output([
                    'gdbus', 'call', '--system', '--dest', 'org.freedesktop.login1',
                    '--object-path', '/org/freedesktop/login1',
                    '--method', 'org.freedesktop.login1.Manager.GetSession', sid
                ], text=True)
                m = re.search(r"'([^']+)'", gout)
                if m:
                    return m.group(1)
    except Exception:
        pass
    return '/org/freedesktop/login1/session/auto'

def get_brightness_stats():
    path = '/sys/class/backlight/intel_backlight'
    if not os.path.exists(path):
        base = '/sys/class/backlight'
        if os.path.exists(base) and os.listdir(base):
            path = os.path.join(base, os.listdir(base)[0])
    max_b = 1515
    cur_b = 600
    subsys = 'backlight'
    dev = 'intel_backlight'
    if os.path.exists(path):
        dev = os.path.basename(path)
        try:
            with open(f'{path}/max_brightness') as f: max_b = int(f.read().strip())
            with open(f'{path}/brightness') as f: cur_b = int(f.read().strip())
        except Exception:
            pass
    return subsys, dev, cur_b, max_b

def set_screen_brightness(pct, session_path=None):
    subsys, dev, cur_b, max_b = get_brightness_stats()
    raw_val = int((pct / 100.0) * max_b)
    raw_val = max(1, min(max_b, raw_val))
    if not session_path:
        session_path = get_session_object_path()
    
    cmd = [
        'gdbus', 'call', '--system', '--dest', 'org.freedesktop.login1',
        '--object-path', session_path,
        '--method', 'org.freedesktop.login1.Session.SetBrightness',
        subsys, dev, str(raw_val)
    ]
    subprocess.Popen(cmd)


