def get_theme_name():
    path = os.path.expanduser("~/.config/themes/current_theme")
    if os.path.exists(path):
        try:
            with open(path, "r") as f:
                t = f.read().strip()
                if t in THEMES:
                    return t
        except Exception:
            pass
    return "nasa"

def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip('#')
    return tuple(int(hex_str[i:i+2], 16)/255.0 for i in (0, 2, 4))

def check_singleton():
    my_pid = os.getpid()
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                old_pid = int(f.read().strip())
            if old_pid != my_pid:
                try:
                    os.kill(old_pid, 0)
                    os.kill(old_pid, signal.SIGTERM)
                    try:
                        os.remove(PID_FILE)
                    except OSError:
                        pass
                    sys.exit(0)
                except OSError:
                    pass
        except Exception:
            pass

    try:
        with open(PID_FILE, "w") as f:
            f.write(str(my_pid))
    except Exception:
        pass

def cleanup():
    try:
        if os.path.exists(PID_FILE):
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            if pid == os.getpid():
                os.remove(PID_FILE)
    except Exception:
        pass

def play_quindar_tone():
    """Generate and play a classic 2524 Hz Apollo Quindar intro beep."""
    wav_path = "/tmp/apollo_quindar.wav"
    if not os.path.exists(wav_path):
        sample_rate = 44100
        duration = 0.22  # 220ms
        freq = 2524.0    # Apollo Quindar intro frequency
        num_samples = int(sample_rate * duration)
        
        with wave.open(wav_path, "w") as wf:
            wf.setnchannels(1)
            wf.setsampwidth(2)
            wf.setframerate(sample_rate)
            for i in range(num_samples):
                env = math.sin(math.pi * i / num_samples)
                val = int(32767.0 * 0.45 * env * math.sin(2.0 * math.pi * freq * i / sample_rate))
                data = struct.pack("<h", val)
                wf.writeframesraw(data)

    def _worker():
        if os.path.exists("/usr/bin/pw-play"):
            subprocess.run(["pw-play", wav_path], capture_output=True)
        elif os.path.exists("/usr/bin/paplay"):
            subprocess.run(["paplay", wav_path], capture_output=True)

    threading.Thread(target=_worker, daemon=True).start()

class ApolloAudioMeter(Gtk.DrawingArea):
    def __init__(self, pal, title="MASTER OUTPUT (RX)"):
        super().__init__()
        self.set_size_request(300, 56)
        self.pal = pal
        self.title = title
        self.volume_pct = 70
        self.is_muted = False
        self.connect("draw", self.on_draw)

    def set_level(self, pct, muted=False):
        self.volume_pct = max(0, min(100, int(pct)))
        self.is_muted = muted
        self.queue_draw()

    def on_draw(self, widget, cr):
        width = self.get_allocated_width()
        height = self.get_allocated_height()

        cr.save()
        bez_r, bez_g, bez_b = hex_to_rgb(self.pal["bg_bezel"])
        cr.set_source_rgb(bez_r, bez_g, bez_b)
        cr.rectangle(2, 2, width - 4, height - 4)
        cr.fill()

        bord_r, bord_g, bord_b = hex_to_rgb(self.pal["border_dim"])
        cr.set_source_rgb(bord_r, bord_g, bord_b)
        cr.set_line_width(1.5)
        cr.rectangle(2, 2, width - 4, height - 4)
        cr.stroke()

        acc_r, acc_g, acc_b = hex_to_rgb(self.pal["text_main"])
        grn_r, grn_g, grn_b = hex_to_rgb(self.pal["green"])
        yel_r, yel_g, yel_b = hex_to_rgb(self.pal["yellow"])
        red_r, red_g, red_b = hex_to_rgb(self.pal["red"])

        cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.2)
        cr.set_source_rgb(acc_r, acc_g, acc_b)
        cr.move_to(8, 14)
        cr.show_text(self.title)

        if self.is_muted:
            status_txt = "MUTED"
            col_r, col_g, col_b = red_r, red_g, red_b
        else:
            status_txt = f"{self.volume_pct}%"
            col_r, col_g, col_b = (grn_r, grn_g, grn_b) if self.volume_pct <= 80 else (yel_r, yel_g, yel_b)

        cr.set_font_size(8.5)
        cr.set_source_rgb(col_r, col_g, col_b)
        ext = cr.text_extents(status_txt)
        cr.move_to(width - 8 - ext.width, 14)
        cr.show_text(status_txt)

        # Track background
        track_x = 8
        track_y = 20
        track_w = width - 16
        track_h = 16

        tr_r, tr_g, tr_b = hex_to_rgb(self.pal["track_bg"])
        cr.set_source_rgb(tr_r, tr_g, tr_b)
        cr.rectangle(track_x, track_y, track_w, track_h)
        cr.fill()

        cr.set_source_rgba(bord_r, bord_g, bord_b, 0.8)
        cr.set_line_width(1.0)
        cr.rectangle(track_x, track_y, track_w, track_h)
        cr.stroke()

        if not self.is_muted and self.volume_pct > 0:
            num_bars = int((self.volume_pct / 100.0) * 24)
            bar_spacing = (track_w - 4) / 24.0

            for b in range(num_bars):
                bx = track_x + 2 + b * bar_spacing
                bw = max(2.0, bar_spacing - 1.5)
                
                if b < 16:
                    cr.set_source_rgba(grn_r, grn_g, grn_b, 0.9)
                elif b < 20:
                    cr.set_source_rgba(yel_r, yel_g, yel_b, 0.9)
                else:
                    cr.set_source_rgba(red_r, red_g, red_b, 0.95)
                    
                cr.rectangle(bx, track_y + 2, bw, track_h - 4)
                cr.fill()

        # Calibration scale
        for i in range(11):
            tx = track_x + (i / 10.0) * track_w
            is_major = (i % 5 == 0)
            tick_len = 4 if is_major else 2
            cr.set_source_rgba(acc_r, acc_g, acc_b, 0.7 if is_major else 0.35)
            cr.set_line_width(1.0)
            cr.move_to(tx, track_y + track_h + 1)
            cr.line_to(tx, track_y + track_h + 1 + tick_len)
            cr.stroke()

            if is_major:
                val_str = f"{i*10}"
                cr.set_font_size(6.0)
                vext = cr.text_extents(val_str)
                cr.move_to(tx - vext.width / 2.0, track_y + track_h + 11)
                cr.show_text(val_str)

        cr.restore()
        return False

class ApolloLiveMicVuMeter(Gtk.DrawingArea):
    """Real-Time Live Transducer / Mic VU Meter with RMS, Peak Level & Peak Hold Indicator"""
    def __init__(self, pal):
        super().__init__()
        self.set_size_request(300, 68)
        self.pal = pal
        self.rms_db = -60.0
        self.peak_db = -60.0
        self.peak_hold_db = -60.0
        self.peak_hold_time = 0.0
        self.is_muted = False
        self.connect("draw", self.on_draw)

    def update_levels(self, rms_db, peak_db, is_muted=False):
        self.is_muted = is_muted
        self.rms_db = rms_db
        self.peak_db = peak_db

        # Peak Hold decay logic
        now = time.time()
        if peak_db >= self.peak_hold_db:
            self.peak_hold_db = peak_db
            self.peak_hold_time = now
        elif now - self.peak_hold_time > 0.65:
            self.peak_hold_db = max(-60.0, self.peak_hold_db - 1.8)

        self.queue_draw()

    def db_to_pct(self, db):
        # Map -48 dB to 0%, 0 dB (Nominal) to 86%, +3 dB (Peak) to 100%
        if db <= -48.0:
            return 0.0
        elif db <= 0.0:
            return ((db + 48.0) / 48.0) * 86.0
        else:
            return 86.0 + (min(3.0, db) / 3.0) * 14.0

    def on_draw(self, widget, cr):
        width = self.get_allocated_width()
        height = self.get_allocated_height()

        cr.save()
        bez_r, bez_g, bez_b = hex_to_rgb(self.pal["bg_bezel"])
        cr.set_source_rgb(bez_r, bez_g, bez_b)
        cr.rectangle(2, 2, width - 4, height - 4)
        cr.fill()

        bord_r, bord_g, bord_b = hex_to_rgb(self.pal["border_dim"])
        cr.set_source_rgb(bord_r, bord_g, bord_b)
        cr.set_line_width(1.5)
        cr.rectangle(2, 2, width - 4, height - 4)
        cr.stroke()

        acc_r, acc_g, acc_b = hex_to_rgb(self.pal["text_main"])
        grn_r, grn_g, grn_b = hex_to_rgb(self.pal["green"])
        yel_r, yel_g, yel_b = hex_to_rgb(self.pal["yellow"])
        red_r, red_g, red_b = hex_to_rgb(self.pal["red"])

        cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.0)
        cr.set_source_rgb(acc_r, acc_g, acc_b)
        cr.move_to(8, 14)
        cr.show_text("LIVE MIC VU METER (TX TRANSDUCER)")

        if self.is_muted:
            status_txt = "MUTED"
            col_r, col_g, col_b = red_r, red_g, red_b
        elif self.peak_db > 0.0:
            status_txt = f"+{self.peak_db:.1f} dB [CLIP]"
            col_r, col_g, col_b = red_r, red_g, red_b
        elif self.rms_db > -42.0:
            status_txt = f"{self.rms_db:.1f} dB [LIVE]"
            col_r, col_g, col_b = grn_r, grn_g, grn_b
        else:
            status_txt = "SILENT"
            col_r, col_g, col_b = hex_to_rgb(self.pal["text_dim"])

        cr.set_font_size(8.0)
        cr.set_source_rgb(col_r, col_g, col_b)
        ext = cr.text_extents(status_txt)
        cr.move_to(width - 8 - ext.width, 14)
        cr.show_text(status_txt)

        # Track background
        track_x = 8
        track_y = 20
        track_w = width - 16
        track_h = 18

        tr_r, tr_g, tr_b = hex_to_rgb(self.pal["track_bg"])
        cr.set_source_rgb(tr_r, tr_g, tr_b)
        cr.rectangle(track_x, track_y, track_w, track_h)
        cr.fill()

        cr.set_source_rgba(bord_r, bord_g, bord_b, 0.8)
        cr.set_line_width(1.0)
        cr.rectangle(track_x, track_y, track_w, track_h)
        cr.stroke()

        if not self.is_muted and self.rms_db > -48.0:
            rms_pct = self.db_to_pct(self.rms_db)
            peak_pct = self.db_to_pct(self.peak_db)
            hold_pct = self.db_to_pct(self.peak_hold_db)

            num_bars = 28
            bar_spacing = (track_w - 4) / float(num_bars)
            active_rms_bars = int((rms_pct / 100.0) * num_bars)
            active_peak_bars = int((peak_pct / 100.0) * num_bars)

            for b in range(num_bars):
                bx = track_x + 2 + b * bar_spacing
                bw = max(2.0, bar_spacing - 1.5)

                if b < 18:
                    c_r, c_g, c_b = grn_r, grn_g, grn_b
                elif b < 24:
                    c_r, c_g, c_b = yel_r, yel_g, yel_b
                else:
                    c_r, c_g, c_b = red_r, red_g, red_b

                # Render active bar (RMS solid, Peak transparent glow)
                if b <= active_rms_bars:
                    cr.set_source_rgba(c_r, c_g, c_b, 0.95)
                    cr.rectangle(bx, track_y + 2, bw, track_h - 4)
                    cr.fill()
                elif b <= active_peak_bars:
                    cr.set_source_rgba(c_r, c_g, c_b, 0.45)
                    cr.rectangle(bx, track_y + 4, bw, track_h - 8)
                    cr.fill()

            # Render Peak Hold Line
            if hold_pct > 0:
                hx = track_x + 2 + (hold_pct / 100.0) * (track_w - 4)
                cr.set_source_rgba(red_r if self.peak_hold_db >= 0 else yel_r,
                                   red_g if self.peak_hold_db >= 0 else yel_g,
                                   red_b if self.peak_hold_db >= 0 else yel_b, 1.0)
                cr.set_line_width(2.0)
                cr.move_to(hx, track_y + 1)
                cr.line_to(hx, track_y + track_h - 1)
                cr.stroke()

        # Calibration scale (-48, -36, -24, -12, -6, 0, +3 dB)
        scale_dbs = [(-48, "-48"), (-36, "-36"), (-24, "-24"), (-12, "-12"), (-6, "-6"), (0, "0"), (3, "+3")]
        for db_val, lbl_str in scale_dbs:
            pct = self.db_to_pct(db_val)
            tx = track_x + 2 + (pct / 100.0) * (track_w - 4)
            is_0 = (db_val == 0)

            cr.set_source_rgba(red_r if db_val > 0 else (acc_r if is_0 else grn_r), 
                               red_g if db_val > 0 else (acc_g if is_0 else grn_g), 
                               red_b if db_val > 0 else (acc_b if is_0 else grn_b), 0.7 if is_0 else 0.4)
            cr.set_line_width(1.0)
            cr.move_to(tx, track_y + track_h + 1)
            cr.line_to(tx, track_y + track_h + (5 if is_0 else 3))
            cr.stroke()

            cr.set_font_size(5.8)
            vext = cr.text_extents(lbl_str)
            cr.move_to(tx - vext.width / 2.0, track_y + track_h + 12)
            cr.show_text(lbl_str)

        cr.restore()
        return False

class SpaceCapcomDialog(Gtk.Window):
    def __init__(self):
        super().__init__(title="Apollo Mission Control CAPCOM Audio & Intercom")
        self.set_wmclass("space-capcom-dialog", "space-capcom-dialog")
        self.set_role("dialog")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_default_size(740, 600)

        self.theme_name = get_theme_name()
        self.pal = THEMES.get(self.theme_name, THEMES["nasa"])

        self.sink_vol = 70
        self.sink_muted = False
        self.source_vol = 100
        self.source_muted = False
        self.sinks = []
        self.sources = []
        self.updating_sliders = False

        self.is_monitoring = False
        self.loopback_proc = None
        self.mic_capture_proc = None
        self.mic_capture_running = True

        self.displayed_rms = -60.0
        self.displayed_peak = -60.0

        self.apply_css()
        self.build_ui()
        self.connect("key-press-event", self.on_key_press)

        self.update_audio_status()
        GLib.timeout_add(1500, self.update_audio_status)

        # Start live microphone PCM monitor thread
        self.start_live_mic_capture()

    def apply_css(self):
        css = f"""
        * {{
            font-family: 'JetBrainsMono Nerd Font', monospace;
            background-color: transparent;
        }}
        window {{
            background-color: {self.pal['bg']};
            border: 2px solid {self.pal['border']};
            border-radius: {self.pal['radius']};
        }}
        .header-box {{
            background-color: {self.pal['bg_panel']};
            border-bottom: 2px solid {self.pal['border']};
            padding: 10px 18px;
        }}
        .telemetry-card {{
            background-color: {self.pal['bg_panel']};
            border: 1px solid {self.pal['border_dim']};
            border-radius: {self.pal['radius']};
            padding: 10px 14px;
        }}
        .audio-card {{
            background-color: {self.pal['bg_panel']};
            border: 1px solid {self.pal['border_dim']};
            border-radius: {self.pal['radius']};
            padding: 8px 12px;
            margin-bottom: 6px;
        }}
        .audio-card.active {{
            border: 1.5px solid {self.pal['green']};
        }}
        button,
        button.action-btn {{
            background-image: none;
            background-color: {self.pal['btn_bg']};
            border: 1px solid {self.pal['btn_border']};
            border-radius: {self.pal['radius']};
            padding: 5px 9px;
            box-shadow: none;
            text-shadow: none;
        }}
        button.action-btn:hover {{
            background-color: {self.pal['btn_hover']};
            border: 1px solid {self.pal['accent']};
        }}
        button.connect-btn {{
            background-color: {self.pal['btn_bg']};
            border: 1px solid {self.pal['accent']};
            border-radius: {self.pal['radius']};
            padding: 4px 9px;
        }}
        button.connect-btn:hover {{
            background-color: {self.pal['btn_hover']};
        }}
        button.disconnect-btn {{
            background-color: {self.pal['btn_bg']};
            border: 1px solid {self.pal['red']};
            border-radius: {self.pal['radius']};
            padding: 4px 9px;
        }}
        button.disconnect-btn:hover {{
            background-color: #3b1111;
        }}
        scale trough {{
            background-color: {self.pal['track_bg']};
            border: 1px solid {self.pal['border_dim']};
            border-radius: 2px;
            min-height: 8px;
        }}
        scale highlight {{
            background-color: {self.pal['accent']};
            border-radius: 2px;
        }}
        scale slider {{
            background-color: {self.pal['text_main']};
            border: 1px solid {self.pal['border']};
            border-radius: 2px;
            min-width: 14px;
            min-height: 18px;
        }}
        scrollbar slider {{
            background-color: {self.pal['accent']};
            border-radius: 2px;
            min-width: 6px;
        }}
        scrollbar trough {{
            background-color: {self.pal['track_bg']};
        }}
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def build_ui(self):
        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        # Header Box
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.get_style_context().add_class("header-box")

        title = Gtk.Label()
        title.set_markup(f"<span font_weight='bold' font_size='11000' foreground='{self.pal['text_main']}'>🎙️ APOLLO MISSION CONTROL // CAPCOM AUDIO &amp; INTERCOM</span>")
        title.set_xalign(0.0)
        header.pack_start(title, False, False, 0)

        sub = Gtk.Label()
        sub.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>CAPSULE COMMUNICATOR, LIVE VU TRANSDUCER &amp; WIREPLUMBER ROUTING // {self.theme_name.upper()}</span>")
        sub.set_xalign(0.0)
        header.pack_start(sub, False, False, 0)
        main_vbox.pack_start(header, False, False, 0)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        body.set_margin_top(10)
        body.set_margin_bottom(10)
        body.set_margin_left(14)
        body.set_margin_right(14)

        # Top Control Area: Output & Input Sliders + Cairo Meters
        meters_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        meters_box.set_homogeneous(True)

        # Left Card: Output / Speaker
        card_out = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
