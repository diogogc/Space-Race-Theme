        self.add(main_vbox)

    def start_live_mic_capture(self):
        def _capture_loop():
            try:
                self.mic_capture_proc = subprocess.Popen(
                    ["parec", "--rate=16000", "--channels=1", "--format=s16le", "--latency=512"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL
                )
                chunk_size = 512 * 2  # 512 samples = 32ms frame

                while self.mic_capture_running and self.mic_capture_proc.poll() is None:
                    raw = self.mic_capture_proc.stdout.read(chunk_size)
                    if len(raw) < chunk_size:
                        time.sleep(0.02)
                        continue

                    count = len(raw) // 2
                    shorts = struct.unpack(f"<{count}h", raw)
                    max_sample = max(abs(s) for s in shorts) if count > 0 else 0
                    sum_sq = sum(s * s for s in shorts)
                    rms = math.sqrt(sum_sq / count) if count > 0 else 0

                    if self.source_muted:
                        cur_rms_db = -60.0
                        cur_peak_db = -60.0
                    else:
                        cur_rms_db = 20.0 * math.log10(rms / 32767.0) if rms > 1.0 else -60.0
                        cur_peak_db = 20.0 * math.log10(max_sample / 32767.0) if max_sample > 1 else -60.0

                    # Attack and decay smoothing physics
                    if cur_rms_db > self.displayed_rms:
                        self.displayed_rms = cur_rms_db  # fast attack
                    else:
                        self.displayed_rms = max(-60.0, self.displayed_rms * 0.92 + cur_rms_db * 0.08)  # smooth decay

                    if cur_peak_db > self.displayed_peak:
                        self.displayed_peak = cur_peak_db
                    else:
                        self.displayed_peak = max(-60.0, self.displayed_peak * 0.88 + cur_peak_db * 0.12)

                    def _update(r_db=self.displayed_rms, p_db=self.displayed_peak, m=self.source_muted):
                        self.live_vu_meter.update_levels(r_db, p_db, is_muted=m)

                    GLib.idle_add(_update)
                    time.sleep(0.018)  # ~50 FPS refresh

            except Exception as e:
                pass

        threading.Thread(target=_capture_loop, daemon=True).start()

    def toggle_sidetone_loopback(self):
        if self.is_monitoring:
            self.is_monitoring = False
            if self.loopback_proc and self.loopback_proc.poll() is None:
                self.loopback_proc.terminate()
                self.loopback_proc = None
            self.lbl_btn_loopback.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['text_sub']}'>[ SIDETONE: OFF ]</span>")
            subprocess.run([
                "notify-send", "-t", "2500",
                "CAPCOM SIDETONE DISENGAGED",
                "Live mic loopback monitor stopped."
            ])
        else:
            self.is_monitoring = True
            try:
                self.loopback_proc = subprocess.Popen(
                    ["pw-loopback", "--latency=20"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
            except Exception:
                pass
            self.lbl_btn_loopback.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['green']}'>[ SIDETONE: ACTIVE ]</span>")
            subprocess.run([
                "notify-send", "-t", "3000",
                "CAPCOM SIDETONE ENGAGED",
                "Live mic loopback active. Speak into mic to test audio feedback."
            ])

    def on_sink_slider_changed(self, scale):
        if self.updating_sliders:
            return
        val = int(scale.get_value())
        self.set_sink_volume(val)

    def on_source_slider_changed(self, scale):
        if self.updating_sliders:
            return
        val = int(scale.get_value())
        self.set_source_volume(val)

    def set_sink_volume(self, val):
        val = max(0, min(100, val))
        self.sink_vol = val
        self.meter_sink.set_level(val, self.sink_muted)
        
        self.updating_sliders = True
        self.slider_sink.set_value(val)
        self.updating_sliders = False

        def _worker():
            dec_val = val / 100.0
            subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{dec_val:.2f}"])

        threading.Thread(target=_worker, daemon=True).start()

    def set_source_volume(self, val):
        val = max(0, min(100, val))
        self.source_vol = val

        self.updating_sliders = True
        self.slider_source.set_value(val)
        self.updating_sliders = False

        def _worker():
            dec_val = val / 100.0
            subprocess.run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SOURCE@", f"{dec_val:.2f}"])

        threading.Thread(target=_worker, daemon=True).start()

    def toggle_sink_mute(self):
        def _worker():
            subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"])
            GLib.idle_add(self.update_audio_status)

        threading.Thread(target=_worker, daemon=True).start()

    def toggle_source_mute(self):
        def _worker():
            subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"])
            GLib.idle_add(self.update_audio_status)

        threading.Thread(target=_worker, daemon=True).start()

    def set_default_device(self, dev_id, is_source=False):
        def _worker():
            subprocess.run(["wpctl", "set-default", str(dev_id)])
            GLib.idle_add(self.update_audio_status)

        threading.Thread(target=_worker, daemon=True).start()

    def update_audio_status(self):
        def _fetch():
            out = subprocess.run(["wpctl", "status"], capture_output=True, text=True).stdout
            sinks = []
            sources = []
            
            in_sinks = False
            in_sources = False
            
            for line in out.splitlines():
                if "Sinks:" in line:
                    in_sinks = True
                    in_sources = False
                    continue
                elif "Sources:" in line:
                    in_sinks = False
                    in_sources = True
                    continue
                elif in_sinks and ("Filters:" in line or "Streams:" in line or "Devices:" in line or not line.strip().startswith(("│", "├", "└"))):
                    in_sinks = False
                elif in_sources and ("Filters:" in line or "Streams:" in line or "Devices:" in line or "Video" in line or not line.strip().startswith(("│", "├", "└"))):
                    in_sources = False
                    
                m = re.search(r"([*]?)\s+(\d+)\.\s+(.+?)\s+\[vol:\s*([0-9.]+)(?:\s+(MUTED))?\]", line)
                if m:
                    is_default = (m.group(1) == "*")
                    id_num = m.group(2)
                    name = m.group(3).strip()
                    vol = float(m.group(4))
                    muted = (m.group(5) == "MUTED")
                    item = {"id": id_num, "name": name, "vol": vol, "muted": muted, "default": is_default}
                    if in_sinks: sinks.append(item)
                    elif in_sources: sources.append(item)

            # Direct default queries
            sink_vol_out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True).stdout
            m_svol = re.search(r"Volume:\s*([0-9.]+)(?:\s*\[(MUTED)\])?", sink_vol_out)
            cur_sink_vol = int(float(m_svol.group(1)) * 100) if m_svol else 70
            cur_sink_muted = bool(m_svol and m_svol.group(2) == "MUTED")

            source_vol_out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@"], capture_output=True, text=True).stdout
            m_srcvol = re.search(r"Volume:\s*([0-9.]+)(?:\s*\[(MUTED)\])?", source_vol_out)
            cur_source_vol = int(float(m_srcvol.group(1)) * 100) if m_srcvol else 100
            cur_source_muted = bool(m_srcvol and m_srcvol.group(2) == "MUTED")

            return {
                "sink_vol": cur_sink_vol,
                "sink_muted": cur_sink_muted,
                "source_vol": cur_source_vol,
                "source_muted": cur_source_muted,
                "sinks": sinks,
                "sources": sources
            }

        def _apply(res):
            self.sink_vol = res["sink_vol"]
            self.sink_muted = res["sink_muted"]
            self.source_vol = res["source_vol"]
            self.source_muted = res["source_muted"]
            self.sinks = res["sinks"]
            self.sources = res["sources"]

            # Update Sliders
            self.updating_sliders = True
            self.slider_sink.set_value(self.sink_vol)
            self.slider_source.set_value(self.source_vol)
            self.updating_sliders = False

            # Update Meters
            self.meter_sink.set_level(self.sink_vol, self.sink_muted)

            # Update Mute Button text
            s_col = self.pal['red'] if self.sink_muted else self.pal['green']
            s_txt = "ON" if self.sink_muted else "OFF"
            self.lbl_btn_mute_sink.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{s_col}'>[ MUTE: {s_txt} ]</span>")

            src_col = self.pal['red'] if self.source_muted else self.pal['green']
            src_txt = "MUTED" if self.source_muted else "ON"
            self.lbl_btn_mute_source.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{src_col}'>[ MIC: {src_txt} ]</span>")

            # Render Sinks List
            for child in self.sinks_list_box.get_children():
                self.sinks_list_box.remove(child)

            if not res["sinks"]:
                empty = Gtk.Label()
                empty.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>No active sink endpoints.</span>")
                self.sinks_list_box.pack_start(empty, True, True, 0)
            else:
                for s in res["sinks"]:
                    card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                    card.get_style_context().add_class("audio-card")
                    if s["default"]:
                        card.get_style_context().add_class("active")

                    info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                    card.pack_start(info, True, True, 0)

                    t_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                    lbl_n = Gtk.Label()
                    lbl_n.set_markup(f"<span font_weight='bold' font_size='8800' foreground='{self.pal['text_main']}'>{s['name']}</span>")
                    lbl_n.set_xalign(0.0)
                    t_box.pack_start(lbl_n, False, False, 0)

                    if s["default"]:
                        lbl_act = Gtk.Label()
                        lbl_act.set_markup(f"<span font_weight='bold' font_size='7200' foreground='{self.pal['green']}'>[ ACTIVE ]</span>")
                        t_box.pack_start(lbl_act, False, False, 0)

                    info.pack_start(t_box, False, False, 0)

                    sub = Gtk.Label()
                    vol_pct = int(s['vol'] * 100)
                    sub.set_markup(f"<span font_size='7200' foreground='{self.pal['text_dim']}'>ID: {s['id']} | LEVEL: {vol_pct}%</span>")
                    sub.set_xalign(0.0)
                    info.pack_start(sub, False, False, 0)

                    if not s["default"]:
                        btn_set = Gtk.Button()
                        btn_set.get_style_context().add_class("connect-btn")
                        lbl_b = Gtk.Label()
                        lbl_b.set_markup(f"<span font_weight='bold' font_size='7500' foreground='{self.pal['accent']}'>ENGAGE</span>")
                        btn_set.add(lbl_b)
                        btn_set.connect("clicked", lambda w, dev_id=s['id']: self.set_default_device(dev_id, False))
                        card.pack_end(btn_set, False, False, 0)

                    self.sinks_list_box.pack_start(card, False, False, 0)

            # Render Sources List
            for child in self.sources_list_box.get_children():
                self.sources_list_box.remove(child)

            if not res["sources"]:
                empty = Gtk.Label()
                empty.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>No active source endpoints.</span>")
                self.sources_list_box.pack_start(empty, True, True, 0)
            else:
                for src in res["sources"]:
                    card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                    card.get_style_context().add_class("audio-card")
                    if src["default"]:
                        card.get_style_context().add_class("active")

                    info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                    card.pack_start(info, True, True, 0)

                    t_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                    lbl_n = Gtk.Label()
                    lbl_n.set_markup(f"<span font_weight='bold' font_size='8800' foreground='{self.pal['text_main']}'>{src['name']}</span>")
                    lbl_n.set_xalign(0.0)
                    t_box.pack_start(lbl_n, False, False, 0)

                    if src["default"]:
                        lbl_act = Gtk.Label()
                        lbl_act.set_markup(f"<span font_weight='bold' font_size='7200' foreground='{self.pal['green']}'>[ ACTIVE ]</span>")
                        t_box.pack_start(lbl_act, False, False, 0)

                    info.pack_start(t_box, False, False, 0)

                    sub = Gtk.Label()
                    vol_pct = int(src['vol'] * 100)
                    sub.set_markup(f"<span font_size='7200' foreground='{self.pal['text_dim']}'>ID: {src['id']} | LEVEL: {vol_pct}%</span>")
                    sub.set_xalign(0.0)
                    info.pack_start(sub, False, False, 0)

                    if not src["default"]:
                        btn_set = Gtk.Button()
                        btn_set.get_style_context().add_class("connect-btn")
                        lbl_b = Gtk.Label()
                        lbl_b.set_markup(f"<span font_weight='bold' font_size='7500' foreground='{self.pal['accent']}'>ENGAGE</span>")
                        btn_set.add(lbl_b)
                        btn_set.connect("clicked", lambda w, dev_id=src['id']: self.set_default_device(dev_id, True))
                        card.pack_end(btn_set, False, False, 0)

                    self.sources_list_box.pack_start(card, False, False, 0)

            self.sinks_list_box.show_all()
            self.sources_list_box.show_all()

        def _worker():
            try:
                res = _fetch()
                GLib.idle_add(_apply, res)
            except Exception as e:
                print("Error fetching audio status:", e, file=sys.stderr)

        threading.Thread(target=_worker, daemon=True).start()
        return True

    def on_key_press(self, widget, event):
        keyname = Gdk.keyval_name(event.keyval)

        if keyname in ["Escape", "q", "Q"]:
            self.close_window()
            return True
        elif keyname in ["m", "M"]:
            self.toggle_sink_mute()
            return True
        elif keyname in ["n", "N"]:
            self.toggle_source_mute()
            return True
        elif keyname in ["l", "L"]:
            self.toggle_sidetone_loopback()
            return True
        elif keyname in ["t", "T"]:
            play_quindar_tone()
            return True
        elif keyname in ["1"]:
            self.set_sink_volume(30)
            return True
        elif keyname in ["2"]:
            self.set_sink_volume(50)
            return True
        elif keyname in ["3"]:
            self.set_sink_volume(70)
            return True
        elif keyname in ["4"]:
            self.set_sink_volume(100)
            return True
        elif keyname in ["0"]:
            self.set_sink_volume(0)
            return True
        elif keyname in ["Up", "k", "K", "plus", "equal"]:
            self.set_sink_volume(self.sink_vol + 5)
            return True
        elif keyname in ["Down", "j", "J", "minus"]:
            self.set_sink_volume(self.sink_vol - 5)
            return True

        return False

    def close_window(self):
        self.mic_capture_running = False
        if self.mic_capture_proc and self.mic_capture_proc.poll() is None:
            self.mic_capture_proc.terminate()
        if self.loopback_proc and self.loopback_proc.poll() is None:
            self.loopback_proc.terminate()
        cleanup()
        self.hide()
        Gtk.main_quit()

def main():
    check_singleton()
    win = SpaceCapcomDialog()
    win.connect("destroy", lambda w: (win.close_window()))
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
