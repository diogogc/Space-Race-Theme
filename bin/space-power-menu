def get_theme_name():
    path = os.path.expanduser("~/.config/themes/current_theme")
    if os.path.exists(path):
        try:
            with open(path, "r") as f:
                t = f.read().strip()
                if t in THEMES:
                    return t
        except Exception:
            pass
    return "nasa"

ACTIONS = [
    {
        "key": "1",
        "hotkey": "s",
        "code": "01",
        "title": "MISSION ABORT // SHUTDOWN",
        "sub": "De-energize telemetry &amp; complete system power off",
        "cmd": ["systemctl", "poweroff"],
        "urgent": True,
        "confirm": True
    },
    {
        "key": "2",
        "hotkey": "r",
        "code": "02",
        "title": "STAGE RE-IGNITION // REBOOT",
        "sub": "Restart flight computer &amp; reload kernel telemetry",
        "cmd": ["systemctl", "reboot"],
        "urgent": False,
        "confirm": True
    },
    {
        "key": "3",
        "hotkey": "u",
        "code": "03",
        "title": "ORBITAL STANDBY // SUSPEND",
        "sub": "Low-power sleep state with memory retention",
        "cmd": ["systemctl", "suspend"],
        "urgent": False,
        "confirm": False
    },
    {
        "key": "4",
