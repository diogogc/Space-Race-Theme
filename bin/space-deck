    def create_profiles_tab(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        vbox.set_margin_top(2)
        vbox.set_margin_bottom(2)
        vbox.set_margin_start(12)
        vbox.set_margin_end(12)

        profiles = [
            ("CODING", "🚀 COMMAND DECK / WORKSTATION", "All pointers and touchpads enabled • Natural scrolling ON • Multi-layout active."),
            ("GAMING", "🎯 COMBAT / FPS GAMING", "Flat raw 1:1 acceleration profile • Laptop touchpad ISOLATED • 0 sensitivity bias."),
            ("SIM", "✈️ ORBITAL SIM / FLIGHT HOTAS", "Flight sticks &amp; rudders unmasked • Smoothed mouse curves • Clickpad isolated.")
        ]

        for p_id, p_title, p_desc in profiles:
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            card.get_style_context().add_class("telemetry-card")

            row_top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            lbl_t = Gtk.Label()
            lbl_t.set_markup(f"<span font_weight='bold' font_size='9000' foreground='{self.pal['text_main']}'>{p_title}</span>")
            lbl_t.set_xalign(0.0)
            row_top.pack_start(lbl_t, True, True, 0)

            btn_apply = Gtk.Button(label=f"[ ENGAGE {p_id} ]")
            btn_apply.get_style_context().add_class("action-btn")
            btn_apply.connect("clicked", self.on_apply_profile, p_id)
            row_top.pack_end(btn_apply, False, False, 0)
            card.pack_start(row_top, False, False, 0)

            lbl_d = Gtk.Label()
            lbl_d.set_markup(f"<span font_size='7500' foreground='{self.pal['text_dim']}'>{p_desc}</span>")
            lbl_d.set_xalign(0.0)
            card.pack_start(lbl_d, False, False, 0)
            vbox.pack_start(card, False, False, 0)

        return vbox

    # --------------------------------------------------------------------------
    # Event Handlers & IPC
    # --------------------------------------------------------------------------
    def on_controller_selected(self, combo):
        active_id = combo.get_active_id()
        self.state["selected_joystick"] = active_id
        save_state(self.state)
        self.start_joystick_reader()

    def on_deadzone_changed(self, scale):
        val = scale.get_value()
        self.deadzone = val / 100.0
        if hasattr(self, 'lbl_dz_val'):
            self.lbl_dz_val.set_markup(f"<span font_size='8000' foreground='{self.pal['text_sub']}'>{int(val)}%</span>")

    def start_joystick_reader(self):
        joysticks = self.hardware.get("joysticks", [])
        if not joysticks:
            self.active_js_path = None
            return

        sel = self.state.get("selected_joystick")
        target_path = None
        for js in joysticks:
            if js["path"] == sel:
                target_path = js["path"]
                break
        if not target_path and joysticks:
            target_path = joysticks[0]["path"]

        self.active_js_path = target_path

    def on_toggle_device_mute(self, btn, name, lbl_status, btn_toggle):
        disabled = self.state.setdefault("disabled_devices", [])
        if name in disabled:
            disabled.remove(name)
            dispatch_hypr_keyword(f"device[{name}]:enabled", "true")
            lbl_status.set_text("[ ONLINE ]")
            lbl_status.get_style_context().remove_class("badge-isolated")
            lbl_status.get_style_context().add_class("badge-online")
            btn_toggle.set_label("[ ISOLATE / MUTE ]")
            btn_toggle.get_style_context().remove_class("btn-primary")
            btn_toggle.get_style_context().add_class("danger-btn")
        else:
            disabled.append(name)
            dispatch_hypr_keyword(f"device[{name}]:enabled", "false")
            lbl_status.set_text("[ ISOLATED ]")
            lbl_status.get_style_context().remove_class("badge-online")
            lbl_status.get_style_context().add_class("badge-isolated")
            btn_toggle.set_label("[ RE-ENABLE ]")
            btn_toggle.get_style_context().remove_class("danger-btn")
            btn_toggle.get_style_context().add_class("btn-primary")
        save_state(self.state)

    def on_sens_changed(self, scale, name):
        val = scale.get_value()
        self.state.setdefault("sensitivities", {})[name] = val
        save_state(self.state)
        
        if name in self.debounce_timers:
            GLib.source_remove(self.debounce_timers[name])
        self.debounce_timers[name] = GLib.timeout_add(40, lambda: dispatch_hypr_keyword(f"device[{name}]:sensitivity", f"{val:.2f}"))

    def on_toggle_natural_scroll(self, btn, name):
        val = btn.get_active()
        self.state.setdefault("natural_scroll", {})[name] = val
        save_state(self.state)
        dispatch_hypr_keyword(f"device[{name}]:natural_scroll", "true" if val else "false")

    def on_accel_changed(self, combo, name):
        val = combo.get_active_id()
        self.state.setdefault("accel_profiles", {})[name] = val
        save_state(self.state)
        dispatch_hypr_keyword(f"device[{name}]:accel_profile", val)

    def on_switch_layout(self, btn, name, layout):
        self.state.setdefault("layouts", {})[name] = layout
        save_state(self.state)
        dispatch_hypr_keyword(f"device[{name}]:kb_layout", layout)

    def on_toggle_dock_assist(self, switch, state):
        self.state["auto_disable_touchpad"] = state
        save_state(self.state)
        self.evaluate_dock_assist()

    def evaluate_dock_assist(self):
        if not self.state.get("auto_disable_touchpad", False):
            return
        mice = self.hardware.get("mice", [])
        has_external_mouse = False
        touchpad_name = None
        for m in mice:
            n = m.get("name", "").lower()
            if "touchpad" in n or "synaptics" in n:
                touchpad_name = m.get("name")
            elif "trackpoint" not in n and "ibm" not in n:
                has_external_mouse = True
        
        if touchpad_name:
            if has_external_mouse:
                dispatch_hypr_keyword(f"device[{touchpad_name}]:enabled", "false")
            else:
                dispatch_hypr_keyword(f"device[{touchpad_name}]:enabled", "true")

    def on_apply_profile(self, btn, profile_id):
        self.state["active_profile"] = profile_id
        self.lbl_profile.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 9' foreground='{self.pal['green']}'>[PROFILE: {profile_id}]</span>")
        
        mice = self.hardware.get("mice", [])
        if profile_id == "GAMING":
            for m in mice:
                name = m.get("name", "")
                if "touchpad" in name.lower() or "synaptics" in name.lower():
                    dispatch_hypr_keyword(f"device[{name}]:enabled", "false")
                else:
                    dispatch_hypr_keyword(f"device[{name}]:accel_profile", "flat")
                    dispatch_hypr_keyword(f"device[{name}]:sensitivity", "0.0")
        elif profile_id == "SIM":
            for m in mice:
                name = m.get("name", "")
                dispatch_hypr_keyword(f"device[{name}]:accel_profile", "adaptive")
                dispatch_hypr_keyword(f"device[{name}]:sensitivity", "-0.2")
        else:
            for m in mice:
                name = m.get("name", "")
                dispatch_hypr_keyword(f"device[{name}]:enabled", "true")
                dispatch_hypr_keyword(f"device[{name}]:natural_scroll", "true")
                dispatch_hypr_keyword(f"device[{name}]:accel_profile", "adaptive")
        
        save_state(self.state)

    def on_restore_defaults(self, btn):
        self.state["disabled_devices"] = []
        self.state["sensitivities"] = {}
        self.state["natural_scroll"] = {}
        self.state["accel_profiles"] = {}
        save_state(self.state)

        for dev_type in ["mice", "keyboards"]:
            for dev in self.hardware.get(dev_type, []):
                name = dev.get("name")
                if name:
                    dispatch_hypr_keyword(f"device[{name}]:enabled", "true")
                    dispatch_hypr_keyword(f"device[{name}]:sensitivity", "0.0")
                    dispatch_hypr_keyword(f"device[{name}]:accel_profile", "adaptive")
        
        self.destroy()
        subprocess.Popen([sys.executable, os.path.abspath(__file__)])

    def on_key_press(self, widget, event):
        key = event.keyval
        if key in (Gdk.KEY_Escape, Gdk.KEY_q, Gdk.KEY_Q):
            self.destroy()
            return True
        elif key in (Gdk.KEY_1, Gdk.KEY_m, Gdk.KEY_M):
            self.switch_tab("pointers")
            return True
        elif key in (Gdk.KEY_2, Gdk.KEY_k, Gdk.KEY_K):
            self.switch_tab("keyboards")
            return True
        elif key in (Gdk.KEY_3, Gdk.KEY_j, Gdk.KEY_J):
            self.switch_tab("sticks")
            return True
        elif key in (Gdk.KEY_4, Gdk.KEY_p, Gdk.KEY_P):
            self.switch_tab("profiles")
            return True
        elif key in (Gdk.KEY_r, Gdk.KEY_R):
            self.on_restore_defaults(None)
            return True
        return False

    def hotplug_worker(self):
        t = 0.0
        js_fd = None
        current_path = None
        event_struct = struct.Struct('IhBB')

        while not self.stop_event.is_set():
            if self.active_js_path != current_path:
                if js_fd is not None:
                    try: os.close(js_fd)
                    except Exception: pass
                    js_fd = None
                current_path = self.active_js_path
                if current_path and os.path.exists(current_path):
                    try:
                        js_fd = os.open(current_path, os.O_RDONLY | os.O_NONBLOCK)
                    except Exception:
                        js_fd = None

            if js_fd is not None:
                try:
                    while True:
                        data = os.read(js_fd, 8)
                        if not data or len(data) < 8:
                            break
                        js_time, value, ev_type, number = event_struct.unpack(data)
                        
                        if ev_type & 0x02:
                            norm_val = value / 32767.0
                            if number < len(self.axes_values):
                                self.axes_values[number] = norm_val
                        elif ev_type & 0x01:
                            if number < len(self.button_states):
                                self.button_states[number] = value
                except BlockingIOError:
                    pass
                except Exception:
                    try: os.close(js_fd)
                    except Exception: pass
                    js_fd = None

                GLib.idle_add(self.update_hardware_telemetry, list(self.axes_values), list(self.button_states))
                time.sleep(0.016)
            else:
                t += 0.05
                sim_x1 = math.sin(t * 0.8) * 0.6
                sim_y1 = math.cos(t * 0.5) * 0.4
                sim_x2 = math.cos(t * 0.7) * 0.5
                sim_y2 = math.sin(t * 0.9) * 0.5
                sim_thr = (math.sin(t * 0.4) + 1.0) / 2.0
                sim_rud = math.sin(t * 0.6) * 0.7

                demo_btns = [0] * 16
                active_btn_idx = int((t * 2) % 16)
                demo_btns[active_btn_idx] = 1

                GLib.idle_add(self.update_simulated_telemetry, sim_x1, sim_y1, sim_x2, sim_y2, sim_thr, sim_rud, demo_btns)
                time.sleep(0.04)

        if js_fd is not None:
            try: os.close(js_fd)
            except Exception: pass

    def update_hardware_telemetry(self, axes, buttons):
        x1 = axes[0] if len(axes) > 0 else 0.0
        y1 = axes[1] if len(axes) > 1 else 0.0
        self.scope1.set_deflection(x1, y1)
        self.lbl_tel1.set_markup(f"<span font_size='7500' foreground='{self.pal['text_sub']}'>X: {x1:+.2f} Y: {y1:+.2f}</span>")

        x2 = axes[3] if len(axes) > 3 else (axes[2] if len(axes) > 2 else 0.0)
        y2 = axes[4] if len(axes) > 4 else (axes[3] if len(axes) > 3 else 0.0)
        self.scope2.set_deflection(x2, y2)
        self.lbl_tel2.set_markup(f"<span font_size='7500' foreground='{self.pal['text_sub']}'>RX: {x2:+.2f} RY: {y2:+.2f}</span>")

        thr = axes[2] if len(axes) > 2 else 0.0
        self.bar_throttle.set_value(thr)

        twist = axes[5] if len(axes) > 5 else 0.0
        self.bar_twist.set_value(twist)
        self.bar_rudder.set_value(twist)
        self.lbl_rudder.set_markup(f"<span font_size='7000' foreground='{self.pal['text_sub']}'>RUD: {twist:+.2f}</span>")

        for i, lbl in enumerate(self.button_led_labels):
            if i < len(buttons) and buttons[i]:
                lbl.get_style_context().remove_class("led-off")
                lbl.get_style_context().add_class("led-on")
            else:
                lbl.get_style_context().remove_class("led-on")
                lbl.get_style_context().add_class("led-off")

        return False

    def update_simulated_telemetry(self, x1, y1, x2, y2, thr, rud, btns):
        self.scope1.set_deflection(x1, y1)
        self.lbl_tel1.set_markup(f"<span font_size='7500' foreground='{self.pal['text_sub']}'>X: {x1:+.2f} Y: {y1:+.2f}</span>")

        self.scope2.set_deflection(x2, y2)
        self.lbl_tel2.set_markup(f"<span font_size='7500' foreground='{self.pal['text_sub']}'>RX: {x2:+.2f} RY: {y2:+.2f}</span>")

        self.bar_throttle.set_value((thr * 2.0) - 1.0)
        self.bar_twist.set_value(rud)
        self.bar_rudder.set_value(rud)
        self.lbl_rudder.set_markup(f"<span font_size='7000' foreground='{self.pal['text_sub']}'>RUD: {rud:+.2f}</span>")

        for i, lbl in enumerate(self.button_led_labels):
            if i < len(btns) and btns[i]:
                lbl.get_style_context().remove_class("led-off")
                lbl.get_style_context().add_class("led-on")
            else:
                lbl.get_style_context().remove_class("led-on")
                lbl.get_style_context().add_class("led-off")

        return False

    def on_destroy(self, *args):
        self.stop_event.set()
        for t in self.debounce_timers.values():
            GLib.source_remove(t)
        if self.worker_thread and self.worker_thread.is_alive():
            self.worker_thread.join(timeout=0.5)
        if os.path.exists(PID_FILE):
            try: os.remove(PID_FILE)
            except Exception: pass
        Gtk.main_quit()

def main():
    start_tab = 0
    if len(sys.argv) > 1:
        raw_arg = sys.argv[1].lower().replace("--tab=", "").replace("--tab", "").strip()
        if not raw_arg and len(sys.argv) > 2:
            raw_arg = sys.argv[2].lower().strip()
        if raw_arg in ("1", "pointer", "pointers", "mouse", "mice"): start_tab = 0
        elif raw_arg in ("2", "keyboard", "keyboards", "key"): start_tab = 1
        elif raw_arg in ("3", "stick", "sticks", "joystick", "gamepad"): start_tab = 2
        elif raw_arg in ("4", "profile", "profiles"): start_tab = 3

    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE) as f:
                old_pid = int(f.read().strip())
            os.kill(old_pid, signal.SIGTERM)
            time.sleep(0.1)
        except Exception:
            pass
        try: os.remove(PID_FILE)
        except Exception: pass

    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    win = SpaceDeckWindow(start_tab=start_tab)
    win.show_all()
    initial_name = "pointers"
    if start_tab == 1: initial_name = "keyboards"
    elif start_tab == 2: initial_name = "sticks"
    elif start_tab == 3: initial_name = "profiles"
    win.switch_tab(initial_name)
    Gtk.main()

if __name__ == "__main__":
    main()
