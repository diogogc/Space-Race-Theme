    def build_ui(self, start_tab=0):
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_box)

        # 1. Header Box
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        header.get_style_context().add_class("header-box")
        main_box.pack_start(header, False, False, 0)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        title_lbl = Gtk.Label()
        title_lbl.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 11.5' foreground='{self.pal['text_main']}'>🎮 APOLLO FLIGHT DECK // HUMAN INTERFACE &amp; ATTITUDE HUB</span>")
        title_lbl.set_xalign(0.0)

        sub_lbl = Gtk.Label()
        sub_lbl.set_markup(f"<span font_desc='JetBrainsMono Nerd Font 8.5' foreground='{self.pal['text_dim']}'>PERIPHERAL TELEMETRY, HYPRLAND DRIVER IPC &amp; AVIONICS CONTROLLER</span>")
        sub_lbl.set_xalign(0.0)

        title_box.pack_start(title_lbl, False, False, 0)
        title_box.pack_start(sub_lbl, False, False, 0)
        header.pack_start(title_box, True, True, 0)

        self.lbl_profile = Gtk.Label()
        self.lbl_profile.get_style_context().add_class("stat-badge")
        self.lbl_profile.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 9' foreground='{self.pal['green']}'>[PROFILE: {self.state.get('active_profile', 'CODING')}]</span>")
        header.pack_end(self.lbl_profile, False, False, 0)

        # 2. Comms Telemetry Style Button Toolbar
        toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        toolbar.get_style_context().add_class("action-toolbar")
        main_box.pack_start(toolbar, False, False, 0)

        tab_defs = [
            ("pointers", "POINTERS &amp; TRACKPADS"),
            ("keyboards", "KEYBOARDS"),
            ("sticks", "STICKS &amp; GAMEPADS"),
            ("profiles", "FLIGHT PROFILES")
        ]

        self.tab_buttons = {}
        for tab_id, tab_label in tab_defs:
            btn = Gtk.Button()
            btn.get_style_context().add_class("action-btn")
            lbl_btn = Gtk.Label()
            lbl_btn.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 8.5' foreground='{self.pal['text_dim']}'>[ {tab_label} ]</span>")
            btn.add(lbl_btn)
            btn.connect("clicked", lambda b, tid=tab_id: self.switch_tab(tid))
            toolbar.pack_start(btn, False, False, 0)
            self.tab_buttons[tab_id] = (btn, lbl_btn, tab_label)

        # Sub-header Bar (Matching Comms Telemetry format)
        sub_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        sub_bar.get_style_context().add_class("sub-header-bar")
        main_box.pack_start(sub_bar, False, False, 0)

        self.lbl_section_title = Gtk.Label()
        self.lbl_section_title.set_xalign(0.0)
        sub_bar.pack_start(self.lbl_section_title, True, True, 0)

        self.lbl_section_status = Gtk.Label()
        self.lbl_section_status.set_xalign(1.0)
        sub_bar.pack_end(self.lbl_section_status, False, False, 0)

        # 3. Stack Content Area (Zero-Scroll Container)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(100)
        main_box.pack_start(self.stack, True, True, 0)

        self.stack.add_named(self.create_pointers_tab(), "pointers")
        self.stack.add_named(self.create_keyboards_tab(), "keyboards")
        self.stack.add_named(self.create_sticks_tab(), "sticks")
        self.stack.add_named(self.create_profiles_tab(), "profiles")

        initial_name = "pointers"
        if start_tab == 1: initial_name = "keyboards"
        elif start_tab == 2: initial_name = "sticks"
        elif start_tab == 3: initial_name = "profiles"
        self.switch_tab(initial_name)

        # 4. Streamlined Footer
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        footer.get_style_context().add_class("header-box")
        main_box.pack_end(footer, False, False, 0)

        btn_restore = Gtk.Button(label="[ 🔄 RESTORE ALL DEFAULT (R) ]")
        btn_restore.get_style_context().add_class("danger-btn")
        btn_restore.connect("clicked", self.on_restore_defaults)
        footer.pack_start(btn_restore, False, False, 0)

        lbl_hint = Gtk.Label()
        lbl_hint.set_markup(f"<span font_size='7500' foreground='{self.pal['text_dim']}'>[1-4] Tabs • [R] Reset • [ESC] Close</span>")
        footer.pack_start(lbl_hint, True, True, 0)

        btn_close = Gtk.Button(label="[ ✕ DISMISS (ESC) ]")
        btn_close.get_style_context().add_class("action-btn")
        btn_close.connect("clicked", lambda b: self.destroy())
        footer.pack_end(btn_close, False, False, 0)

    def switch_tab(self, tab_id):
        self.active_tab_name = tab_id
        self.stack.set_visible_child_name(tab_id)

        for tid, (btn, lbl_btn, label_text) in self.tab_buttons.items():
            if tid == tab_id:
                btn.get_style_context().add_class("active")
                lbl_btn.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 8.5' foreground='{self.pal['accent']}'>[ {label_text} ]</span>")
            else:
                btn.get_style_context().remove_class("active")
                lbl_btn.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 8.5' foreground='{self.pal['text_dim']}'>[ {label_text} ]</span>")

        mice_count = len(self.hardware.get("mice", []))
        kb_count = len(self.hardware.get("keyboards", []))
        js_count = len(self.hardware.get("joysticks", []))

        if tab_id == "pointers":
            self.lbl_section_title.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 9' foreground='{self.pal['text_main']}'>POINTING INTERFACES &amp; TRACKPADS:</span>")
            self.lbl_section_status.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 8.5' foreground='{self.pal['green']}'>[ {mice_count} POINTERS DISCOVERED ]</span>")
        elif tab_id == "keyboards":
            self.lbl_section_title.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 9' foreground='{self.pal['text_main']}'>KEYBOARD MATRICES &amp; INPUT BUSSES:</span>")
            self.lbl_section_status.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 8.5' foreground='{self.pal['green']}'>[ {kb_count} UNITS DETECTED ]</span>")
        elif tab_id == "sticks":
            self.lbl_section_title.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 9' foreground='{self.pal['text_main']}'>FLIGHT STICKS, HOTAS &amp; RADAR AVIONICS:</span>")
            self.lbl_section_status.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 8.5' foreground='{self.pal['green']}'>[ {js_count} UNITS ACTIVE ]</span>")
        elif tab_id == "profiles":
            self.lbl_section_title.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 9' foreground='{self.pal['text_main']}'>COORDINATED FLIGHT PROFILES:</span>")
            self.lbl_section_status.set_markup(f"<span font_desc='JetBrainsMono Nerd Font Bold 8.5' foreground='{self.pal['accent']}'>[ 3 PRESETS READY ]</span>")

    # --------------------------------------------------------------------------
    # Sub-Areas (Zero-Scroll Telemetry Cards)
    # --------------------------------------------------------------------------
    def create_pointers_tab(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        vbox.set_margin_top(2)
        vbox.set_margin_bottom(2)
        vbox.set_margin_start(12)
        vbox.set_margin_end(12)

        dock_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        dock_card.get_style_context().add_class("telemetry-card")
        lbl_dock = Gtk.Label()
        lbl_dock.set_markup(f"<span font_size='8000' foreground='{self.pal['text_sub']}'>⚡ <b>Touchpad Dock Assist:</b> Auto-isolate trackpad when external mouse attached</span>")
        lbl_dock.set_xalign(0.0)
        dock_card.pack_start(lbl_dock, True, True, 0)
        
        sw_dock = Gtk.Switch()
        sw_dock.set_active(self.state.get("auto_disable_touchpad", False))
        sw_dock.connect("state-set", self.on_toggle_dock_assist)
        dock_card.pack_end(sw_dock, False, False, 0)
        vbox.pack_start(dock_card, False, False, 0)

        mice = self.hardware.get("mice", [])
        if not mice:
            lbl_none = Gtk.Label()
            lbl_none.set_markup(f"<span foreground='{self.pal['text_dim']}'>No pointing devices detected via Hyprland IPC.</span>")
            vbox.pack_start(lbl_none, True, True, 0)
        else:
            for dev in mice:
                name = dev.get("name", "Unknown Pointer")
                is_disabled = name in self.state.get("disabled_devices", [])

                card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                card.get_style_context().add_class("telemetry-card")

                row1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                lbl_name = Gtk.Label()
                lbl_name.set_markup(f"<span font_weight='bold' font_size='9000' foreground='{self.pal['text_main']}'>🖱️ {name.upper()}</span>")
                lbl_name.set_xalign(0.0)
                row1.pack_start(lbl_name, True, True, 0)

                lbl_status = Gtk.Label(label="[ ISOLATED ]" if is_disabled else "[ ONLINE ]")
                lbl_status.get_style_context().add_class("badge-isolated" if is_disabled else "badge-online")
                row1.pack_end(lbl_status, False, False, 0)

                btn_toggle = Gtk.Button(label="[ RE-ENABLE ]" if is_disabled else "[ ISOLATE / MUTE ]")
                btn_toggle.get_style_context().add_class("btn-primary" if is_disabled else "danger-btn")
                btn_toggle.connect("clicked", self.on_toggle_device_mute, name, lbl_status, btn_toggle)
                row1.pack_end(btn_toggle, False, False, 0)
                card.pack_start(row1, False, False, 0)

                row_ctrl = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                lbl_sens = Gtk.Label()
                lbl_sens.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>Sens:</span>")
                row_ctrl.pack_start(lbl_sens, False, False, 0)

                cur_sens = self.state.get("sensitivities", {}).get(name, dev.get("defaultSpeed", 0.0))
                scale_sens = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, -1.0, 1.0, 0.05)
                scale_sens.set_value(cur_sens)
                scale_sens.connect("value-changed", self.on_sens_changed, name)
                row_ctrl.pack_start(scale_sens, True, True, 0)

                sw_nat = Gtk.CheckButton(label="Natural")
                sw_nat.set_active(self.state.get("natural_scroll", {}).get(name, False))
                sw_nat.connect("toggled", self.on_toggle_natural_scroll, name)
                row_ctrl.pack_start(sw_nat, False, False, 0)

                cb_acc = Gtk.ComboBoxText()
                cb_acc.append("adaptive", "Adaptive")
                cb_acc.append("flat", "Flat (1:1)")
                cb_acc.set_active(1 if self.state.get("accel_profiles", {}).get(name) == "flat" else 0)
                cb_acc.connect("changed", self.on_accel_changed, name)
                row_ctrl.pack_start(cb_acc, False, False, 0)

                card.pack_start(row_ctrl, False, False, 0)
                vbox.pack_start(card, False, False, 0)

        return vbox

