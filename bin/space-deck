def get_active_theme_key():
    path = os.path.expanduser("~/.config/themes/current_theme")
    if os.path.exists(path):
        try:
            with open(path) as f:
                name = f.read().strip().lower()
                if "amber" in name: return "crt-amber"
                if "green" in name: return "crt-green"
                if "kosmos" in name or "vfd" in name or "soviet" in name: return "kosmos-vfd"
                return "nasa"
        except Exception:
            pass
    return "nasa"

# ==============================================================================
# State Management
# ==============================================================================
def load_state():
    if not os.path.exists(CONFIG_DIR):
        os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {
        "disabled_devices": [],
        "sensitivities": {},
        "natural_scroll": {},
        "accel_profiles": {},
        "layouts": {},
        "auto_disable_touchpad": False,
        "active_profile": "CODING",
        "selected_joystick": None
    }

def save_state(state):
    try:
        if not os.path.exists(CONFIG_DIR):
            os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
        temp_file = f"{STATE_FILE}.tmp.{os.getpid()}"
        with open(temp_file, "w") as f:
            json.dump(state, f, indent=2)
        os.chmod(temp_file, 0o600)
        os.replace(temp_file, STATE_FILE)
    except Exception as e:
        print(f"Error saving state: {e}", file=sys.stderr)

# ==============================================================================
# Hyprland IPC & Hardware Helpers
# ==============================================================================
def run_hyprctl(args):
    try:
        res = subprocess.run(["hyprctl", "-j"] + args, capture_output=True, text=True, timeout=2.0)
        if res.returncode == 0 and res.stdout.strip():
            return json.loads(res.stdout)
    except Exception:
        pass
    return None

def dispatch_hypr_keyword(keyword, value):
    try:
        subprocess.Popen(["hyprctl", "keyword", keyword, value], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        print(f"IPC Error: {e}", file=sys.stderr)

def get_connected_hardware():
    data = run_hyprctl(["devices"])
    if not data:
        data = {"mice": [], "keyboards": [], "tablets": [], "switches": []}
    
    joysticks = []
    js_dir = "/dev/input"
    if os.path.exists(js_dir):
        try:
            for item in sorted(os.listdir(js_dir)):
                if item.startswith("js"):
                    dev_path = os.path.join(js_dir, item)
                    name = f"Flight Stick / Gamepad ({item})"
                    sys_name_path = f"/sys/class/input/{item}/device/name"
                    if os.path.exists(sys_name_path):
                        try:
                            with open(sys_name_path) as f:
                                name = f.read().strip()
                        except Exception:
                            pass
                    
                    num_axes = 2
                    num_buttons = 4
                    try:
                        fd = os.open(dev_path, os.O_RDONLY | os.O_NONBLOCK)
                        buf = bytearray(1)
                        fcntl.ioctl(fd, 0x80016a11, buf)
                        num_axes = buf[0]
                        fcntl.ioctl(fd, 0x80016a12, buf)
                        num_buttons = buf[0]
                        os.close(fd)
                    except Exception:
                        pass

                    joysticks.append({
                        "name": name,
                        "path": dev_path,
                        "id": item,
                        "num_axes": num_axes,
                        "num_buttons": num_buttons
                    })
        except Exception:
            pass

    return {
        "mice": data.get("mice", []),
        "keyboards": data.get("keyboards", []),
        "tablets": data.get("tablets", []),
        "switches": data.get("switches", []),
        "joysticks": joysticks
    }

# ==============================================================================
# Compact Custom Cairo Radar Scope Widget (Zero Font Shadows)
# ==============================================================================
class JoystickScope(Gtk.DrawingArea):
    def __init__(self, theme_pal, title="STICK 1 (X/Y)"):
        super().__init__()
        self.pal = theme_pal
        self.title = title
        self.set_size_request(95, 95)
        self.axis_x = 0.0
        self.axis_y = 0.0
        self.connect("draw", self.on_draw)

    def set_deflection(self, x, y):
        self.axis_x = max(-1.0, min(1.0, x))
        self.axis_y = max(-1.0, min(1.0, y))
        self.queue_draw()

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()
        cx, cy = w / 2.0, h / 2.0
        radius = min(cx, cy) - 5

        cr.arc(cx, cy, radius, 0, 2 * math.pi)
        cr.set_source_rgba(0.04, 0.08, 0.1, 0.95)
        cr.fill_preserve()
        cr.set_source_rgba(0.2, 0.4, 0.35, 0.7)
        cr.set_line_width(1.2)
        cr.stroke()

        for r_factor in [0.33, 0.66]:
            cr.arc(cx, cy, radius * r_factor, 0, 2 * math.pi)
            cr.set_source_rgba(0.2, 0.5, 0.4, 0.25)
            cr.set_line_width(0.8)
            cr.stroke()

        cr.move_to(cx - radius, cy)
        cr.line_to(cx + radius, cy)
        cr.move_to(cx, cy - radius)
        cr.line_to(cx, cy + radius)
        cr.set_source_rgba(0.2, 0.6, 0.5, 0.4)
        cr.set_line_width(0.8)
        cr.stroke()

        target_x = cx + (self.axis_x * (radius - 4))
        target_y = cy + (self.axis_y * (radius - 4))

        cr.move_to(cx, cy)
        cr.line_to(target_x, target_y)
        cr.set_source_rgba(0.28, 0.9, 0.76, 0.6)
        cr.set_line_width(1.2)
        cr.stroke()

        cr.arc(target_x, target_y, 3.5, 0, 2 * math.pi)
        cr.set_source_rgba(0.28, 0.9, 0.76, 0.95)
        cr.fill_preserve()
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.9)
        cr.set_line_width(1.2)
        cr.stroke()

# ==============================================================================
# Compact Cairo Linear Bargraph (Throttle / Rudder)
# ==============================================================================
class LinearAxisBar(Gtk.DrawingArea):
    def __init__(self, theme_pal, title="THR", is_vertical=True, is_bipolar=False):
        super().__init__()
        self.pal = theme_pal
        self.title = title
        self.is_vertical = is_vertical
        self.is_bipolar = is_bipolar
        self.value = 0.0
        if is_vertical:
            self.set_size_request(24, 75)
        else:
            self.set_size_request(80, 14)
        self.connect("draw", self.on_draw)

    def set_value(self, val):
        self.value = max(-1.0, min(1.0, val))
        self.queue_draw()

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()

        cr.set_source_rgba(0.04, 0.07, 0.1, 0.95)
        cr.rectangle(1, 1, w - 2, h - 2)
        cr.fill_preserve()
        cr.set_source_rgba(0.2, 0.3, 0.35, 0.6)
        cr.set_line_width(1.0)
        cr.stroke()

        if self.is_vertical:
            val_norm = (self.value + 1.0) / 2.0 if self.is_bipolar else max(0.0, min(1.0, (self.value + 1.0) / 2.0))
            fill_h = (h - 6) * val_norm
            bar_y = (h - 3) - fill_h

            cr.set_source_rgba(1.0, 0.7, 0.0, 0.85)
            cr.rectangle(3, bar_y, w - 6, fill_h)
            cr.fill()

            if self.is_bipolar:
                mid_y = h / 2.0
                cr.move_to(2, mid_y)
                cr.line_to(w - 2, mid_y)
                cr.set_source_rgba(0.3, 0.8, 0.7, 0.7)
                cr.set_line_width(1.2)
                cr.stroke()
        else:
            mid_x = w / 2.0
            val_norm = self.value
            fill_w = (w / 2.0 - 4) * val_norm

            cr.set_source_rgba(0.28, 0.9, 0.76, 0.85)
            if fill_w >= 0:
                cr.rectangle(mid_x, 2, fill_w, h - 4)
            else:
                cr.rectangle(mid_x + fill_w, 2, -fill_w, h - 4)
            cr.fill()

            cr.move_to(mid_x, 1)
            cr.line_to(mid_x, h - 1)
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.8)
            cr.set_line_width(1.2)
            cr.stroke()

# ==============================================================================
# Main Space Deck Window
# ==============================================================================
class SpaceDeckWindow(Gtk.Window):
    def __init__(self, start_tab=0):
        super().__init__(title="Space Deck")
        self.set_name("space-deck")
        self.set_role("space-deck")
        self.set_default_size(720, 480)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)

        self.theme_key = get_active_theme_key()
        self.pal = THEMES.get(self.theme_key, THEMES["nasa"])
        self.state = load_state()
        self.hardware = get_connected_hardware()

        self.stop_event = threading.Event()
        self.worker_thread = None
        self.debounce_timers = {}
        self.active_js_path = None
        self.button_led_labels = []
        self.tab_buttons = {}
        self.active_tab_name = "pointers"

        self.axes_values = [0.0] * 16
        self.button_states = [0] * 32

        self.apply_styles()
        self.build_ui(start_tab)

        self.connect("destroy", self.on_destroy)
        self.connect("key-press-event", self.on_key_press)

        self.worker_thread = threading.Thread(target=self.hotplug_worker, daemon=True)
        self.worker_thread.start()

        self.start_joystick_reader()

