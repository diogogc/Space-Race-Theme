#!/usr/bin/env bash
set -euo pipefail

# CPU calculation with quick sample or fallback
cpu_usage=0
if [[ -f /proc/stat ]]; then
  read -r _ u1 n1 s1 i1 w1 q1 sq1 _ < /proc/stat
  total1=$((u1 + n1 + s1 + i1 + w1 + q1 + sq1))
  idle1=$((i1 + w1))
  
  # check previous stat cache
  cache_file="${XDG_RUNTIME_DIR:-/tmp}/space_telemetry_cpu_${UID:-1000}.stat"
  if [[ -f "$cache_file" ]]; then
    read -r prev_total prev_idle < "$cache_file" || true
    if [[ -n "${prev_total:-}" && -n "${prev_idle:-}" && "$total1" -gt "$prev_total" ]]; then
      diff_total=$((total1 - prev_total))
      diff_idle=$((idle1 - prev_idle))
      diff_usage=$((diff_total - diff_idle))
      cpu_usage=$(( (diff_usage * 100) / diff_total ))
    fi
  fi
  printf '%d %d\n' "$total1" "$idle1" > "$cache_file" 2>/dev/null || true
fi

# CPU temperature from hwmon
cpu_temp="--"
for hwmon in /sys/class/hwmon/hwmon*; do
  [[ -d "$hwmon" ]] || continue
  for input in "$hwmon"/temp*_input; do
    [[ -f "$input" ]] || continue
    t=$(cat "$input" 2>/dev/null || true)
    if [[ "$t" =~ ^[0-9]+$ ]] && (( t > 10000 && t < 120000 )); then
      cpu_temp="$((t / 1000))°C"
      break 2
    fi
  done
done

# Memory usage from /proc/meminfo
mem_total_kb=$(awk '/MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
mem_avail_kb=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
mem_used_kb=$((mem_total_kb - mem_avail_kb))

mem_used_gb=$(awk "BEGIN {printf \"%.1f\", $mem_used_kb / 1048576}")
mem_total_gb=$(awk "BEGIN {printf \"%.1f\", $mem_total_kb / 1048576}")
mem_pct=0
(( mem_total_kb > 0 )) && mem_pct=$(( (mem_used_kb * 100) / mem_total_kb ))

status_label="SYS: OK"
status_class="nominal"
if (( cpu_usage > 85 || mem_pct > 90 )); then
  status_label="SYS: WARN"
  status_class="warning"
fi

text_out=$(printf '[CPU: %d%% %s | MEM: %d%%]' "$cpu_usage" "$cpu_temp" "$mem_pct")
tooltip_out=$(printf '🛰️ SYSTEM HARDWARE TELEMETRY\\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\\n• Status            : %s\\n• Processor Load    : %d%%\\n• Thermal Core      : %s\\n• Memory Allocation : %s GiB / %s GiB (%d%%)\\n• Click             : Open Telemetry Console (SUPER+SHIFT+C)' \
  "$status_label" "$cpu_usage" "$cpu_temp" "$mem_used_gb" "$mem_total_gb" "$mem_pct")

printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$text_out" "$tooltip_out" "$status_class"
