        lbl_prompt = Gtk.Label()
        lbl_prompt.set_markup(f"<span font_size='8500' foreground='{self.pal['text_sub']}'>Enter security passphrase / WPA key for telemetry carrier lock:</span>")
        lbl_prompt.set_xalign(0.0)
        self.auth_card.pack_start(lbl_prompt, False, False, 0)

        self.entry_pass = Gtk.Entry()
        self.entry_pass.set_visibility(False)
        self.entry_pass.set_placeholder_text("Encryption Passphrase...")
        self.entry_pass.connect("activate", lambda e: self.submit_auth())
        self.auth_card.pack_start(self.entry_pass, False, False, 0)

        self.chk_show_pass = Gtk.CheckButton.new_with_label(" Reveal Passphrase")
        self.chk_show_pass.connect("toggled", lambda w: self.entry_pass.set_visibility(w.get_active()))
        self.auth_card.pack_start(self.chk_show_pass, False, False, 0)

        self.lbl_auth_status = Gtk.Label()
        self.lbl_auth_status.set_xalign(0.0)
        self.auth_card.pack_start(self.lbl_auth_status, False, False, 0)

        center_box.pack_start(self.auth_card, True, True, 0)

        btns_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        btns_box.set_homogeneous(True)

        self.btn_auth_connect = Gtk.Button()
        self.btn_auth_connect.get_style_context().add_class("connect-btn")
        lbl_c = Gtk.Label()
        lbl_c.set_markup(f"<span font_weight='bold' foreground='{self.pal['green']}'>[ ENTER / AUTH ] ENGAGE LINK</span>")
        self.btn_auth_connect.add(lbl_c)
        self.btn_auth_connect.connect("clicked", lambda w: self.submit_auth())
        btns_box.pack_start(self.btn_auth_connect, True, True, 0)

        self.btn_auth_cancel = Gtk.Button()
        self.btn_auth_cancel.get_style_context().add_class("action-btn")
