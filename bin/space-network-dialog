        lbl_can.set_markup(f"<span font_weight='bold' foreground='{self.pal['text_dim']}'>[ ESC ] CANCEL</span>")
        self.btn_auth_cancel.add(lbl_can)
        self.btn_auth_cancel.connect("clicked", lambda w: self.cancel_auth())
        btns_box.pack_start(self.btn_auth_cancel, True, True, 0)

        center_box.pack_start(btns_box, False, False, 0)
        auth_vbox.pack_start(center_box, True, True, 0)

        footer = Gtk.Label()
