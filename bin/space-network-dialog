        bt_vbox.pack_start(body, True, True, 0)

        footer = Gtk.Label()
        footer.set_markup(f"<span font_size='7200' foreground='{self.pal['text_dim']}'>[ ESC / BKSP ] RETURN TO CONSOLE   [ P ] POWER TOGGLE   [ S ] SCAN</span>")
