def get_theme_name():
    path = os.path.expanduser("~/.config/themes/current_theme")
    if os.path.exists(path):
        try:
            with open(path, "r") as f:
                t = f.read().strip()
                if t in THEMES:
                    return t
        except Exception:
            pass
    return "nasa"

def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip('#')
    return tuple(int(hex_str[i:i+2], 16)/255.0 for i in (0, 2, 4))

def check_singleton():
    my_pid = os.getpid()
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                old_pid = int(f.read().strip())
            if old_pid != my_pid:
                try:
                    os.kill(old_pid, 0)
                    os.kill(old_pid, signal.SIGTERM)
                    try:
                        os.remove(PID_FILE)
                    except OSError:
                        pass
                    sys.exit(0)
                except OSError:
                    pass
        except Exception:
            pass

    try:
        with open(PID_FILE, "w") as f:
            f.write(str(my_pid))
    except Exception:
        pass

def cleanup():
    try:
        if os.path.exists(PID_FILE):
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            if pid == os.getpid():
                os.remove(PID_FILE)
    except Exception:
        pass

def pct_to_smeter(pct):
    if pct <= 0:
        return "S0", -100, 0
    dbm = int((pct * 0.7) - 100)
    if pct >= 97:
        return "S9+30dB", dbm, 12
    elif pct >= 92:
        return "S9+20dB", dbm, 11
    elif pct >= 85:
        return "S9+10dB", dbm, 10
    elif pct >= 75:
        return "S9", dbm, 9
    elif pct >= 65:
        return "S8", dbm, 8
    elif pct >= 55:
        return "S7", dbm, 7
    elif pct >= 45:
        return "S6", dbm, 6
    elif pct >= 35:
        return "S5", dbm, 5
    elif pct >= 25:
        return "S4", dbm, 4
    elif pct >= 15:
        return "S3", dbm, 3
    elif pct >= 6:
        return "S2", dbm, 2
    else:
        return "S1", dbm, 1

class ApolloRfSignalGauge(Gtk.DrawingArea):
    """
    Vintage Radio Receiver S-Meter (Signal Strength Meter)
    Calibrated in S-Units (S1-S9, 6 dB/S-unit) and Decibels above S9 (+10dB, +20dB, +30dB).
    """
    def __init__(self, pal):
        super().__init__()
        self.set_size_request(260, 92)
        self.pal = pal
        self.signal_pct = 0
        self.is_connected = False
        self.status_label = "OFFLINE"
        self.mode = "wifi"
        self.readout_override = ""
        self.connect("draw", self.on_draw)

    def set_signal(self, pct, connected=True, status="NOMINAL", mode="wifi", readout_override=""):
        self.signal_pct = max(0, min(100, pct))
        self.is_connected = connected
        self.status_label = status
        self.mode = mode
        self.readout_override = readout_override
        self.queue_draw()

    def on_draw(self, widget, cr):
        width = self.get_allocated_width()
        height = self.get_allocated_height()

        cr.save()
        bez_r, bez_g, bez_b = hex_to_rgb(self.pal["bg_bezel"])
        cr.set_source_rgb(bez_r, bez_g, bez_b)
        cr.rectangle(2, 2, width - 4, height - 4)
        cr.fill()

        bord_r, bord_g, bord_b = hex_to_rgb(self.pal["border_dim"])
        cr.set_source_rgb(bord_r, bord_g, bord_b)
        cr.set_line_width(1.5)
        cr.rectangle(2, 2, width - 4, height - 4)
        cr.stroke()

        acc_r, acc_g, acc_b = hex_to_rgb(self.pal["text_main"])
        dim_r, dim_g, dim_b = hex_to_rgb(self.pal["text_dim"])
        sub_r, sub_g, sub_b = hex_to_rgb(self.pal["text_sub"])
        grn_r, grn_g, grn_b = hex_to_rgb(self.pal["green"])
        yel_r, yel_g, yel_b = hex_to_rgb(self.pal["yellow"])
        red_r, red_g, red_b = hex_to_rgb(self.pal["red"])

        title_text = "HARDWIRE UMBILICAL (ETH)" if self.mode == "ethernet" else "S-BAND RECEIVER S-METER"
        cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(8.2)
        cr.set_source_rgb(acc_r, acc_g, acc_b)
        cr.move_to(8, 14)
        cr.show_text(title_text)

        s_unit, cur_dbm, s_idx = pct_to_smeter(self.signal_pct)

        if self.readout_override:
            disp_txt = self.readout_override
            col_r, col_g, col_b = (grn_r, grn_g, grn_b)
        elif self.mode == "ethernet" and self.is_connected:
            disp_txt = "1000M SOLID"
            col_r, col_g, col_b = (grn_r, grn_g, grn_b)
        elif self.is_connected:
            disp_txt = f"{s_unit} ({cur_dbm} dBm)"
            col_r, col_g, col_b = (grn_r, grn_g, grn_b) if s_idx >= 7 else ((yel_r, yel_g, yel_b) if s_idx >= 4 else (red_r, red_g, red_b))
        else:
            disp_txt = "S0 (NO CARRIER)"
            col_r, col_g, col_b = (red_r, red_g, red_b)

        cr.set_font_size(8.8)
        cr.set_source_rgb(col_r, col_g, col_b)
        ext = cr.text_extents(disp_txt)
        cr.move_to(width - 8 - ext.width, 14)
        cr.show_text(disp_txt)

        track_x = 8
        track_y = 20
        track_w = width - 16
        track_h = 16

        tr_r, tr_g, tr_b = hex_to_rgb(self.pal["track_bg"])
        cr.set_source_rgb(tr_r, tr_g, tr_b)
        cr.rectangle(track_x, track_y, track_w, track_h)
        cr.fill()

        cr.set_source_rgba(bord_r, bord_g, bord_b, 0.8)
        cr.set_line_width(1.0)
        cr.rectangle(track_x, track_y, track_w, track_h)
        cr.stroke()

        num_bars = 24
        if self.is_connected and (self.signal_pct > 0 or self.mode == "ethernet"):
            bars_to_fill = num_bars if self.mode == "ethernet" else max(1, int((self.signal_pct / 100.0) * num_bars))
            bar_spacing = (track_w - 4) / float(num_bars)

            for b in range(bars_to_fill):
                bx = track_x + 2 + b * bar_spacing
                bw = max(2.0, bar_spacing - 1.5)
                if self.mode == "ethernet":
                    cr.set_source_rgba(grn_r, grn_g, grn_b, 0.95)
                else:
                    if b < 6:
                        cr.set_source_rgba(red_r, red_g, red_b, 0.9)
                    elif b < 12:
                        cr.set_source_rgba(yel_r, yel_g, yel_b, 0.9)
                    elif b < 17:
                        cr.set_source_rgba(grn_r, grn_g, grn_b, 0.92)
                    else:
                        cr.set_source_rgba(red_r, red_g, red_b, 0.95)
                cr.rectangle(bx, track_y + 2, bw, track_h - 4)
                cr.fill()

        s_ticks = [
            (0.10, "1", False),
            (0.18, "", True),
            (0.25, "3", False),
            (0.33, "", True),
            (0.40, "5", False),
            (0.48, "", True),
            (0.55, "7", False),
            (0.63, "", True),
            (0.70, "9", False),
            (0.80, "+10", False),
            (0.90, "+20", False),
            (1.00, "+30", False)
        ]

        for pos_ratio, val_str, is_minor in s_ticks:
            tx = track_x + pos_ratio * track_w
            is_over9 = (pos_ratio >= 0.75)
            tick_len = 3 if is_minor else 5

            if is_over9:
                cr.set_source_rgba(red_r, red_g, red_b, 0.95)
            else:
                cr.set_source_rgba(acc_r, acc_g, acc_b, 0.4 if is_minor else 0.85)

            cr.set_line_width(1.0)
            cr.move_to(tx, track_y + track_h + 1)
            cr.line_to(tx, track_y + track_h + 1 + tick_len)
            cr.stroke()

            if val_str:
                cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
                cr.set_font_size(6.5)
                vext = cr.text_extents(val_str)
                cr.move_to(tx - vext.width / 2.0, track_y + track_h + 12)
                cr.show_text(val_str)

        cr.select_font_face("JetBrainsMono Nerd Font", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(6.2)
        cr.set_source_rgb(dim_r, dim_g, dim_b)
        cr.move_to(track_x, track_y + track_h + 21)
        cr.show_text("S-UNITS (6dB/S)")

        cr.set_source_rgb(red_r, red_g, red_b)
        ext_over = cr.text_extents("+dB OVER 9")
        cr.move_to(track_x + track_w - ext_over.width, track_y + track_h + 21)
        cr.show_text("+dB OVER 9")

        lock_txt = f"CARRIER LOCK: {self.status_label}"
        if self.is_connected and self.mode == "wifi":
            lock_txt += f" [{s_unit}]"
        cr.set_font_size(7.0)
        cr.set_source_rgb(sub_r, sub_g, sub_b)
        cr.move_to(8, height - 7)
        cr.show_text(lock_txt)

        cr.restore()
        return False

class SpaceNetworkDialog(Gtk.Window):
    def __init__(self):
        super().__init__(title="Apollo Mission Control Comms & Telemetry")
        self.set_wmclass("space-network-dialog", "space-network-dialog")
        self.set_role("dialog")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_default_size(740, 590)

        self.theme_name = get_theme_name()
        self.pal = THEMES.get(self.theme_name, THEMES["nasa"])
        self.stations = []
        self.saved_connections = {}
        self.active_ssid = ""
        self.active_dev = ""
        self.active_type = ""
        self.active_vpn = ""
        self.current_dns = "--"
        self.vpn_connections = []
        self.bt_devices = []
        self.bt_powered = False
        self.bt_scanning = False
        self.bt_connected_name = ""
        self.wifi_enabled = True
        self.is_scanning = False
        self.comm_testing = False
        self.selected_station_idx = 0
        self.station_widgets = []
        self.connecting_ssid = None
        self.dns_ping_labels = {}

        self.apply_css()
        self.build_ui()
        self.connect("key-press-event", self.on_key_press)

        self.update_network_status()
        self.update_bluetooth_status()
        self.scan_wifi_networks()
        GLib.timeout_add(2000, self.update_network_status)
        GLib.timeout_add(3000, self.update_bluetooth_status)

    def apply_css(self):
        css = f"""
        * {{
            font-family: 'JetBrainsMono Nerd Font', monospace;
            background-color: transparent;
        }}
        window {{
            background-color: {self.pal['bg']};
            border: 2px solid {self.pal['border']};
            border-radius: {self.pal['radius']};
        }}
        .header-box {{
            background-color: {self.pal['bg_panel']};
            border-bottom: 2px solid {self.pal['border']};
            padding: 10px 18px;
        }}
        .telemetry-card {{
            background-color: {self.pal['bg_panel']};
            border: 1px solid {self.pal['border_dim']};
            border-radius: {self.pal['radius']};
            padding: 10px 14px;
        }}
        .station-card, .vpn-card, .bt-card, .dns-card {{
            background-color: {self.pal['bg_panel']};
            border: 1px solid {self.pal['border_dim']};
            border-radius: {self.pal['radius']};
            padding: 8px 12px;
            margin-bottom: 6px;
        }}
        .station-card.selected, .vpn-card.selected, .bt-card.selected, .dns-card.selected {{
            border: 1px solid {self.pal['accent']};
            background-color: {self.pal['btn_hover']};
        }}
        .station-card.active, .vpn-card.active, .bt-card.active, .dns-card.active {{
            border: 1.5px solid {self.pal['green']};
        }}
        button,
        button.action-btn {{
            background-image: none;
            background-color: {self.pal['btn_bg']};
            border: 1px solid {self.pal['btn_border']};
            border-radius: {self.pal['radius']};
            padding: 5px 9px;
            box-shadow: none;
            text-shadow: none;
        }}
        button.action-btn:hover {{
            background-color: {self.pal['btn_hover']};
            border: 1px solid {self.pal['accent']};
        }}
        button.connect-btn {{
            background-color: {self.pal['btn_bg']};
            border: 1px solid {self.pal['accent']};
            border-radius: {self.pal['radius']};
            padding: 4px 9px;
        }}
        button.connect-btn:hover {{
            background-color: {self.pal['btn_hover']};
        }}
        button.disconnect-btn {{
            background-color: {self.pal['btn_bg']};
            border: 1px solid {self.pal['red']};
            border-radius: {self.pal['radius']};
            padding: 4px 9px;
        }}
        button.disconnect-btn:hover {{
            background-color: #3b1111;
        }}
        entry {{
            background-color: {self.pal['track_bg']};
            border: 1px solid {self.pal['border_dim']};
            border-radius: {self.pal['radius']};
            color: {self.pal['text_main']};
            padding: 8px 10px;
        }}
        entry:focus {{
            border: 1px solid {self.pal['accent']};
        }}
        combobox button.combo {{
            background-color: {self.pal['track_bg']};
            border: 1px solid {self.pal['border_dim']};
            color: {self.pal['text_main']};
        }}
        scrollbar slider {{
            background-color: {self.pal['accent']};
            border-radius: 2px;
            min-width: 6px;
        }}
        scrollbar trough {{
            background-color: {self.pal['track_bg']};
        }}
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def build_ui(self):
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(150)
        self.add(self.stack)

        self.build_main_view()
        self.build_auth_view()
        self.build_hidden_view()
        self.build_vpn_view()
        self.build_bluetooth_view()
        self.build_comm_test_view()
        self.stack.set_visible_child_name("main")

    def build_main_view(self):
        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        # Header Box
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header.get_style_context().add_class("header-box")

        title = Gtk.Label()
        title.set_markup(f"<span font_weight='bold' font_size='11000' foreground='{self.pal['text_main']}'>📡 APOLLO MISSION CONTROL // COMMS &amp; TELEMETRY UPLINK</span>")
        title.set_xalign(0.0)
        header.pack_start(title, False, False, 0)

        sub = Gtk.Label()
        sub.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>S-BAND RF TRANSCEIVER, HARDWIRE UMBILICAL, COMM TEST &amp; DNS // {self.theme_name.upper()}</span>")
        sub.set_xalign(0.0)
        header.pack_start(sub, False, False, 0)
        main_vbox.pack_start(header, False, False, 0)

        # Body Container
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        body.set_margin_top(10)
        body.set_margin_bottom(10)
        body.set_margin_left(14)
        body.set_margin_right(14)

        # Signal Gauge + Telemetry Card
        top_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

        self.rf_gauge = ApolloRfSignalGauge(self.pal)
        top_hbox.pack_start(self.rf_gauge, False, False, 0)

        self.telemetry_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        self.telemetry_card.get_style_context().add_class("telemetry-card")

        self.lbl_link_status = Gtk.Label()
        self.lbl_link_status.set_xalign(0.0)
        self.telemetry_card.pack_start(self.lbl_link_status, False, False, 0)

        self.lbl_link_ip = Gtk.Label()
        self.lbl_link_ip.set_xalign(0.0)
        self.telemetry_card.pack_start(self.lbl_link_ip, False, False, 0)

        self.lbl_link_rf = Gtk.Label()
        self.lbl_link_rf.set_xalign(0.0)
        self.telemetry_card.pack_start(self.lbl_link_rf, False, False, 0)

        top_hbox.pack_start(self.telemetry_card, True, True, 0)
        body.pack_start(top_hbox, False, False, 0)

        # Action Buttons Toolbar
        action_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)

        # Radio Toggle
        self.btn_radio = Gtk.Button()
        self.btn_radio.get_style_context().add_class("action-btn")
        self.lbl_btn_radio = Gtk.Label()
        self.lbl_btn_radio.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['text_main']}'>[ RADIO: ON ]</span>")
        self.btn_radio.add(self.lbl_btn_radio)
        self.btn_radio.connect("clicked", self.toggle_radio)
        action_bar.pack_start(self.btn_radio, False, False, 0)

        # Rescan Stations
        self.btn_rescan = Gtk.Button()
        self.btn_rescan.get_style_context().add_class("action-btn")
        lbl_r = Gtk.Label()
        lbl_r.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['accent']}'>[ RESCAN ]</span>")
        self.btn_rescan.add(lbl_r)
        self.btn_rescan.connect("clicked", lambda w: self.scan_wifi_networks(force_rescan=True))
        action_bar.pack_start(self.btn_rescan, False, False, 0)

        # Hidden Network Button
        self.btn_hidden = Gtk.Button()
        self.btn_hidden.get_style_context().add_class("action-btn")
        lbl_h = Gtk.Label()
        lbl_h.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['text_sub']}'>[ HIDDEN SSID ]</span>")
        self.btn_hidden.add(lbl_h)
        self.btn_hidden.connect("clicked", lambda w: self.open_hidden_view())
        action_bar.pack_start(self.btn_hidden, False, False, 0)

        # Comm Test & DNS Button
        self.btn_comm_test = Gtk.Button()
