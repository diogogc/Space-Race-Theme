    def render_dns_presets(self):
        for child in self.dns_list_vbox.get_children():
            self.dns_list_vbox.remove(child)

        self.dns_ping_labels = {}

        for p_id, p_name, p_ips, p_ping_ip, p_desc in DNS_PRESETS:
            card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            card.get_style_context().add_class("dns-card")

            d_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            card.pack_start(d_info, True, True, 0)

            title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            lbl_name = Gtk.Label()
            lbl_name.set_markup(f"<span font_weight='bold' font_size='9500' foreground='{self.pal['text_main']}'>{p_name}</span>")
            lbl_name.set_xalign(0.0)
            title_box.pack_start(lbl_name, False, False, 0)

            lbl_ping = Gtk.Label()
            lbl_ping.set_markup(f"<span font_size='7500' foreground='{self.pal['text_dim']}'>[ RTT: -- ]</span>")
            title_box.pack_start(lbl_ping, False, False, 0)
            self.dns_ping_labels[p_id] = lbl_ping

            d_info.pack_start(title_box, False, False, 0)

            lbl_desc = Gtk.Label()
            lbl_desc.set_markup(f"<span font_size='7500' foreground='{self.pal['text_dim']}'>{p_desc}</span>")
            lbl_desc.set_xalign(0.0)
            d_info.pack_start(lbl_desc, False, False, 0)

            btn_set = Gtk.Button()
            btn_set.get_style_context().add_class("connect-btn")
            lbl_s = Gtk.Label()
            lbl_s.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['green']}'>[ ENGAGE ]</span>")
            btn_set.add(lbl_s)
            btn_set.connect("clicked", lambda w, ips=p_ips, name=p_name: self.apply_dns(ips, name))
            card.pack_end(btn_set, False, False, 0)

            self.dns_list_vbox.pack_start(card, False, False, 0)

        self.dns_list_vbox.show_all()

    def open_comm_test_view(self):
        self.lbl_test_dns_active.set_markup(
            f"<span font_size='8000' foreground='{self.pal['text_dim']}'>CURRENT ACTIVE DNS: <span foreground='{self.pal['accent']}'>{self.current_dns}</span> | INTERFACE: {self.active_dev or '--'}</span>"
        )
        self.stack.set_visible_child_name("comm_test")
        self.ping_all_dns_servers()

    def ping_all_dns_servers(self):
        def _worker():
            for p_id, p_name, p_ips, p_ping_ip, p_desc in DNS_PRESETS:
                if not p_ping_ip:
                    target = "1.1.1.1"
                else:
                    target = p_ping_ip

                res = subprocess.run(["ping", "-c", "1", "-W", "1", target], capture_output=True, text=True).stdout
                m = re.search(r"time=([0-9.]+)\s*ms", res)
                rtt_str = f"{m.group(1)} ms" if m else "TIMEOUT"
                
                col = self.pal['green'] if m and float(m.group(1)) < 50 else (self.pal['yellow'] if m else self.pal['red'])

                def _update_ui(pid=p_id, rtt=rtt_str, color=col):
                    if pid in self.dns_ping_labels:
                        self.dns_ping_labels[pid].set_markup(f"<span font_size='7500' foreground='{color}'>[ RTT: {rtt} ]</span>")

                GLib.idle_add(_update_ui)

        threading.Thread(target=_worker, daemon=True).start()

    def run_comm_test(self):
        if self.comm_testing:
            return
        self.comm_testing = True
        self.btn_run_test.set_sensitive(False)
        self.lbl_test_status.set_markup(f"<span font_weight='bold' font_size='9500' foreground='{self.pal['yellow']}'>🔄 COMM TEST IN PROGRESS: MEASURING PING &amp; BANDWIDTH...</span>")

        def _worker():
            # 1. Ping test
            ping_out = subprocess.run(["ping", "-c", "4", "-W", "1", "1.1.1.1"], capture_output=True, text=True).stdout
            m_rtt = re.search(r"min/avg/max/mdev\s*=\s*[0-9.]+/([0-9.]+)/", ping_out)
            avg_rtt = m_rtt.group(1) if m_rtt else "--"
            m_loss = re.search(r"([0-9]+)%\s*packet loss", ping_out)
            loss_pct = m_loss.group(1) if m_loss else "0"

            GLib.idle_add(lambda: self.lbl_test_results.set_markup(
                f"<span font_size='8200' foreground='{self.pal['text_sub']}'>PING: <span foreground='{self.pal['accent']}'>{avg_rtt} ms</span> | LOSS: {loss_pct}% | MEASURING DOWNLOAD...</span>"
            ))

            # 2. Download speed test via Cloudflare CDN endpoint
            down_speed_mbit = 0.0
            try:
                dl_out = subprocess.run(
                    ["curl", "-s", "-w", "%{speed_download}", "-o", "/dev/null", "https://speed.cloudflare.com/__down?bytes=10000000"],
                    capture_output=True, text=True, timeout=12
                ).stdout.strip()
                if dl_out and dl_out.isdigit():
                    down_speed_mbit = (float(dl_out) * 8.0) / 1000000.0
            except Exception:
                pass

            GLib.idle_add(lambda: self.lbl_test_results.set_markup(
                f"<span font_size='8200' foreground='{self.pal['text_sub']}'>PING: <span foreground='{self.pal['accent']}'>{avg_rtt} ms</span> | LOSS: {loss_pct}% | DOWN: <span foreground='{self.pal['green']}'>{down_speed_mbit:.1f} Mbit/s</span> | MEASURING UPLOAD...</span>"
            ))

            # 3. Upload speed test
            up_speed_mbit = 0.0
            try:
                ul_out = subprocess.run(
                    ["curl", "-s", "-w", "%{speed_upload}", "-o", "/dev/null", "-X", "POST", "--data-binary", "@-", "https://speed.cloudflare.com/__up"],
                    input=b"\x00" * 2000000, capture_output=True, text=False, timeout=12
                ).stdout.decode('utf-8', errors='ignore').strip()
                if ul_out and ul_out.isdigit():
                    up_speed_mbit = (float(ul_out) * 8.0) / 1000000.0
            except Exception:
                pass

            def _finish():
                self.comm_testing = False
                self.btn_run_test.set_sensitive(True)
                self.lbl_test_status.set_markup(f"<span font_weight='bold' font_size='9500' foreground='{self.pal['green']}'>● COMM TEST COMPLETED // CARRIER VERIFIED NOMINAL</span>")
                self.lbl_test_results.set_markup(
                    f"<span font_size='8200' foreground='{self.pal['text_sub']}'>PING: <span foreground='{self.pal['accent']}'>{avg_rtt} ms</span> | LOSS: {loss_pct}% | DOWNLOAD: <span foreground='{self.pal['green']}'>{down_speed_mbit:.1f} Mbit/s</span> | UPLOAD: <span foreground='{self.pal['green']}'>{up_speed_mbit:.1f} Mbit/s</span></span>"
                )
                subprocess.run([
                    "notify-send", "-t", "3500",
                    "COMM DIAGNOSTIC COMPLETED",
                    f"Ping: {avg_rtt}ms | Down: {down_speed_mbit:.1f} Mb/s | Up: {up_speed_mbit:.1f} Mb/s"
                ])

            GLib.idle_add(_finish)

        threading.Thread(target=_worker, daemon=True).start()

    def apply_dns(self, dns_ips, name):
        if not self.active_ssid:
            subprocess.run(["notify-send", "-t", "3000", "DNS ENGAGE FAILED", "No active connection link"])
            return

        def _worker():
            if not dns_ips:
                subprocess.run(["nmcli", "connection", "modify", self.active_ssid, "ipv4.dns", "", "ipv4.ignore-auto-dns", "no"])
            else:
                subprocess.run(["nmcli", "connection", "modify", self.active_ssid, "ipv4.dns", dns_ips, "ipv4.ignore-auto-dns", "yes"])

            res = subprocess.run(["nmcli", "connection", "up", "id", self.active_ssid], capture_output=True, text=True)

            def _done():
                self.update_network_status()
                if res.returncode == 0:
                    subprocess.run([
                        "notify-send", "-t", "3500",
                        "GROUND STATION DNS ENGAGED",
                        f"Active DNS Relay: {name}"
                    ])
                    self.lbl_test_dns_active.set_markup(
                        f"<span font_size='8000' foreground='{self.pal['green']}'>ACTIVE DNS UPDATED // {name} ({dns_ips or 'DHCP'})</span>"
                    )
                else:
                    err = res.stderr.strip() or res.stdout.strip()
                    subprocess.run([
                        "notify-send", "-t", "4000",
                        "DNS ENGAGE FAILED",
                        f"{err}"
                    ])

            GLib.idle_add(_done)

        threading.Thread(target=_worker, daemon=True).start()

    def apply_custom_dns(self):
        custom_ips = self.entry_custom_dns.get_text().strip()
        if not custom_ips:
            return
        self.apply_dns(custom_ips, f"Custom ({custom_ips})")

    def open_hidden_view(self):
        self.entry_hidden_ssid.set_text("")
        self.entry_hidden_pass.set_text("")
        self.lbl_hidden_status.set_markup("")
        self.stack.set_visible_child_name("hidden")
        self.entry_hidden_ssid.grab_focus()

    def open_vpn_view(self):
        self.update_vpn_list()
        self.stack.set_visible_child_name("vpn")

    def open_bluetooth_view(self):
        self.update_bluetooth_status()
        self.stack.set_visible_child_name("bluetooth")

    def submit_hidden_connect(self):
        ssid = self.entry_hidden_ssid.get_text().strip()
        passphrase = self.entry_hidden_pass.get_text().strip()
        sec_type = self.combo_hidden_sec.get_active_id()

        if not ssid:
            self.lbl_hidden_status.set_markup(f"<span font_size='8000' foreground='{self.pal['red']}'>ERROR: SSID cannot be empty</span>")
            return

        if sec_type == "wpa" and not passphrase:
            self.lbl_hidden_status.set_markup(f"<span font_size='8000' foreground='{self.pal['red']}'>ERROR: WPA passphrase required</span>")
            return

        self.lbl_hidden_status.set_markup(f"<span font_size='8000' foreground='{self.pal['yellow']}'>ENGAGING HIDDEN CARRIER LINK TO {ssid}...</span>")
        self.btn_hidden_connect.set_sensitive(False)

        def _worker():
            if sec_type == "wpa":
                cmd = ["nmcli", "dev", "wifi", "connect", ssid, "password", passphrase, "hidden", "yes"]
            else:
                cmd = ["nmcli", "dev", "wifi", "connect", ssid, "hidden", "yes"]

            res = subprocess.run(cmd, capture_output=True, text=True)

            def _done():
                self.btn_hidden_connect.set_sensitive(True)
                if res.returncode == 0:
                    self.stack.set_visible_child_name("main")
                    self.update_network_status()
                    self.scan_wifi_networks()
                    subprocess.run([
                        "notify-send", "-t", "3500",
                        "TELEMETRY UPLINK ESTABLISHED",
                        f"Connected to hidden station: {ssid}"
                    ])
                else:
                    err = res.stderr.strip() or res.stdout.strip()
                    self.lbl_hidden_status.set_markup(f"<span font_size='8000' foreground='{self.pal['red']}'>LINK FAILED: {err}</span>")

            GLib.idle_add(_done)

        threading.Thread(target=_worker, daemon=True).start()

    def import_vpn_file_dialog(self):
        dialog = Gtk.FileChooserDialog(
            title="Import VPN Profile (.ovpn / .conf)",
            parent=self,
            action=Gtk.FileChooserAction.OPEN
        )
        dialog.add_buttons(
            Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OPEN, Gtk.ResponseType.OK
        )

        filter_vpn = Gtk.FileFilter()
        filter_vpn.set_name("VPN Configs (*.ovpn, *.conf)")
        filter_vpn.add_pattern("*.ovpn")
        filter_vpn.add_pattern("*.conf")
        dialog.add_filter(filter_vpn)

        filter_all = Gtk.FileFilter()
        filter_all.set_name("All Files")
        filter_all.add_pattern("*")
        dialog.add_filter(filter_all)

        response = dialog.run()
        file_path = dialog.get_filename() if response == Gtk.ResponseType.OK else None
        dialog.destroy()

        if file_path and os.path.exists(file_path):
            self.do_import_vpn(file_path)

    def do_import_vpn(self, file_path):
        def _worker():
            vpn_type = "openvpn" if file_path.endswith(".ovpn") else "wireguard"
            res = subprocess.run(["nmcli", "connection", "import", "type", vpn_type, "file", file_path], capture_output=True, text=True)
            
            def _done():
                if res.returncode == 0:
                    subprocess.run([
                        "notify-send", "-t", "3500",
                        "VPN PROFILE IMPORTED",
                        f"Successfully imported: {os.path.basename(file_path)}"
                    ])
                    self.update_vpn_list()
                else:
                    err = res.stderr.strip() or res.stdout.strip()
                    subprocess.run([
                        "notify-send", "-t", "4000",
                        "VPN IMPORT FAILED",
                        f"{err}"
                    ])

            GLib.idle_add(_done)

        threading.Thread(target=_worker, daemon=True).start()

    def update_vpn_list(self):
        def _fetch():
            out = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE,UUID,DEVICE", "connection", "show"], capture_output=True, text=True).stdout
            vpns = []
            active_vpn_name = ""
            for line in out.splitlines():
                parts = line.strip().split(":")
                if len(parts) >= 3:
                    c_name, c_type, c_uuid = parts[0], parts[1], parts[2]
                    c_dev = parts[3] if len(parts) > 3 else ""
                    if any(vt in c_type.lower() for vt in ["vpn", "wireguard", "tun", "tap"]):
                        is_act = bool(c_dev)
                        if is_act:
                            active_vpn_name = c_name
                        vpns.append({
                            "name": c_name,
                            "type": c_type,
                            "uuid": c_uuid,
                            "active": is_act,
                            "dev": c_dev
                        })
            return vpns, active_vpn_name

        def _apply(res):
            vpns, active_name = res
            self.vpn_connections = vpns
            self.active_vpn = active_name

            if active_name:
                self.lbl_vpn_active_status.set_markup(
                    f"<span font_weight='bold' font_size='9500' foreground='{self.pal['green']}'>● SECURE TUNNEL ACTIVE // {active_name}</span>"
                )
                self.lbl_vpn_details.set_markup(
                    f"<span font_size='8000' foreground='{self.pal['text_sub']}'>Encrypted telemetry routing enabled.</span>"
                )
            else:
                self.lbl_vpn_active_status.set_markup(
                    f"<span font_weight='bold' font_size='9500' foreground='{self.pal['text_dim']}'>○ NO ACTIVE SECURE TUNNEL</span>"
                )
                self.lbl_vpn_details.set_markup(
                    f"<span font_size='8000' foreground='{self.pal['text_dim']}'>Standard unencrypted carrier routing. Select a profile below.</span>"
                )

            for child in self.vpn_list_vbox.get_children():
                self.vpn_list_vbox.remove(child)

            if not vpns:
                empty_lbl = Gtk.Label()
                empty_lbl.set_markup(f"<span font_size='8500' foreground='{self.pal['text_dim']}'>No VPN tunnel profiles configured yet.\nClick [ CREATE / EDIT VPN ] or [ IMPORT ] above to add.</span>")
                empty_lbl.set_margin_top(20)
                self.vpn_list_vbox.pack_start(empty_lbl, True, True, 0)
            else:
                for v in vpns:
                    card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                    card.get_style_context().add_class("vpn-card")
                    if v["active"]:
                        card.get_style_context().add_class("active")

                    v_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                    card.pack_start(v_info, True, True, 0)

                    v_title = Gtk.Label()
                    v_title.set_markup(f"<span font_weight='bold' font_size='9500' foreground='{self.pal['text_main']}'>{v['name']}</span>")
                    v_title.set_xalign(0.0)
                    v_info.pack_start(v_title, False, False, 0)

                    v_sub = Gtk.Label()
                    v_sub.set_markup(f"<span font_size='7500' foreground='{self.pal['text_dim']}'>TYPE: {v['type'].upper()} | UUID: {v['uuid'][:8]}...</span>")
                    v_sub.set_xalign(0.0)
                    v_info.pack_start(v_sub, False, False, 0)

                    if v["active"]:
                        btn_act = Gtk.Button()
                        btn_act.get_style_context().add_class("disconnect-btn")
                        lbl_b = Gtk.Label()
                        lbl_b.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['red']}'>DISENGAGE</span>")
                        btn_act.add(lbl_b)
                        btn_act.connect("clicked", lambda w, name=v['name']: self.toggle_vpn(name, False))
                        card.pack_end(btn_act, False, False, 0)
                    else:
                        btn_act = Gtk.Button()
                        btn_act.get_style_context().add_class("connect-btn")
                        lbl_b = Gtk.Label()
                        lbl_b.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['accent']}'>ENGAGE</span>")
                        btn_act.add(lbl_b)
                        btn_act.connect("clicked", lambda w, name=v['name']: self.toggle_vpn(name, True))
                        card.pack_end(btn_act, False, False, 0)

                    self.vpn_list_vbox.pack_start(card, False, False, 0)

            self.vpn_list_vbox.show_all()

        def _worker():
            try:
                res = _fetch()
                GLib.idle_add(_apply, res)
            except Exception as e:
                print("Error updating VPN list:", e, file=sys.stderr)

        threading.Thread(target=_worker, daemon=True).start()

    def toggle_vpn(self, vpn_name, activate=True):
        def _worker():
            action = "up" if activate else "down"
            res = subprocess.run(["nmcli", "connection", action, "id", vpn_name], capture_output=True, text=True)
            def _done():
                self.update_vpn_list()
                self.update_network_status()
                status_txt = "ENGAGED" if activate else "DISENGAGED"
                if res.returncode == 0:
                    subprocess.run([
                        "notify-send", "-t", "3500",
                        f"VPN TUNNEL {status_txt}",
                        f"Secure tunnel: {vpn_name}"
                    ])
                else:
                    err = res.stderr.strip() or res.stdout.strip()
                    subprocess.run([
                        "notify-send", "-t", "4000",
                        "VPN ACTION FAILED",
                        f"{err}"
                    ])

            GLib.idle_add(_done)

        threading.Thread(target=_worker, daemon=True).start()

    # --- BLUETOOTH MANAGEMENT SUBSYSTEM ---
    def update_bluetooth_status(self):
        def _fetch():
            show_out = subprocess.run(["bluetoothctl", "show"], capture_output=True, text=True).stdout
            powered = ("Powered: yes" in show_out)
            discovering = ("Discovering: yes" in show_out)
            
            ctrl_mac = ""
            ctrl_name = ""
            m_mac = re.search(r"Controller\s+([0-9A-Fa-f:]{17})", show_out)
            if m_mac: ctrl_mac = m_mac.group(1)
            m_name = re.search(r"Name:\s+(.+)", show_out)
            if m_name: ctrl_name = m_name.group(1).strip()

            devices_out = subprocess.run(["bluetoothctl", "devices"], capture_output=True, text=True).stdout
            dev_list = []
            connected_name = ""

            for line in devices_out.splitlines():
                parts = line.strip().split(" ", 2)
                if len(parts) >= 3 and parts[0] == "Device":
                    mac = parts[1]
                    name = parts[2]
                    info_out = subprocess.run(["bluetoothctl", "info", mac], capture_output=True, text=True).stdout
                    connected = ("Connected: yes" in info_out)
                    paired = ("Paired: yes" in info_out)
                    trusted = ("Trusted: yes" in info_out)
                    battery = None
                    for iline in info_out.splitlines():
                        if "Battery Percentage:" in iline:
                            m_bat = re.search(r"\((\d+)\)", iline)
                            if m_bat:
                                battery = m_bat.group(1)
                    if connected:
                        connected_name = name
                    dev_list.append({
                        "mac": mac,
                        "name": name,
                        "connected": connected,
                        "paired": paired,
                        "trusted": trusted,
                        "battery": battery
                    })

            dev_list.sort(key=lambda x: (not x["connected"], not x["paired"], x["name"]))
            return {
                "powered": powered,
                "discovering": discovering,
                "ctrl_mac": ctrl_mac,
                "ctrl_name": ctrl_name,
                "devices": dev_list,
                "connected_name": connected_name
            }

        def _apply(res):
            self.bt_powered = res["powered"]
            self.bt_devices = res["devices"]
            self.bt_connected_name = res["connected_name"]

            # Update Button text
            p_col = self.pal['green'] if self.bt_powered else self.pal['red']
            p_txt = "ON" if self.bt_powered else "OFF"
            self.lbl_bt_btn_pwr.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{p_col}'>[ POWER: {p_txt} ]</span>")

            # Update Bluetooth Overview Card
            if self.bt_powered:
                self.lbl_bt_power_status.set_markup(
                    f"<span font_weight='bold' font_size='9500' foreground='{self.pal['green']}'>● VHF BLUETOOTH RADIO POWERED // {res['ctrl_name']} ({res['ctrl_mac']})</span>"
                )
                if res["connected_name"]:
                    self.lbl_bt_active_device.set_markup(
                        f"<span font_size='8000' foreground='{self.pal['text_sub']}'>ACTIVE PERIPHERAL: <span foreground='{self.pal['accent']}'>{res['connected_name']}</span> (LINK ESTABLISHED)</span>"
                    )
                else:
                    self.lbl_bt_active_device.set_markup(
                        f"<span font_size='8000' foreground='{self.pal['text_dim']}'>NO ACTIVE PERIPHERAL LINK // {len(res['devices'])} DEVICES IN MEMORY</span>"
                    )
            else:
                self.lbl_bt_power_status.set_markup(
                    f"<span font_weight='bold' font_size='9500' foreground='{self.pal['red']}'>● VHF BLUETOOTH RADIO MUTED / POWERED OFF</span>"
                )
                self.lbl_bt_active_device.set_markup(
                    f"<span font_size='8000' foreground='{self.pal['text_dim']}'>Radio disabled. Press [ POWER: ON ] or 'P' to engage transceiver.</span>"
                )

            # Render Devices List
            for child in self.bt_list_vbox.get_children():
                self.bt_list_vbox.remove(child)

            if not res["devices"]:
                empty_lbl = Gtk.Label()
                empty_lbl.set_markup(f"<span font_size='8500' foreground='{self.pal['text_dim']}'>No paired or discovered Bluetooth devices found.\nClick [ SCAN DEVICES ] above to discover nearby peripherals.</span>")
                empty_lbl.set_margin_top(20)
                self.bt_list_vbox.pack_start(empty_lbl, True, True, 0)
            else:
                for d in res["devices"]:
                    card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                    card.get_style_context().add_class("bt-card")
                    if d["connected"]:
                        card.get_style_context().add_class("active")

                    d_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                    card.pack_start(d_info, True, True, 0)

                    title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                    d_title = Gtk.Label()
                    d_title.set_markup(f"<span font_weight='bold' font_size='9500' foreground='{self.pal['text_main']}'>{d['name']}</span>")
                    d_title.set_xalign(0.0)
                    title_box.pack_start(d_title, False, False, 0)

                    if d["connected"]:
                        lbl_c_tag = Gtk.Label()
                        lbl_c_tag.set_markup(f"<span font_weight='bold' font_size='7500' foreground='{self.pal['green']}'>[ CONNECTED ]</span>")
                        title_box.pack_start(lbl_c_tag, False, False, 0)
                    elif d["paired"]:
                        lbl_p_tag = Gtk.Label()
                        lbl_p_tag.set_markup(f"<span font_size='7500' foreground='{self.pal['accent']}'>[ PAIRED ]</span>")
                        title_box.pack_start(lbl_p_tag, False, False, 0)

                    d_info.pack_start(title_box, False, False, 0)

                    bat_str = f" | BATTERY: {d['battery']}%" if d['battery'] else ""
                    trusted_str = "TRUSTED" if d['trusted'] else "UNTRUSTED"
                    d_sub = Gtk.Label()
                    d_sub.set_markup(f"<span font_size='7500' foreground='{self.pal['text_dim']}'>MAC: {d['mac']} | {trusted_str}{bat_str}</span>")
                    d_sub.set_xalign(0.0)
                    d_info.pack_start(d_sub, False, False, 0)

                    # Connect / Disconnect / Pair button
                    if d["connected"]:
                        btn_conn = Gtk.Button()
                        btn_conn.get_style_context().add_class("disconnect-btn")
                        lbl_cb = Gtk.Label()
                        lbl_cb.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['red']}'>DISCONNECT</span>")
                        btn_conn.add(lbl_cb)
                        btn_conn.connect("clicked", lambda w, mac=d['mac']: self.disconnect_bt_device(mac))
                        card.pack_end(btn_conn, False, False, 0)
                    else:
                        btn_conn = Gtk.Button()
                        btn_conn.get_style_context().add_class("connect-btn")
                        lbl_cb = Gtk.Label()
                        btn_lbl_txt = "CONNECT" if d['paired'] else "PAIR &amp; CONNECT"
                        lbl_cb.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['accent']}'>{btn_lbl_txt}</span>")
                        btn_conn.add(lbl_cb)
                        btn_conn.connect("clicked", lambda w, dev=d: self.connect_bt_device(dev))
                        card.pack_end(btn_conn, False, False, 0)

                    # Remove button if paired
                    if d["paired"]:
                        btn_rm = Gtk.Button()
                        btn_rm.get_style_context().add_class("action-btn")
                        lbl_rm = Gtk.Label()
                        lbl_rm.set_markup(f"<span font_size='7500' foreground='{self.pal['text_dim']}'>UNPAIR</span>")
                        btn_rm.add(lbl_rm)
                        btn_rm.connect("clicked", lambda w, mac=d['mac']: self.remove_bt_device(mac))
                        card.pack_end(btn_rm, False, False, 0)

                    self.bt_list_vbox.pack_start(card, False, False, 0)

            self.bt_list_vbox.show_all()

        def _worker():
            try:
                res = _fetch()
                GLib.idle_add(_apply, res)
            except Exception as e:
                print("Error updating bluetooth status:", e, file=sys.stderr)

        threading.Thread(target=_worker, daemon=True).start()
        return True

    def toggle_bluetooth_power(self):
        new_state = "off" if self.bt_powered else "on"
        subprocess.run(["bluetoothctl", "power", new_state])
        self.update_bluetooth_status()
        self.update_network_status()

    def toggle_bluetooth_pairable(self):
        subprocess.run(["bluetoothctl", "pairable", "on"])
        subprocess.run(["bluetoothctl", "discoverable", "on"])
        subprocess.run([
            "notify-send", "-t", "3000",
            "BLUETOOTH PAIRABLE ENGAGED",
            "Controller is now discoverable and pairable."
        ])

    def scan_bluetooth_devices(self):
        if self.bt_scanning:
            return
        self.bt_scanning = True
        self.lbl_bt_scan_status.set_markup(f"<span font_size='8000' foreground='{self.pal['yellow']}'>🔄 SCANNING ISM 2.4GHz FREQUENCIES...</span>")

        def _worker():
            subprocess.run(["bluetoothctl", "--timeout", "6", "scan", "on"], capture_output=True, text=True)
            def _done():
                self.bt_scanning = False
                self.lbl_bt_scan_status.set_markup(f"<span font_size='8000' foreground='{self.pal['green']}'>[ DISCOVERY COMPLETE ]</span>")
                self.update_bluetooth_status()

            GLib.idle_add(_done)

        threading.Thread(target=_worker, daemon=True).start()

    def connect_bt_device(self, dev):
        mac = dev["mac"]
        def _worker():
            if not dev["paired"]:
                subprocess.run(["bluetoothctl", "pair", mac], capture_output=True, text=True)
                subprocess.run(["bluetoothctl", "trust", mac], capture_output=True, text=True)
            res = subprocess.run(["bluetoothctl", "connect", mac], capture_output=True, text=True)
            def _done():
                self.update_bluetooth_status()
                if res.returncode == 0:
                    subprocess.run([
                        "notify-send", "-t", "3500",
                        "BLUETOOTH LINK ESTABLISHED",
                        f"Connected to peripheral: {dev['name']}"
                    ])
                else:
                    err = res.stderr.strip() or res.stdout.strip()
                    subprocess.run([
                        "notify-send", "-t", "4000",
                        "BLUETOOTH LINK FAILED",
                        f"Failed to connect to {dev['name']}: {err}"
                    ])

            GLib.idle_add(_done)

        threading.Thread(target=_worker, daemon=True).start()

    def disconnect_bt_device(self, mac):
        def _worker():
            subprocess.run(["bluetoothctl", "disconnect", mac], capture_output=True, text=True)
            GLib.idle_add(lambda: self.update_bluetooth_status())
            subprocess.run([
                "notify-send", "-t", "3000",
                "BLUETOOTH LINK DISENGAGED",
                f"Disconnected peripheral: {mac}"
            ])

        threading.Thread(target=_worker, daemon=True).start()

    def remove_bt_device(self, mac):
        def _worker():
            subprocess.run(["bluetoothctl", "remove", mac], capture_output=True, text=True)
            GLib.idle_add(lambda: self.update_bluetooth_status())

        threading.Thread(target=_worker, daemon=True).start()

    def launch_blueman(self):
        try:
            subprocess.Popen(["blueman-manager"], start_new_session=True)
            self.close_window()
        except Exception as e:
            print("Error launching blueman-manager:", e, file=sys.stderr)

    # --- NETWORK TELEMETRY ---
    def update_network_status(self):
        def _fetch():
            radio_out = subprocess.run(["nmcli", "radio", "wifi"], capture_output=True, text=True).stdout.strip()
            wifi_on = (radio_out.lower() == "enabled")

            dev_out = subprocess.run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status"], capture_output=True, text=True).stdout
            active_conn = None
            active_dev = None
            active_type = None
            active_vpn_name = None

            for line in dev_out.splitlines():
                parts = line.strip().split(":")
                if len(parts) >= 4 and parts[2] == "connected" and parts[1] != "loopback":
                    if any(vt in parts[1].lower() for vt in ["vpn", "wireguard", "tun", "tap"]):
                        active_vpn_name = parts[3]
                    elif not active_conn:
                        active_dev = parts[0]
                        active_type = parts[1]
                        active_conn = parts[3]

            ip_str = "0.0.0.0"
            gw_str = "--"
            dns_str = "--"
            freq_str = "--"
            rate_str = "--"
            sig_pct = 0
            eth_speed = ""

            if active_dev:
                detail_out = subprocess.run(["nmcli", "-t", "-f", "IP4.ADDRESS,IP4.GATEWAY,IP4.DNS", "device", "show", active_dev], capture_output=True, text=True).stdout
                for line in detail_out.splitlines():
                    if line.startswith("IP4.ADDRESS"):
                        ip_str = line.split(":", 1)[1].strip()
                    elif line.startswith("IP4.GATEWAY"):
                        gw_str = line.split(":", 1)[1].strip()
                    elif line.startswith("IP4.DNS"):
                        dns_str = line.split(":", 1)[1].strip()

                if active_type in ["wifi", "802-11-wireless"]:
                    wf_out = subprocess.run(["nmcli", "-t", "-f", "IN-USE,SSID,FREQ,RATE,SIGNAL,SECURITY", "device", "wifi"], capture_output=True, text=True).stdout
                    for line in wf_out.splitlines():
                        parts = line.strip().split(":")
                        if parts[0] == "*":
                            if len(parts) >= 5:
                                freq_str = parts[2]
                                rate_str = parts[3]
                                if parts[4].isdigit():
                                    sig_pct = int(parts[4])
                            break
                elif active_type in ["ethernet", "802-3-ethernet"]:
                    speed_path = f"/sys/class/net/{active_dev}/speed"
                    duplex_path = f"/sys/class/net/{active_dev}/duplex"
                    speed_val = ""
                    duplex_val = ""
                    if os.path.exists(speed_path):
                        try:
                            with open(speed_path) as f: speed_val = f.read().strip()
                        except Exception: pass
                    if os.path.exists(duplex_path):
                        try:
                            with open(duplex_path) as f: duplex_val = f.read().strip().title()
                        except Exception: pass
                    
                    if speed_val and speed_val.isdigit():
                        eth_speed = f"{speed_val} Mbit/s"
                        if duplex_val:
                            eth_speed += f" ({duplex_val})"
                    else:
                        eth_speed = "Gigabit / Fast Ethernet"
                    sig_pct = 100

            conns_out = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE,UUID", "connection", "show"], capture_output=True, text=True).stdout
            saved = {}
            for line in conns_out.splitlines():
                p = line.strip().split(":")
                if len(p) >= 3:
                    saved[p[0]] = {"type": p[1], "uuid": p[2]}

            return {
                "wifi_on": wifi_on,
                "active_conn": active_conn,
                "active_dev": active_dev,
                "active_type": active_type,
                "active_vpn": active_vpn_name,
                "ip": ip_str,
                "gw": gw_str,
                "dns": dns_str,
                "freq": freq_str,
                "rate": rate_str,
                "sig_pct": sig_pct,
                "eth_speed": eth_speed,
                "saved": saved
            }

        def _apply(res):
            self.wifi_enabled = res["wifi_on"]
            self.active_ssid = res["active_conn"] or ""
            self.active_dev = res["active_dev"] or ""
            self.active_type = res["active_type"] or ""
            self.active_vpn = res["active_vpn"] or ""
            self.current_dns = res["dns"] or "--"
            self.saved_connections = res["saved"]

            r_col = self.pal['green'] if self.wifi_enabled else self.pal['red']
            r_txt = "ON" if self.wifi_enabled else "OFF"
            self.lbl_btn_radio.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{r_col}'>[ RADIO: {r_txt} ]</span>")

            vpn_tag = f" <span foreground='{self.pal['green']}'>[ VPN: {self.active_vpn} ]</span>" if self.active_vpn else ""
            bt_tag = f" | <span foreground='{self.pal['accent']}'>BT: {self.bt_connected_name}</span>" if self.bt_connected_name else (f" | <span foreground='{self.pal['text_dim']}'>BT: ON</span>" if self.bt_powered else "")

            is_wired = (res["active_type"] in ["ethernet", "802-3-ethernet"])

            if is_wired:
                self.rf_gauge.set_signal(100, connected=True, status="UMBILICAL HARDWIRE", mode="ethernet", readout_override=res["eth_speed"])
                self.lbl_link_status.set_markup(
                    f"<span font_weight='bold' font_size='9500' foreground='{self.pal['green']}'>● ETHERNET UMBILICAL LINK ACTIVE // {res['active_conn']}</span>{vpn_tag}"
                )
                self.lbl_link_ip.set_markup(
                    f"<span font_size='8000' foreground='{self.pal['text_sub']}'>IP: <span foreground='{self.pal['accent']}'>{res['ip']}</span> | GW: {res['gw']} | DNS: {res['dns']}</span>"
                )
                self.lbl_link_rf.set_markup(
                    f"<span font_size='8000' foreground='{self.pal['text_dim']}'>INTERFACE: {res['active_dev']} ({res['eth_speed']}) | HARDWIRE TELEMETRY{bt_tag}</span>"
                )
            elif not self.wifi_enabled and not res["active_conn"]:
                self.rf_gauge.set_signal(0, connected=False, status="RADIO SILENCE", mode="wifi")
                self.lbl_link_status.set_markup(f"<span font_weight='bold' font_size='9500' foreground='{self.pal['red']}'>● CARRIER LINK: RADIO MUTED / DISABLED</span>{vpn_tag}")
                self.lbl_link_ip.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>Uplink offline. Enable radio with [ RADIO ] or 'W'.{bt_tag}</span>")
                self.lbl_link_rf.set_markup("")
            elif res["active_conn"]:
                status_txt = "NOMINAL UPLINK" if res["sig_pct"] >= 50 else "FAIR CARRIER"
                self.rf_gauge.set_signal(res["sig_pct"], connected=True, status=status_txt, mode="wifi")
                
                self.lbl_link_status.set_markup(
                    f"<span font_weight='bold' font_size='9500' foreground='{self.pal['green']}'>● WIFI RF LINK ACTIVE // {res['active_conn']}</span>{vpn_tag}"
                )
                self.lbl_link_ip.set_markup(
                    f"<span font_size='8000' foreground='{self.pal['text_sub']}'>IP: <span foreground='{self.pal['accent']}'>{res['ip']}</span> | GW: {res['gw']} | DNS: {res['dns']}</span>"
                )
                self.lbl_link_rf.set_markup(
                    f"<span font_size='8000' foreground='{self.pal['text_dim']}'>BAND: {res['freq']} | RATE: {res['rate']} | DEV: {res['active_dev']}{bt_tag}</span>"
                )
            else:
                self.rf_gauge.set_signal(0, connected=False, status="SEARCHING", mode="wifi")
                self.lbl_link_status.set_markup(f"<span font_weight='bold' font_size='9500' foreground='{self.pal['yellow']}'>○ UPLINK DISCONNECTED // SCANNING CARRIER</span>{vpn_tag}")
                self.lbl_link_ip.set_markup(f"<span font_size='8000' foreground='{self.pal['text_dim']}'>No active station link. Select an access point below.{bt_tag}</span>")
                self.lbl_link_rf.set_markup("")

            return False

        def _worker():
            try:
                res = _fetch()
                GLib.idle_add(_apply, res)
            except Exception as e:
                print("Error fetching network status:", e, file=sys.stderr)

        threading.Thread(target=_worker, daemon=True).start()
        return True

    def scan_wifi_networks(self, force_rescan=False):
        if self.is_scanning:
            return
        self.is_scanning = True
        self.lbl_scan_status.set_markup(f"<span font_size='8000' foreground='{self.pal['yellow']}'>🔄 SCANNING S-BAND FREQUENCIES...</span>")

        def _worker():
            cmd = ["nmcli", "-t", "-f", "ACTIVE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY", "dev", "wifi", "list"]
            if force_rescan:
                cmd.extend(["--rescan", "yes"])
            else:
                cmd.extend(["--rescan", "auto"])

            try:
                out = subprocess.run(cmd, capture_output=True, text=True).stdout
                networks = []
                seen_ssids = set()

                for line in out.splitlines():
                    parts = line.strip().split(":")
                    if len(parts) >= 9:
                        active = (parts[0] == "yes")
                        ssid = parts[1]
                        bssid = parts[2]
                        chan = parts[3]
                        freq = parts[4]
                        rate = parts[5]
                        signal_pct = int(parts[6]) if parts[6].isdigit() else 0
                        bars = parts[7]
                        security = parts[8]

                        if not ssid:
                            continue

                        if ssid in seen_ssids:
                            continue
                        seen_ssids.add(ssid)

                        networks.append({
                            "active": active,
                            "ssid": ssid,
                            "bssid": bssid,
                            "chan": chan,
                            "freq": freq,
                            "rate": rate,
                            "signal": signal_pct,
                            "bars": bars,
                            "security": security
                        })

                networks.sort(key=lambda x: (not x["active"], -x["signal"]))
                GLib.idle_add(self._render_stations_list, networks)
            except Exception as e:
                print("Error scanning wifi:", e, file=sys.stderr)
                GLib.idle_add(lambda: self.lbl_scan_status.set_markup(f"<span font_size='8000' foreground='{self.pal['red']}'>SCAN FAILED</span>"))
            finally:
                self.is_scanning = False

        threading.Thread(target=_worker, daemon=True).start()

    def _render_stations_list(self, networks):
        self.stations = networks
        self.lbl_scan_status.set_markup(f"<span font_size='8000' foreground='{self.pal['green']}'>[ {len(networks)} STATIONS DISCOVERED ]</span>")

        for child in self.stations_vbox.get_children():
            self.stations_vbox.remove(child)

        self.station_widgets = []

        if not networks:
            empty_lbl = Gtk.Label()
            empty_lbl.set_markup(f"<span font_size='9000' foreground='{self.pal['text_dim']}'>No wireless carrier stations detected in range.</span>")
            empty_lbl.set_margin_top(20)
            self.stations_vbox.pack_start(empty_lbl, True, True, 0)
            self.stations_vbox.show_all()
            return

        for idx, net in enumerate(networks):
            card = Gtk.EventBox()
            card.get_style_context().add_class("station-card")
            if net["active"]:
                card.get_style_context().add_class("active")

            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            card.add(hbox)

            s_unit, dbm, s_idx = pct_to_smeter(net['signal'])
            sig_lbl = Gtk.Label()
            sig_col = self.pal['green'] if s_idx >= 7 else (self.pal['yellow'] if s_idx >= 4 else self.pal['red'])
            sec_icon = "🔒" if net['security'] else "🔓"
            sig_lbl.set_markup(f"<span font_size='9500' foreground='{sig_col}'>{net['bars']}</span> <span font_size='8000'>{sec_icon}</span>")
            hbox.pack_start(sig_lbl, False, False, 0)

            details = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            hbox.pack_start(details, True, True, 0)

            title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            lbl_ssid = Gtk.Label()
            is_saved = (net['ssid'] in self.saved_connections)
            saved_tag = f" <span font_size='7000' foreground='{self.pal['accent']}'>[KNOWN]</span>" if is_saved else ""
            lbl_ssid.set_markup(f"<span font_weight='bold' font_size='9500' foreground='{self.pal['text_main']}'>{net['ssid']}</span>{saved_tag}")
            lbl_ssid.set_xalign(0.0)
            title_box.pack_start(lbl_ssid, False, False, 0)

            if net['active']:
                lbl_act = Gtk.Label()
                lbl_act.set_markup(f"<span font_weight='bold' font_size='7500' foreground='{self.pal['green']}'>[ ACTIVE LINK ]</span>")
                title_box.pack_start(lbl_act, False, False, 0)

            details.pack_start(title_box, False, False, 0)

            sub_info = Gtk.Label()
            sec_desc = net['security'] if net['security'] else "OPEN / UNENCRYPTED"
            sub_info.set_markup(f"<span font_size='7500' foreground='{self.pal['text_dim']}'>{net['freq']} | CH {net['chan']} | <span foreground='{sig_col}' font_weight='bold'>{s_unit}</span> ({dbm} dBm) [{net['rate']}] | {sec_desc}</span>")
            sub_info.set_xalign(0.0)
            details.pack_start(sub_info, False, False, 0)

            if net['active']:
                btn_action = Gtk.Button()
                btn_action.get_style_context().add_class("disconnect-btn")
                lbl_btn = Gtk.Label()
                lbl_btn.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['red']}'>DISCONNECT</span>")
                btn_action.add(lbl_btn)
                btn_action.connect("clicked", lambda w, ssid=net['ssid']: self.disconnect_wifi(ssid))
                hbox.pack_end(btn_action, False, False, 0)
            else:
                btn_action = Gtk.Button()
                btn_action.get_style_context().add_class("connect-btn")
                lbl_btn = Gtk.Label()
                btn_txt = "CONNECT" if is_saved or not net['security'] else "AUTH &amp; CONNECT"
                lbl_btn.set_markup(f"<span font_weight='bold' font_size='8000' foreground='{self.pal['accent']}'>{btn_txt}</span>")
                btn_action.add(lbl_btn)
                btn_action.connect("clicked", lambda w, n=net: self.initiate_connect(n))
                hbox.pack_end(btn_action, False, False, 0)

            card.connect("button-press-event", lambda w, e, i=idx: self.select_station_index(i))
            self.station_widgets.append(card)
            self.stations_vbox.pack_start(card, False, False, 0)

        self.stations_vbox.show_all()
        self.update_selection_highlight()

    def update_selection_highlight(self):
        for i, card in enumerate(self.station_widgets):
            ctx = card.get_style_context()
            if i == self.selected_station_idx:
                ctx.add_class("selected")
            else:
                ctx.remove_class("selected")

    def select_station_index(self, idx):
        if 0 <= idx < len(self.station_widgets):
            self.selected_station_idx = idx
            self.update_selection_highlight()

    def toggle_radio(self, widget=None):
        new_state = "off" if self.wifi_enabled else "on"
        subprocess.run(["nmcli", "radio", "wifi", new_state])
        self.update_network_status()
        if new_state == "on":
            self.scan_wifi_networks(force_rescan=True)

    def launch_nm_editor(self, widget=None):
        try:
            subprocess.Popen(["nm-connection-editor"], start_new_session=True)
            self.close_window()
        except Exception as e:
            print("Error launching nm-connection-editor:", e, file=sys.stderr)

    def initiate_connect(self, net):
        ssid = net["ssid"]
        is_saved = (ssid in self.saved_connections)
        is_secure = bool(net["security"])

        if is_saved or not is_secure:
            self.connect_wifi_direct(ssid)
        else:
            self.show_auth_prompt(net)

    def show_auth_prompt(self, net):
        self.connecting_ssid = net["ssid"]
        self.lbl_auth_target.set_markup(
            f"<span font_weight='bold' font_size='11000' foreground='{self.pal['accent']}'>TARGET: {net['ssid']}</span>\n"
            f"<span font_size='8000' foreground='{self.pal['text_dim']}'>SECURITY: {net['security']} | BAND: {net['freq']}</span>"
        )
        self.entry_pass.set_text("")
        self.lbl_auth_status.set_markup("")
        self.stack.set_visible_child_name("auth")
        self.entry_pass.grab_focus()

    def cancel_auth(self):
        self.connecting_ssid = None
        self.stack.set_visible_child_name("main")

    def submit_auth(self):
        passphrase = self.entry_pass.get_text().strip()
        if not passphrase:
            self.lbl_auth_status.set_markup(f"<span font_size='8500' foreground='{self.pal['red']}'>ERROR: Passphrase cannot be empty</span>")
            return

        ssid = self.connecting_ssid
        self.lbl_auth_status.set_markup(f"<span font_size='8500' foreground='{self.pal['yellow']}'>ENGAGING CARRIER LINK TO {ssid}...</span>")
        self.btn_auth_connect.set_sensitive(False)

        def _worker():
            res = subprocess.run(["nmcli", "dev", "wifi", "connect", ssid, "password", passphrase], capture_output=True, text=True)
            
            def _done():
                self.btn_auth_connect.set_sensitive(True)
                if res.returncode == 0:
                    self.cancel_auth()
                    self.update_network_status()
                    self.scan_wifi_networks()
                    subprocess.run([
                        "notify-send", "-t", "3500",
                        "TELEMETRY UPLINK ESTABLISHED",
                        f"Connected to carrier station: {ssid}"
                    ])
                else:
                    err_msg = res.stderr.strip() or res.stdout.strip() or "Carrier lock failed"
                    self.lbl_auth_status.set_markup(f"<span font_size='8000' foreground='{self.pal['red']}'>AUTHENTICATION REJECTED: {err_msg}</span>")

            GLib.idle_add(_done)

        threading.Thread(target=_worker, daemon=True).start()

    def connect_wifi_direct(self, ssid):
        self.lbl_scan_status.set_markup(f"<span font_size='8000' foreground='{self.pal['yellow']}'>ENGAGING LINK TO {ssid}...</span>")
        
        def _worker():
            if ssid in self.saved_connections:
                res = subprocess.run(["nmcli", "connection", "up", "id", ssid], capture_output=True, text=True)
            else:
                res = subprocess.run(["nmcli", "dev", "wifi", "connect", ssid], capture_output=True, text=True)

            def _done():
                self.update_network_status()
                self.scan_wifi_networks()
                if res.returncode == 0:
                    subprocess.run([
                        "notify-send", "-t", "3500",
                        "TELEMETRY UPLINK ESTABLISHED",
                        f"Connected to carrier station: {ssid}"
                    ])
                else:
                    err = res.stderr.strip() or res.stdout.strip()
                    subprocess.run([
                        "notify-send", "-t", "4000",
                        "TELEMETRY UPLINK FAILED",
                        f"Failed to connect to {ssid}: {err}"
                    ])

            GLib.idle_add(_done)

        threading.Thread(target=_worker, daemon=True).start()

    def disconnect_wifi(self, ssid):
        def _worker():
            subprocess.run(["nmcli", "connection", "down", "id", ssid])
            GLib.idle_add(lambda: (self.update_network_status(), self.scan_wifi_networks()))
            subprocess.run([
                "notify-send", "-t", "3000",
                "TELEMETRY UPLINK DISENGAGED",
                f"Disconnected from station: {ssid}"
            ])

        threading.Thread(target=_worker, daemon=True).start()

    def on_key_press(self, widget, event):
        keyname = Gdk.keyval_name(event.keyval)
        curr_view = self.stack.get_visible_child_name()

        if curr_view in ["auth", "hidden", "vpn", "bluetooth", "comm_test"]:
            if keyname in ["Escape"]:
                self.stack.set_visible_child_name("main")
                return True
            if curr_view == "bluetooth":
                if keyname in ["p", "P"]:
                    self.toggle_bluetooth_power()
                    return True
                elif keyname in ["s", "S"]:
                    self.scan_bluetooth_devices()
                    return True
            elif curr_view == "comm_test":
                if keyname in ["r", "R"]:
                    self.run_comm_test()
                    return True
                elif keyname in ["p", "P"]:
                    self.ping_all_dns_servers()
                    return True
            return False

        if keyname in ["Escape", "q", "Q"]:
            self.close_window()
            return True
        elif keyname in ["w", "W"]:
            self.toggle_radio()
            return True
        elif keyname in ["h", "H"]:
            self.open_hidden_view()
            return True
        elif keyname in ["v", "V"]:
            self.open_vpn_view()
            return True
        elif keyname in ["b", "B"]:
            self.open_bluetooth_view()
            return True
        elif keyname in ["t", "T", "c", "C"]:
            self.open_comm_test_view()
            return True
        elif keyname in ["r", "R"]:
            self.scan_wifi_networks(force_rescan=True)
            return True
        elif keyname in ["e", "E"]:
            self.launch_nm_editor()
            return True
        elif keyname in ["Down", "j", "J"]:
            if self.stations:
                self.select_station_index((self.selected_station_idx + 1) % len(self.stations))
            return True
        elif keyname in ["Up", "k", "K"]:
            if self.stations:
                self.select_station_index((self.selected_station_idx - 1 + len(self.stations)) % len(self.stations))
            return True
        elif keyname in ["Return", "KP_Enter"]:
            if self.stations and 0 <= self.selected_station_idx < len(self.stations):
                net = self.stations[self.selected_station_idx]
                if net["active"]:
                    self.disconnect_wifi(net["ssid"])
                else:
                    self.initiate_connect(net)
            return True

        return False

    def close_window(self):
        cleanup()
        self.hide()
        Gtk.main_quit()

def main():
    check_singleton()
    win = SpaceNetworkDialog()
    win.connect("destroy", lambda w: (cleanup(), Gtk.main_quit()))
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
